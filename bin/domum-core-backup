#!/usr/bin/env bash
set -euo pipefail

# domum-core-backup — restic wrapper invoked by the CLI and systemd timers.
#
# Backups are driven by BACKUP_TARGET_* entries in config/domum-backup.conf.
# Each enabled target is a restic repository (local path, rest:, sftp:, or any
# restic repository string). ALL targets ship DISABLED by default — nothing
# runs until the user fills in real repos/passwords and sets _ENABLED=1.

DOMUM_DIR="${DOMUM_DIR:-/opt/domum-core}"
CFG_FILE="${CFG_FILE:-$DOMUM_DIR/config/domum.conf}"
BACKUP_CFG_FILE="${BACKUP_CFG_FILE:-$DOMUM_DIR/config/domum-backup.conf}"
SECRETS_DIR="${SECRETS_DIR:-/etc/domum-core/secrets}"
STATE_ROOT="${STATE_ROOT:-/var/lib/domum-core}"
LOG_DIR="${LOG_DIR:-/var/log/domum-core}"
REPO_META_DIR="${REPO_META_DIR:-$STATE_ROOT/backups}"

die() { echo "ERROR: $*" >&2; exit 1; }
log() { echo "[$(date -Iseconds)] $*" | tee -a "${LOG_FILE:-/dev/null}"; }
need_root() { [[ "${EUID}" -eq 0 ]] || die "Run as root (use sudo)."; }
cmd_exists() { command -v "$1" >/dev/null 2>&1; }

uppercase_token() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_' | tr -c 'A-Z0-9_' '_'
}

load_cfg() {
  [[ -f "$CFG_FILE" ]] || die "Missing config: $CFG_FILE"
  # shellcheck disable=SC1090
  source "$CFG_FILE"
  if [[ -f "$BACKUP_CFG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$BACKUP_CFG_FILE"
  fi
  STATE_ROOT="${STATE_ROOT:-/var/lib/domum-core}"
  LOG_DIR="${LOG_DIR:-/var/log/domum-core}"
  RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-$STATE_ROOT/cache/restic}"
  RESTIC_KEEP_DAILY="${RESTIC_KEEP_DAILY:-7}"
  RESTIC_KEEP_WEEKLY="${RESTIC_KEEP_WEEKLY:-5}"
  RESTIC_KEEP_MONTHLY="${RESTIC_KEEP_MONTHLY:-12}"
  RESTIC_KEEP_YEARLY="${RESTIC_KEEP_YEARLY:-3}"
  BACKUP_TARGETS="${BACKUP_TARGETS:-local hetzner buffalo}"
  # Default source set. Each byte is stored ONCE, in restic's dedup-friendly
  # raw form where that is reliable enough. Selected app-consistent service
  # archives also ride along when they are materially safer than hot raw files:
  # MariaDB SQL dumps, quiesced Actual/Vaultwarden SQLite tars, and named-volume
  # exports. Do not add the whole service-backups tree; compressed rotations are
  # opaque to restic dedup and grow offsite storage quickly.
  # (BACKUP-MANIFEST.json is the per-run manifest written by `backups run` —
  # it documents each snapshot from inside the snapshot itself.)
  BACKUP_PATHS="${BACKUP_PATHS:-\
$DOMUM_DIR/compose \
$DOMUM_DIR/config \
$STATE_ROOT/service-backups/actual \
$STATE_ROOT/service-backups/mariadb \
$STATE_ROOT/service-backups/vaultwarden \
$STATE_ROOT/service-backups/volumes \
$STATE_ROOT/service-backups/BACKUP-MANIFEST.json \
$STATE_ROOT/recovery-pack}"
  # Named volumes exported (tar) into staging so they ride along in restic.
  BACKUP_VOLUMES="${BACKUP_VOLUMES:-nodered-data uptime-kuma-data traefik-letsencrypt}"
  # Excludes: large disposable / regenerable data. mariadb/data is raw hot
  # InnoDB copied while mariadbd runs — not a reliable restore source; the
  # mariadb-dump SQL artifact above is the authoritative MariaDB backup.
  BACKUP_EXCLUDES="${BACKUP_EXCLUDES:-\
$DOMUM_DIR/compose/automation/mariadb/data \
*/tts/* \
*.db-wal \
*.db-shm}"
}

ensure_dirs() {
  install -d -m 0750 "$LOG_DIR"
  install -d -m 0750 "$REPO_META_DIR"
  install -d -m 0750 "$RESTIC_CACHE_DIR"
  install -d -m 0750 "$STATE_ROOT/service-backups/volumes"
  LOG_FILE="$LOG_DIR/backup.log"
  HEARTBEAT_FILE="$STATE_ROOT/backups/last-success"
  install -d -m 0750 "$STATE_ROOT/backups"
  touch "$LOG_FILE"
}

require_files() {
  local missing=() f
  for f in "$@"; do
    [[ -f "$f" ]] || missing+=("$f")
  done
  (( ${#missing[@]} == 0 )) || die "Missing required files: ${missing[*]}"
}

# warn (not fail) if a secret file is group/world-readable or not root-owned.
check_secret_perms() {
  local f="$1" mode owner
  [[ -f "$f" ]] || return 0
  mode="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null || echo '?')"
  owner="$(stat -c %U "$f" 2>/dev/null || stat -f %Su "$f" 2>/dev/null || echo '?')"
  [[ "$mode" == "600" || "$mode" == "400" ]] || log "WARNING: $f mode is $mode (expected 600)."
  [[ "$owner" == "root" ]] || log "WARNING: $f owner is $owner (expected root)."
}

backup_target_names() {
  local name
  for name in ${BACKUP_TARGETS:-}; do
    [[ -n "$name" ]] && echo "$name"
  done
}

backup_target_value() {
  local target="$1" field="$2" fallback="${3:-}" key
  key="BACKUP_TARGET_$(uppercase_token "$target")_${field}"
  if [[ -n "${!key:-}" ]]; then printf '%s' "${!key}"; else printf '%s' "$fallback"; fi
}

backup_target_enabled() {
  [[ "$(backup_target_value "$1" ENABLED 0)" == "1" ]]
}

backup_target_password_file() {
  backup_target_value "$1" PASSWORD_FILE "$SECRETS_DIR/restic_password_$1"
}

enabled_backup_targets() {
  local target
  while IFS= read -r target; do
    backup_target_enabled "$target" || continue
    echo "$target"
  done < <(backup_target_names)
}

backup_target_include_paths() {
  local target="$1" paths
  paths="$(backup_target_value "$target" INCLUDE_PATHS)"
  printf '%s' "${paths:-$BACKUP_PATHS}"
}

shell_join_quoted() {
  local joined=""
  printf -v joined '%q ' "$@"
  printf '%s' "${joined% }"
}

sftp_repo_user_host() {
  local repo="$1" spec
  [[ "$repo" == sftp:* ]] || return 1
  spec="${repo#sftp:}"; spec="${spec%%:*}"
  [[ "$spec" == *@* ]] || return 1
  printf '%s\n%s\n' "${spec%%@*}" "${spec#*@}"
}

sftp_command_option_for_target() {
  local target="$1" sftp_key sftp_known_hosts sftp_port repo
  local -a ssh_cmd=() sftp_parts=()
  sftp_key="$(backup_target_value "$target" SFTP_KEY_FILE)"
  sftp_known_hosts="$(backup_target_value "$target" SFTP_KNOWN_HOSTS_FILE)"
  sftp_port="$(backup_target_value "$target" SFTP_PORT)"
  [[ -n "$sftp_key" ]] || die "SFTP target '$target' missing BACKUP_TARGET_$(uppercase_token "$target")_SFTP_KEY_FILE."
  require_files "$sftp_key"
  repo="$(backup_target_value "$target" REPOSITORY)"
  mapfile -t sftp_parts < <(sftp_repo_user_host "$repo") \
    || die "SFTP target '$target' has an unparseable repository: $repo"
  [[ -n "${sftp_parts[0]:-}" && -n "${sftp_parts[1]:-}" ]] \
    || die "SFTP target '$target' has an unparseable repository: $repo"
  ssh_cmd=(ssh -F /dev/null -i "$sftp_key")
  ssh_cmd+=(-o IdentitiesOnly=yes -o PreferredAuthentications=publickey)
  ssh_cmd+=(-o PasswordAuthentication=no -o StrictHostKeyChecking=yes)
  [[ -n "$sftp_known_hosts" ]] && { require_files "$sftp_known_hosts"; ssh_cmd+=(-o UserKnownHostsFile="$sftp_known_hosts"); }
  [[ -n "$sftp_port" ]] && ssh_cmd+=(-p "$sftp_port")
  ssh_cmd+=("${sftp_parts[0]}@${sftp_parts[1]}" -s sftp)
  printf 'sftp.command=%s' "$(shell_join_quoted "${ssh_cmd[@]}")"
}

restic_for_target() {
  local target="$1"; shift
  local pw_file repository env_file sftp_command_opt
  pw_file="$(backup_target_password_file "$target")"
  repository="$(backup_target_value "$target" REPOSITORY)"
  env_file="$(backup_target_value "$target" ENV_FILE)"
  [[ -n "$repository" ]] || die "No BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY configured."
  require_files "$pw_file"
  check_secret_perms "$pw_file"
  cmd_exists restic || die "restic is not installed (apt-get install -y restic)."

  (
    if [[ -n "$env_file" && -f "$env_file" ]]; then
      set +u
      # shellcheck disable=SC1090
      source "$env_file"
      set -u
    fi
    local -a restic_cmd=(restic --cache-dir "$RESTIC_CACHE_DIR")
    if [[ "$repository" == sftp:* ]]; then
      sftp_command_opt="$(sftp_command_option_for_target "$target")"
      restic_cmd+=(-o "$sftp_command_opt")
    fi
    restic_cmd+=("$@")
    RESTIC_PASSWORD_FILE="$pw_file" RESTIC_REPOSITORY="$repository" "${restic_cmd[@]}"
  )
}

# ---- named-volume exports --------------------------------------------------

export_named_volumes() {
  local dry="${1:-0}"
  local vol_stage="$STATE_ROOT/service-backups/volumes" vol
  for vol in ${BACKUP_VOLUMES:-}; do
    [[ -n "$vol" ]] || continue
    docker volume inspect "$vol" >/dev/null 2>&1 || { log "volume $vol not present — skipping"; continue; }
    local out="$vol_stage/${vol}.tar.gz"
    if (( dry == 1 )); then
      log "[dry-run] would export volume $vol -> $out"
      continue
    fi
    log "exporting named volume $vol -> $out"
    docker run --rm -v "$vol":/from:ro -v "$vol_stage":/to alpine \
      sh -c "cd /from && tar -czf /to/${vol}.tar.gz ." \
      || log "WARNING: failed to export volume $vol"
  done
}

# ---- repo metadata ---------------------------------------------------------

repo_meta_file() { printf '%s/%s-repo.env' "$REPO_META_DIR" "$1"; }

get_repo_id() {
  restic_for_target "$1" cat config 2>/dev/null \
    | grep -oE '"id"[[:space:]]*:[[:space:]]*"[0-9a-f]+"' \
    | grep -oE '[0-9a-f]{8,}' | head -1
}

# ---- backup paths ----------------------------------------------------------

restic_backup_to() {
  local target="$1" dry="${2:-0}"
  local -a paths=() excludes=()
  local p
  for p in $(backup_target_include_paths "$target"); do
    [[ -e "$p" ]] || continue
    paths+=("$p")
  done
  (( ${#paths[@]} > 0 )) || { log "No existing backup paths for $target — skipping"; return 0; }
  for p in ${BACKUP_EXCLUDES:-}; do
    excludes+=(--exclude "$p")
  done

  log "restic backup -> $target (${#paths[@]} paths)"
  local -a opts=(backup --tag "$(date +%Y-%m-%d)" "${excludes[@]}")
  (( dry == 1 )) && opts+=(--dry-run)
  restic_for_target "$target" "${opts[@]}" "${paths[@]}"
}

collect_backup_paths_for_target() {
  local target="$1" p
  paths=()
  excludes=()
  for p in $(backup_target_include_paths "$target"); do
    [[ -e "$p" ]] || continue
    paths+=("$p")
  done
  for p in ${BACKUP_EXCLUDES:-}; do
    excludes+=(--exclude "$p")
  done
}

restic_forget_for() {
  local target="$1" dry="${2:-0}"
  local -a opts=(forget --prune
    --keep-daily   "$RESTIC_KEEP_DAILY"
    --keep-weekly  "$RESTIC_KEEP_WEEKLY"
    --keep-monthly "$RESTIC_KEEP_MONTHLY"
    --keep-yearly  "$RESTIC_KEEP_YEARLY")
  (( dry == 1 )) && opts+=(--dry-run)
  log "restic forget on $target"
  restic_for_target "$target" "${opts[@]}"
}

# heartbeat <all_ok> <succeeded targets...>
# Aggregate file (back-compat, drives checkup's critical gate) + one file per
# succeeded target so checkup can say WHICH destination is stale. The external
# heartbeat URL is pinged only when every target succeeded — a partial run
# must not look green to outside monitoring.
heartbeat() {
  local all_ok="$1"; shift
  local t
  date -Iseconds > "$HEARTBEAT_FILE"
  for t in "$@"; do
    date -Iseconds > "$STATE_ROOT/backups/last-success-$t"
  done
  if [[ "$all_ok" == "1" && -n "${BACKUP_HEARTBEAT_URL:-}" ]]; then
    curl -fsS --max-time 10 -o /dev/null "$BACKUP_HEARTBEAT_URL" || true
  fi
}

no_targets_notice() {
  cat <<EOF
[domum-core-backup] No backup targets are enabled.

Nothing was backed up. To configure restic backups:
  1. Edit $BACKUP_CFG_FILE
  2. Set a real BACKUP_TARGET_<NAME>_REPOSITORY + create its password file
  3. Set BACKUP_TARGET_<NAME>_ENABLED=1
  4. sudo domum-core backups init <name>
See docs/backups/overview.md.
EOF
}

# Collect enabled targets into an array. Never test the list with
# `enabled_backup_targets | grep -q .`: grep -q exits on the first match and
# under pipefail the producer's SIGPIPE can fail the pipeline, making a
# fully-configured host print the "no targets" notice and skip the run.
collect_enabled_targets() {
  # populates the caller's `targets` array (caller declares: local -a targets)
  local t
  targets=()
  while IFS= read -r t; do targets+=("$t"); done < <(enabled_backup_targets)
}

do_daily_backup() {
  local dry="${1:-0}" target
  local -a targets=() failed=() succeeded=()
  log "=== backup run start (dry=$dry) ==="
  export_named_volumes "$dry"

  collect_enabled_targets
  if (( ${#targets[@]} == 0 )); then
    no_targets_notice
    return 0
  fi

  # Per-target isolation: one unreachable target (NAS unmounted, Hetzner
  # down) must never cancel the remaining targets' backup or retention.
  for target in "${targets[@]}"; do
    if restic_backup_to "$target" "$dry"; then
      succeeded+=("$target")
    else
      failed+=("$target")
      log "WARNING: backup to $target failed — continuing with remaining targets."
    fi
  done

  if (( dry == 0 )); then
    for target in ${succeeded[@]+"${succeeded[@]}"}; do
      [[ "$(backup_target_value "$target" RETENTION daily)" == "none" ]] && continue
      restic_forget_for "$target" 0 \
        || log "WARNING: retention (forget --prune) failed on $target."
    done
    if (( ${#succeeded[@]} > 0 )); then
      local all_ok=1; (( ${#failed[@]} > 0 )) && all_ok=0
      heartbeat "$all_ok" "${succeeded[@]}"
    fi
  fi

  if (( ${#failed[@]} > 0 )); then
    log "=== backup run FAILED for: ${failed[*]} (succeeded: ${succeeded[*]:-none}) ==="
    return 1
  fi
  log "=== backup run ok ==="
}

do_check() {
  local target rc=0
  local -a targets=()
  collect_enabled_targets
  if (( ${#targets[@]} == 0 )); then no_targets_notice; return 0; fi
  for target in "${targets[@]}"; do
    log "restic check on $target"
    restic_for_target "$target" check \
      || { rc=1; log "WARNING: restic check failed on $target — continuing."; }
  done
  return "$rc"
}

do_prune() {
  local dry="${1:-0}" target rc=0
  local -a targets=()
  collect_enabled_targets
  if (( ${#targets[@]} == 0 )); then no_targets_notice; return 0; fi
  for target in "${targets[@]}"; do
    restic_forget_for "$target" "$dry" \
      || { rc=1; log "WARNING: retention failed on $target — continuing."; }
  done
  return "$rc"
}

list_snapshots() {
  local target any=0 out rc
  while IFS= read -r target; do
    any=1
    echo "-- $target --"
    rc=0
    out="$(restic_for_target "$target" snapshots --latest 5 2>&1)" || rc=$?
    if (( rc == 0 )); then
      printf '%s\n' "$out"
    elif printf '%s' "$out" | grep -qiE 'does not exist|unable to open|no such'; then
      echo "($target: repository not initialized — run: sudo domum-core backups init $target)"
    else
      echo "(failed to query snapshots for $target)"; printf '%s\n' "$out"
    fi
  done < <(enabled_backup_targets)
  (( any == 1 )) || no_targets_notice
}

do_init_repo() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: domum-core-backup init <target>"
  local repository repo_id meta_file
  repository="$(backup_target_value "$target" REPOSITORY)"
  [[ -n "$repository" ]] || die "No BACKUP_TARGET_$(uppercase_token "$target")_REPOSITORY configured."
  meta_file="$(repo_meta_file "$target")"

  log "Initializing $target repository: $repository"
  if restic_for_target "$target" snapshots >/dev/null 2>&1; then
    log "Repository already initialized."
  else
    restic_for_target "$target" init || die "restic init failed."
  fi
  repo_id="$(get_repo_id "$target")"
  cat > "$meta_file" <<EOF
TARGET="$target"
REPOSITORY="$repository"
REPOSITORY_ID="$repo_id"
INIT_TS="$(date -Iseconds)"
EOF
  chmod 600 "$meta_file"
  log "Repository ready (id ${repo_id:0:12}). Metadata: $meta_file"
}

do_usb_backup() {
  local mount_point="${1:-}" repo pw_file rc=0
  [[ -n "$mount_point" ]] || die "Usage: domum-core-backup usb <mount-point>"
  [[ -d "$mount_point" ]] || die "USB mount point is not a directory: $mount_point"
  [[ "$mount_point" != "/" ]] || die "Refusing to use / as a USB backup mount point."
  if cmd_exists findmnt; then
    findmnt -rn --mountpoint "$mount_point" >/dev/null \
      || die "$mount_point is not a mounted filesystem. Mount the USB disk first."
  elif cmd_exists mountpoint; then
    mountpoint -q "$mount_point" \
      || die "$mount_point is not a mounted filesystem. Mount the USB disk first."
  else
    die "Need findmnt or mountpoint to verify the USB mount."
  fi

  repo="$mount_point/domum-core-restic"
  pw_file="$(backup_target_password_file local)"
  [[ -f "$pw_file" ]] || die "Missing LOCAL restic password file for USB backup: $pw_file"
  check_secret_perms "$pw_file"
  cmd_exists restic || die "restic is not installed (apt-get install -y restic)."

  local -a paths=() excludes=()
  collect_backup_paths_for_target local
  (( ${#paths[@]} > 0 )) || die "No existing backup paths for USB backup."

  log "USB backup repository: $repo"
  (
    if ! RESTIC_PASSWORD_FILE="$pw_file" RESTIC_REPOSITORY="$repo" restic --cache-dir "$RESTIC_CACHE_DIR" snapshots >/dev/null 2>&1; then
      log "Initializing USB restic repository."
      RESTIC_PASSWORD_FILE="$pw_file" RESTIC_REPOSITORY="$repo" restic --cache-dir "$RESTIC_CACHE_DIR" init || exit 1
    fi
    RESTIC_PASSWORD_FILE="$pw_file" RESTIC_REPOSITORY="$repo" restic --cache-dir "$RESTIC_CACHE_DIR" backup --tag "usb-$(date +%Y-%m-%d)" "${excludes[@]}" "${paths[@]}" || exit 1
    RESTIC_PASSWORD_FILE="$pw_file" RESTIC_REPOSITORY="$repo" restic --cache-dir "$RESTIC_CACHE_DIR" snapshots --latest 5 || exit 1
  ) || rc=1

  if (( rc == 0 )); then
    date -Iseconds > "$STATE_ROOT/backups/last-usb-success"
    log "USB backup complete. Unmount when done: sudo umount $mount_point"
  fi
  return "$rc"
}

# NOTE: restic reproduces the ORIGINAL ABSOLUTE PATHS under <target-dir>
# (restoring to /opt/domum-core yields /opt/domum-core/opt/domum-core/...).
# Restore to a staging dir (disk-backed /var/tmp or the wizard's staging),
# then move into place — `domum-core restore` does this for you.
do_restore() {
  local snap="" target_dir="" repo="" verify=0 arg
  local -a pos=()
  for arg in "$@"; do
    if [[ "$arg" == "--verify" ]]; then verify=1; else pos+=("$arg"); fi
  done
  snap="${pos[0]:-}"; target_dir="${pos[1]:-}"; repo="${pos[2]:-}"
  [[ -n "$snap" && -n "$target_dir" ]] || die "Usage: domum-core-backup --restore <snapshot> <target-dir> [repo-name] [--verify]"
  if [[ -z "$repo" ]]; then
    repo="$(enabled_backup_targets | head -n1)"
    [[ -n "$repo" ]] || die "No enabled backup targets."
  fi
  mkdir -p "$target_dir"
  log "restic restore $snap -> $target_dir (from $repo; original absolute paths are recreated UNDER the target dir)"
  local -a opts=(restore "$snap" --target "$target_dir")
  (( verify == 1 )) && opts+=(--verify)
  restic_for_target "$repo" "${opts[@]}"
}

main() {
  case "${1:-}" in
    -h|--help)
      cat <<EOF
domum-core-backup — restic wrapper

Usage:
  domum-core-backup                  Run backup for all enabled targets
  domum-core-backup --dry-run        Plan + restic backup --dry-run
  domum-core-backup --check          restic check on all enabled targets
  domum-core-backup --prune          restic forget --prune (retention)
  domum-core-backup --prune-dry-run  Preview retention
  domum-core-backup --snapshots      List latest snapshots per target
  domum-core-backup --restore <snap> <dir> [repo] [--verify]
                                      (absolute paths are recreated UNDER <dir>)
  domum-core-backup init <target>    Initialize a restic repository
  domum-core-backup usb <mount>      Run on-demand backup to <mount>/domum-core-restic
EOF
      return 0
      ;;
  esac

  need_root
  load_cfg
  ensure_dirs

  case "${1:-}" in
    "")                do_daily_backup 0 ;;
    --dry-run)         do_daily_backup 1 ;;
    --check)           do_check ;;
    --prune)           do_prune 0 ;;
    --prune-dry-run)   do_prune 1 ;;
    --snapshots)       list_snapshots ;;
    --restore)         shift; do_restore "$@" ;;
    init)              shift; do_init_repo "$@" ;;
    usb)               shift; do_usb_backup "$@" ;;
    *) die "Unknown command: $1 (try --help)" ;;
  esac
}

main "$@"
