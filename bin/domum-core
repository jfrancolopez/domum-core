#!/usr/bin/env bash
set -euo pipefail

# domum-core — consolidated host CLI for the domum-core home-automation server.
#
# Supersedes the original bin/domum. Folds the deployment commands
# (init/apply/update/status/schedule) together with a production operating
# model ported from domum-core-media: comprehensive checkup/doctor, restic
# multi-target backups, per-service backups (Actual Budget, Home Assistant,
# MariaDB), AGE-encrypted recovery packs, a cautious update model, and
# systemd maintenance timers.
#
# Guiding rules: audit before change; backup before update; dry-run before
# destructive action; never stop HA/MQTT/Zigbee2MQTT/Node-RED/Traefik/Actual/
# AdGuard unless the command is explicit and config-gated; never delete
# existing files; never rotate secrets automatically.
# Full design philosophy: docs/reference/architecture-principles.md

DOMUM_DIR="${DOMUM_DIR:-/opt/domum-core}"
CFG_FILE="${CFG_FILE:-$DOMUM_DIR/config/domum.conf}"
BACKUP_CFG_FILE="${BACKUP_CFG_FILE:-$DOMUM_DIR/config/domum-backup.conf}"
SECRETS_DIR="${SECRETS_DIR:-/etc/domum-core/secrets}"
STATE_ROOT="${STATE_ROOT:-/var/lib/domum-core}"
LOG_DIR="${LOG_DIR:-/var/log/domum-core}"

# ---- output helpers --------------------------------------------------------

log()  { echo "[$(date +%H:%M:%S)] [domum-core] $*"; }
warn() { echo "[$(date +%H:%M:%S)] [domum-core] WARN: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

DRY_RUN=0

# run() executes a command, or echoes it when DRY_RUN=1.
run() {
  if (( DRY_RUN == 1 )); then
    echo "[dry-run] $*"
    return 0
  fi
  "$@"
}

need_root() {
  [[ "${EUID}" -eq 0 ]] || die "Run as root (use sudo)."
}

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

uppercase_token() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_' | tr -c 'A-Z0-9_' '_'
}

adguard_detect_web_port() {
  local cfg="$DOMUM_DIR/compose/networking/adguard/conf/AdGuardHome.yaml" port
  if [[ -f "$cfg" ]]; then
    port="$(awk '
      /^[[:space:]]*address:[[:space:]]*/ {
        value=$0
        sub(/^[[:space:]]*address:[[:space:]]*/, "", value)
        gsub(/[ "]/, "", value)
        n=split(value, parts, ":")
        if (parts[n] ~ /^[0-9]+$/) {
          print parts[n]
          exit
        }
      }
    ' "$cfg")"
    if [[ "$port" =~ ^[0-9]+$ ]]; then
      printf '%s\n' "$port"
      return 0
    fi
  fi
  printf '3000\n'
}

# ---- config ----------------------------------------------------------------

load_cfg() {
  [[ -f "$CFG_FILE" ]] || die "Missing config: $CFG_FILE"
  # shellcheck disable=SC1090
  source "$CFG_FILE"
  # Optional backup/recovery overlay keeps the main domum.conf clean.
  if [[ -f "$BACKUP_CFG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$BACKUP_CFG_FILE"
  fi

  # Production defaults (safe; everything off by default).
  STATE_ROOT="${STATE_ROOT:-/var/lib/domum-core}"
  LOG_DIR="${LOG_DIR:-/var/log/domum-core}"

  BACKUP_MAX_AGE_HOURS="${BACKUP_MAX_AGE_HOURS:-48}"
  # Default ON: a sub-second docker pause at backup time beats a torn
  # mid-write SQLite copy. Set 0 in the overlay to opt out.
  ACTUAL_QUIESCE="${ACTUAL_QUIESCE:-1}"
  ACTUAL_KEEP="${ACTUAL_KEEP:-7}"
  HA_KEEP="${HA_KEEP:-7}"
  MARIADB_KEEP="${MARIADB_KEEP:-7}"
  SERVICE_BACKUP_KEEP="${SERVICE_BACKUP_KEEP:-7}"

  # Per-service backup flags consumed by `backups run`. Default ON so an
  # enabled service is protected even before the overlay file is edited.
  BACKUP_HOMEASSISTANT="${BACKUP_HOMEASSISTANT:-1}"
  BACKUP_MARIADB="${BACKUP_MARIADB:-1}"
  BACKUP_ACTUAL="${BACKUP_ACTUAL:-1}"
  BACKUP_VAULTWARDEN="${BACKUP_VAULTWARDEN:-1}"
  BACKUP_OBSIDIAN="${BACKUP_OBSIDIAN:-1}"
  BACKUP_ZIGBEE2MQTT="${BACKUP_ZIGBEE2MQTT:-1}"
  BACKUP_ZWAVE="${BACKUP_ZWAVE:-1}"
  BACKUP_NODERED="${BACKUP_NODERED:-1}"
  BACKUP_MQTT="${BACKUP_MQTT:-1}"
  BACKUP_ESPHOME="${BACKUP_ESPHOME:-1}"
  BACKUP_MUSICASSISTANT="${BACKUP_MUSICASSISTANT:-1}"
  BACKUP_ADGUARD="${BACKUP_ADGUARD:-1}"

  # Tailscale is optional remote transport for this host. Keep host DNS under
  # local control so LAN HTTPS and ACME renewal do not depend on Tailscale.
  TAILSCALE_ACCEPT_DNS="${TAILSCALE_ACCEPT_DNS:-0}"
  TAILSCALE_SSH="${TAILSCALE_SSH:-0}"
  ADGUARD_WEB_PORT="${ADGUARD_WEB_PORT:-$(adguard_detect_web_port)}"
  MQTT_USER="${MQTT_USER:-domum}"
  MQTT_PASSWORD_FILE="${MQTT_PASSWORD_FILE:-$SECRETS_DIR/mqtt_password}"
  MOSQUITTO_PASSWD_FILE="${MOSQUITTO_PASSWD_FILE:-$SECRETS_DIR/mosquitto_passwd}"
  MOSQUITTO_RUNTIME_PASSWD_FILE="${MOSQUITTO_RUNTIME_PASSWD_FILE:-$DOMUM_DIR/compose/automation/mqtt/config/passwd}"

  RECOVERY_PACK_ENABLED="${RECOVERY_PACK_ENABLED:-1}"
  RECOVERY_PACK_AGE_PUBKEY_FILE="${RECOVERY_PACK_AGE_PUBKEY_FILE:-$SECRETS_DIR/recovery-age.pub}"
  RECOVERY_PACK_DEST="${RECOVERY_PACK_DEST:-$STATE_ROOT/recovery-pack}"
  RECOVERY_PACK_REMINDER_DAYS="${RECOVERY_PACK_REMINDER_DAYS:-30}"
  # Recovery email. The spec's friendly names (ENABLE_RECOVERY_EMAIL /
  # RECOVERY_EMAIL_* / GMAIL_APP_PASSWORD_FILE) are accepted as aliases over the
  # underlying RECOVERY_PACK_SMTP_* settings. Gmail is the default provider.
  RECOVERY_EMAIL_PROVIDER="${RECOVERY_EMAIL_PROVIDER:-gmail}"
  RECOVERY_PACK_EMAIL_ENABLED="${RECOVERY_PACK_EMAIL_ENABLED:-${ENABLE_RECOVERY_EMAIL:-0}}"
  RECOVERY_PACK_EMAIL_TO="${RECOVERY_PACK_EMAIL_TO:-${RECOVERY_EMAIL_TO:-${DOMUM_EMAIL:-}}}"
  RECOVERY_PACK_EMAIL_FROM="${RECOVERY_PACK_EMAIL_FROM:-${RECOVERY_EMAIL_FROM:-${DOMUM_EMAIL:-}}}"
  # Gmail SMTP submission defaults (smtps/465). Override for other providers.
  if [[ "$RECOVERY_EMAIL_PROVIDER" == "gmail" ]]; then
    RECOVERY_PACK_SMTP_HOST="${RECOVERY_PACK_SMTP_HOST:-smtp.gmail.com}"
  fi
  RECOVERY_PACK_SMTP_HOST="${RECOVERY_PACK_SMTP_HOST:-}"
  RECOVERY_PACK_SMTP_PORT="${RECOVERY_PACK_SMTP_PORT:-465}"
  RECOVERY_PACK_SMTP_USERNAME_FILE="${RECOVERY_PACK_SMTP_USERNAME_FILE:-$SECRETS_DIR/recovery_pack_smtp_username}"
  # Gmail app password file is the password file when provider=gmail.
  RECOVERY_PACK_SMTP_PASSWORD_FILE="${RECOVERY_PACK_SMTP_PASSWORD_FILE:-${GMAIL_APP_PASSWORD_FILE:-$SECRETS_DIR/recovery_pack_smtp_password}}"

  # Per-app container update policy. Category labels in the service catalog are
  # informational only; they do not control update behavior.
  TRAEFIK_AUTO_UPDATE="${TRAEFIK_AUTO_UPDATE:-1}"
  TRAEFIK_UPDATE_DELAY_DAYS="${TRAEFIK_UPDATE_DELAY_DAYS:-1}"
  ADGUARD_AUTO_UPDATE="${ADGUARD_AUTO_UPDATE:-1}"
  ADGUARD_UPDATE_DELAY_DAYS="${ADGUARD_UPDATE_DELAY_DAYS:-3}"
  HOMEASSISTANT_AUTO_UPDATE="${HOMEASSISTANT_AUTO_UPDATE:-0}"
  HOMEASSISTANT_UPDATE_DELAY_DAYS="${HOMEASSISTANT_UPDATE_DELAY_DAYS:-14}"
  MARIADB_AUTO_UPDATE="${MARIADB_AUTO_UPDATE:-0}"
  MARIADB_UPDATE_DELAY_DAYS="${MARIADB_UPDATE_DELAY_DAYS:-14}"
  MQTT_AUTO_UPDATE="${MQTT_AUTO_UPDATE:-0}"
  MQTT_UPDATE_DELAY_DAYS="${MQTT_UPDATE_DELAY_DAYS:-7}"
  ZIGBEE2MQTT_AUTO_UPDATE="${ZIGBEE2MQTT_AUTO_UPDATE:-0}"
  ZIGBEE2MQTT_UPDATE_DELAY_DAYS="${ZIGBEE2MQTT_UPDATE_DELAY_DAYS:-7}"
  ZWAVE_AUTO_UPDATE="${ZWAVE_AUTO_UPDATE:-0}"
  ZWAVE_UPDATE_DELAY_DAYS="${ZWAVE_UPDATE_DELAY_DAYS:-7}"
  NODERED_AUTO_UPDATE="${NODERED_AUTO_UPDATE:-0}"
  NODERED_UPDATE_DELAY_DAYS="${NODERED_UPDATE_DELAY_DAYS:-7}"
  ESPHOME_AUTO_UPDATE="${ESPHOME_AUTO_UPDATE:-0}"
  ESPHOME_UPDATE_DELAY_DAYS="${ESPHOME_UPDATE_DELAY_DAYS:-7}"
  MUSICASSISTANT_AUTO_UPDATE="${MUSICASSISTANT_AUTO_UPDATE:-0}"
  MUSICASSISTANT_UPDATE_DELAY_DAYS="${MUSICASSISTANT_UPDATE_DELAY_DAYS:-7}"
  ACTUAL_BUDGET_AUTO_UPDATE="${ACTUAL_BUDGET_AUTO_UPDATE:-0}"
  ACTUAL_BUDGET_UPDATE_DELAY_DAYS="${ACTUAL_BUDGET_UPDATE_DELAY_DAYS:-7}"
  VAULTWARDEN_AUTO_UPDATE="${VAULTWARDEN_AUTO_UPDATE:-0}"
  VAULTWARDEN_UPDATE_DELAY_DAYS="${VAULTWARDEN_UPDATE_DELAY_DAYS:-14}"
  OBSIDIAN_SYNC_AUTO_UPDATE="${OBSIDIAN_SYNC_AUTO_UPDATE:-0}"
  OBSIDIAN_SYNC_UPDATE_DELAY_DAYS="${OBSIDIAN_SYNC_UPDATE_DELAY_DAYS:-7}"
  UPDATE_ROT_AUTO_DAYS="${UPDATE_ROT_AUTO_DAYS:-60}"
  UPDATE_ROT_MANUAL_DAYS="${UPDATE_ROT_MANUAL_DAYS:-270}"

  HEALTHCHECK_HOMEASSISTANT_HTTP="${HEALTHCHECK_HOMEASSISTANT_HTTP:-0}"
  HOMEASSISTANT_HEALTH_URL="${HOMEASSISTANT_HEALTH_URL:-}"
  HEALTHCHECK_ACTUAL_HTTP="${HEALTHCHECK_ACTUAL_HTTP:-0}"
  ACTUAL_HEALTH_URL="${ACTUAL_HEALTH_URL:-}"

  ENABLE_SECURITY_PATCHES="${ENABLE_SECURITY_PATCHES:-1}"
  ENABLE_AUTOREMOVE_OLD_KERNELS="${ENABLE_AUTOREMOVE_OLD_KERNELS:-0}"
  SECURITY_PATCH_REBOOT_POLICY="${SECURITY_PATCH_REBOOT_POLICY:-manual}"
}

validate_obsidian_credentials() {
  local issues=0
  [[ "${ENABLE_OBSIDIAN_SYNC:-0}" == "1" ]] || return 0

  if [[ -z "${OBSIDIAN_COUCHDB_USER:-}" ]]; then
    echo "[!] ENABLE_OBSIDIAN_SYNC=1 but OBSIDIAN_COUCHDB_USER is empty"
    issues=1
  fi
  if [[ -z "${OBSIDIAN_COUCHDB_PASSWORD:-}" || "${OBSIDIAN_COUCHDB_PASSWORD:-}" == "changeme" ]]; then
    echo "[!] ENABLE_OBSIDIAN_SYNC=1 requires a non-default OBSIDIAN_COUCHDB_PASSWORD"
    issues=1
  fi

  return "$issues"
}

validate_mqtt_auth() {
  local issues=0
  local z2m_config="$DOMUM_DIR/compose/automation/zigbee2mqtt/configuration.yaml"
  local z2m_secret="$DOMUM_DIR/compose/automation/zigbee2mqtt/secret.yaml"
  local expected_owner=""
  [[ "${ENABLE_MQTT:-0}" == "1" ]] || return 0

  if [[ -z "${MOSQUITTO_PASSWD_FILE:-}" ]]; then
    echo "[!] ENABLE_MQTT=1 but MOSQUITTO_PASSWD_FILE is empty"
    issues=1
  elif [[ -z "${MQTT_PASSWORD_FILE:-}" ]]; then
    echo "[!] ENABLE_MQTT=1 but MQTT_PASSWORD_FILE is empty"
    issues=1
  elif [[ ! -f "$MQTT_PASSWORD_FILE" ]]; then
    echo "[!] ENABLE_MQTT=1 but MQTT password file is missing: $MQTT_PASSWORD_FILE"
    issues=1
  elif [[ ! -s "$MQTT_PASSWORD_FILE" ]]; then
    echo "[!] MQTT password file is empty: $MQTT_PASSWORD_FILE"
    issues=1
  elif [[ ! -f "$MOSQUITTO_PASSWD_FILE" ]]; then
    echo "[!] ENABLE_MQTT=1 but Mosquitto password file is missing: $MOSQUITTO_PASSWD_FILE"
    issues=1
  elif [[ ! -s "$MOSQUITTO_PASSWD_FILE" ]]; then
    echo "[!] Mosquitto password file is empty: $MOSQUITTO_PASSWD_FILE"
    issues=1
  elif [[ ! -f "$MOSQUITTO_RUNTIME_PASSWD_FILE" ]]; then
    echo "[!] Mosquitto runtime password file is missing: $MOSQUITTO_RUNTIME_PASSWD_FILE"
    issues=1
  elif [[ ! -s "$MOSQUITTO_RUNTIME_PASSWD_FILE" ]]; then
    echo "[!] Mosquitto runtime password file is empty: $MOSQUITTO_RUNTIME_PASSWD_FILE"
    issues=1
  else
    if ! grep -q "^${MQTT_USER:-domum}:" "$MOSQUITTO_PASSWD_FILE"; then
      echo "[!] Mosquitto password file is missing the ${MQTT_USER:-domum} account"
      issues=1
    fi
    if ! grep -q "^${MQTT_USER:-domum}:" "$MOSQUITTO_RUNTIME_PASSWD_FILE"; then
      echo "[!] Mosquitto runtime password file is missing the ${MQTT_USER:-domum} account"
      issues=1
    fi
    if cmd_exists docker; then
      expected_owner="$(docker run --rm docker.io/library/eclipse-mosquitto:2 sh -c 'printf "%s:%s" "$(id -u mosquitto)" "$(id -g mosquitto)"' 2>/dev/null || true)"
    fi
    if [[ -n "$expected_owner" && "$(stat -c '%u:%g' "$MOSQUITTO_RUNTIME_PASSWD_FILE" 2>/dev/null || true)" != "$expected_owner" ]]; then
      echo "[!] Mosquitto runtime password file must be owned by container mosquitto uid/gid $expected_owner: $MOSQUITTO_RUNTIME_PASSWD_FILE"
      issues=1
    fi
    if [[ "$(stat -c '%a' "$MOSQUITTO_RUNTIME_PASSWD_FILE" 2>/dev/null || true)" != "600" ]]; then
      echo "[!] Mosquitto runtime password file must be mode 0600: $MOSQUITTO_RUNTIME_PASSWD_FILE"
      issues=1
    fi
    if [[ ! -x "$(dirname "$MOSQUITTO_RUNTIME_PASSWD_FILE")" ]]; then
      echo "[!] Mosquitto runtime config directory is not traversable: $(dirname "$MOSQUITTO_RUNTIME_PASSWD_FILE")"
      issues=1
    fi
  fi

  if [[ "${ENABLE_ZIGBEE2MQTT:-0}" == "1" ]]; then
    if [[ -f "$z2m_config" ]] && grep -Eq ':[[:space:]]*!secret[[:space:]]+' "$z2m_config"; then
      echo "[!] Zigbee2MQTT configuration uses invalid unquoted !secret tags; use \"!secret key\" strings."
      issues=1
    fi
    if [[ ! -f "$z2m_secret" ]]; then
      echo "[!] Zigbee2MQTT secret file is missing MQTT credentials: $z2m_secret"
      issues=1
    else
      grep -q '^network_key:' "$z2m_secret" || { echo "[!] Zigbee2MQTT secret.yaml is missing network_key"; issues=1; }
      grep -q '^mqtt_user:' "$z2m_secret" || { echo "[!] Zigbee2MQTT secret.yaml is missing mqtt_user"; issues=1; }
      grep -q '^mqtt_pass:' "$z2m_secret" || { echo "[!] Zigbee2MQTT secret.yaml is missing mqtt_pass"; issues=1; }
      grep -Eq "^mqtt_user:[[:space:]]*\"?${MQTT_USER:-domum}\"?[[:space:]]*$" "$z2m_secret" || {
        echo "[!] Zigbee2MQTT secret.yaml mqtt_user must be ${MQTT_USER:-domum}"
        issues=1
      }
    fi
  fi

  return "$issues"
}

ensure_zigbee2mqtt_runtime_config() {
  [[ "${ENABLE_ZIGBEE2MQTT:-0}" == "1" ]] || return 0
  local dir="$DOMUM_DIR/compose/automation/zigbee2mqtt" f
  install -d -m 0750 "$dir"
  for f in devices.yaml groups.yaml; do
    if [[ ! -f "$dir/$f" || ! -s "$dir/$f" ]]; then
      printf '{}\n' > "$dir/$f"
      chmod 0644 "$dir/$f"
    fi
  done
}

ensure_obsidian_runtime_config() {
  [[ "${ENABLE_OBSIDIAN_SYNC:-0}" == "1" ]] || return 0
  local src="$DOMUM_DIR/compose/productivity/obsidian-sync/local.ini"
  local dst_dir="$DOMUM_DIR/compose/productivity/obsidian-sync/etc"
  [[ -f "$src" ]] || die "Missing Obsidian CouchDB config template: $src"
  install -d -m 0750 "$dst_dir"
  install -m 0644 "$src" "$dst_dir/local.ini"
}

random_password() {
  od -An -tx1 -N24 /dev/urandom | tr -d ' \n'
}

yaml_set_simple_secret() {
  local file="$1" key="$2" value="$3" tmp found=0 line
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key:"* ]]; then
      printf '%s: "%s"\n' "$key" "$value" >> "$tmp"
      found=1
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$file"
  (( found == 1 )) || printf '%s: "%s"\n' "$key" "$value" >> "$tmp"
  install -m 0600 "$tmp" "$file"
  rm -f "$tmp"
}

z2m_restore_network_key_from_backup() {
  local secret="$1" backup="$DOMUM_DIR/compose/automation/zigbee2mqtt/coordinator_backup.json"
  grep -q '^network_key:' "$secret" 2>/dev/null && return 0
  [[ -f "$backup" ]] || die "Zigbee2MQTT network_key missing and coordinator backup not found: $backup"

  python3 - "$backup" "$secret" <<'PY'
import json
import sys
from pathlib import Path

backup = Path(sys.argv[1])
secret = Path(sys.argv[2])
key_hex = json.loads(backup.read_text())["network_key"]["key"]
if len(key_hex) != 32:
    raise SystemExit("unexpected Zigbee network key length")
key = ", ".join(str(int(key_hex[i:i + 2], 16)) for i in range(0, 32, 2))
existing = secret.read_text() if secret.exists() else ""
secret.write_text(f"network_key: [{key}]\n" + existing)
PY
  log "Restored Zigbee2MQTT network_key from coordinator backup."
}

install_mosquitto_runtime_passwd() {
  local uid gid
  cmd_exists docker || die "docker is required to prepare $MOSQUITTO_RUNTIME_PASSWD_FILE"
  uid="$(docker run --rm docker.io/library/eclipse-mosquitto:2 id -u mosquitto)"
  gid="$(docker run --rm docker.io/library/eclipse-mosquitto:2 id -g mosquitto)"
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] || die "Unable to determine Mosquitto container uid/gid."

  install -d -m 0755 "$(dirname "$MOSQUITTO_RUNTIME_PASSWD_FILE")"
  install -m 0600 "$MOSQUITTO_PASSWD_FILE" "$MOSQUITTO_RUNTIME_PASSWD_FILE"
  chown "$uid:$gid" "$MOSQUITTO_RUNTIME_PASSWD_FILE"
}

ensure_state_dirs() {
  install -d -m 0750 "$STATE_ROOT"
  install -d -m 0750 "$STATE_ROOT/backups"
  install -d -m 0750 "$STATE_ROOT/service-backups"
  install -d -m 0750 "$STATE_ROOT/service-backups/actual"
  install -d -m 0750 "$STATE_ROOT/service-backups/homeassistant"
  install -d -m 0750 "$STATE_ROOT/service-backups/mariadb"
  install -d -m 0750 "$STATE_ROOT/service-backups/volumes"
  install -d -m 0750 "$STATE_ROOT/recovery-pack"
  install -d -m 0750 "$STATE_ROOT/update-history"
  install -d -m 0750 "$STATE_ROOT/update-candidates"
  install -d -m 0750 "$STATE_ROOT/rollback"
  install -d -m 0750 "$LOG_DIR"
}

# ---- small utilities -------------------------------------------------------

epoch_to_iso() { date -d "@$1" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null || date -r "$1" +%Y-%m-%dT%H:%M:%S%z; }

human_age_from_epoch() {
  local then="$1" now delta
  now="$(date +%s)"
  delta=$(( now - then ))
  if (( delta < 60 )); then printf '%ss' "$delta"
  elif (( delta < 3600 )); then printf '%sm' $(( delta / 60 ))
  elif (( delta < 86400 )); then printf '%sh' $(( delta / 3600 ))
  else printf '%sd' $(( delta / 86400 )); fi
}

sha256_of_file() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  if cmd_exists sha256sum; then sha256sum "$path" | awk '{print $1}'
  elif cmd_exists shasum; then shasum -a 256 "$path" | awk '{print $1}'
  elif cmd_exists openssl; then openssl dgst -sha256 "$path" | awk '{print $NF}'
  else die "No sha256 utility available (need sha256sum, shasum, or openssl)."; fi
}

file_size() { stat -c %s "$1" 2>/dev/null || stat -f %z "$1"; }

# to_int <value> [default] — first integer token of arbitrary command output, or
# default (0). Strips newlines/junk so the result is always safe inside (( )).
# Guards against the `grep -c` / `wc -l` "0\n0" trap that throws
# "syntax error in expression".
to_int() {
  local v
  v="$(printf '%s' "${1:-}" | tr -dc '0-9\n' | head -n1)"
  printf '%s' "${v:-${2:-0}}"
}

# count_matches <regex> <file> — count matching lines, always emitting exactly one
# integer (0 when the file is missing or nothing matches).
count_matches() {
  local n
  n="$(grep -cE "$1" "$2" 2>/dev/null | head -n1 | tr -dc '0-9')"
  printf '%s' "${n:-0}"
}

write_env_kv() {
  local path="$1"; shift
  : > "$path"
  while (( $# >= 2 )); do
    printf "%s=%q\n" "$1" "$2" >> "$path"
    shift 2
  done
  chmod 600 "$path"
}

read_secret_file_value() {
  local path="$1" value=""
  [[ -f "$path" ]] || return 1
  IFS= read -r -d '' value < "$path" || true
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

confirm() {
  # confirm "<prompt>" — refuses unless the user types yes, or --yes was passed.
  local prompt="$1"
  if [[ "${ASSUME_YES:-0}" == "1" ]]; then
    return 0
  fi
  local reply
  read -r -p "$prompt [type 'yes' to proceed]: " reply
  [[ "$reply" == "yes" ]]
}

# ---- service / container resolution (no hardcoding) ------------------------

normalize_service_name() {
  case "$1" in
    home-assistant|homeassistant) echo "home-assistant" ;;
    music-assistant|musicassistant) echo "musicassistant" ;;
    *) echo "$1" ;;
  esac
}

# Map a logical service name to its compose service name.
compose_service_for() {
  case "$(normalize_service_name "$1")" in
    home-assistant) echo "homeassistant" ;;
    musicassistant) echo "musicassistant" ;;
    *) normalize_service_name "$1" ;;
  esac
}

service_display_name() {
  case "$(normalize_service_name "$1")" in
    home-assistant) echo "Home Assistant" ;;
    actual-budget) echo "Actual Budget" ;;
    adguard-home) echo "AdGuard Home" ;;
    musicassistant) echo "Music Assistant" ;;
    mqtt) echo "MQTT" ;;
    nodered) echo "Node-RED" ;;
    esphome) echo "ESPHome" ;;
    zwave-js-ui) echo "Z-Wave JS UI" ;;
    zigbee2mqtt) echo "Zigbee2MQTT" ;;
    obsidian-sync) echo "Obsidian Sync" ;;
    *) echo "$1" ;;
  esac
}

# Resolve the running container ID for a compose service, via compose itself.
container_for() {
  local svc
  svc="$(compose_service_for "$(normalize_service_name "$1")")"
  compose_cmd ps -q "$svc" 2>/dev/null | head -n1
}

# Resolve the container name for a compose service.
container_name_for() {
  local cid
  cid="$(container_for "$1")"
  [[ -n "$cid" ]] || return 1
  docker inspect --format '{{.Name}}' "$cid" 2>/dev/null | sed 's#^/##'
}

service_running() {
  local cid
  cid="$(container_for "$1")" || return 1
  [[ -n "$cid" ]] || return 1
  [[ "$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || true)" == "running" ]]
}

# ===========================================================================
#  Section 1: original deployment commands (ported verbatim where they work)
# ===========================================================================

install_docker() {
  log "Ensuring Docker + Compose plugin..."
  if cmd_exists docker && docker compose version >/dev/null 2>&1; then
    log "Docker already present."
    return 0
  fi

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y --no-install-recommends ca-certificates curl gnupg lsb-release

  install -m 0755 -d /etc/apt/keyrings
  if [[ ! -f /etc/apt/keyrings/docker.gpg ]]; then
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
  fi

  local arch codename
  arch="$(dpkg --print-architecture)"
  codename="$(. /etc/os-release && echo "${VERSION_CODENAME}")"

  echo \
    "deb [arch=${arch} signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian ${codename} stable" \
    >/etc/apt/sources.list.d/docker.list

  apt-get update -y
  apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  systemctl enable --now docker
  log "Docker installed."
}

install_tailscale_host() {
  [[ "${ENABLE_TAILSCALE:-0}" == "1" ]] || return 0

  log "Ensuring host Tailscale..."
  if ! cmd_exists tailscale; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends ca-certificates curl

    install -d -m 0755 /usr/share/keyrings
    local codename
    codename="$(. /etc/os-release && echo "${VERSION_CODENAME}")"
    if [[ ! -f /usr/share/keyrings/tailscale-archive-keyring.gpg ]]; then
      curl -fsSL "https://pkgs.tailscale.com/stable/debian/${codename}.noarmor.gpg" \
        -o /usr/share/keyrings/tailscale-archive-keyring.gpg
    fi
    if [[ ! -f /etc/apt/sources.list.d/tailscale.list ]]; then
      curl -fsSL "https://pkgs.tailscale.com/stable/debian/${codename}.tailscale-keyring.list" \
        -o /etc/apt/sources.list.d/tailscale.list
    fi

    apt-get update -y
    apt-get install -y --no-install-recommends tailscale
  fi

  if cmd_exists systemctl; then
    systemctl enable --now tailscaled
  fi

  local tailscale_up_cmd="sudo tailscale up"
  [[ "${TAILSCALE_ACCEPT_DNS:-0}" == "1" ]] || tailscale_up_cmd+=" --accept-dns=false"
  [[ "${TAILSCALE_SSH:-0}" == "1" ]] || tailscale_up_cmd+=" --ssh=false"

  if ! tailscale status >/dev/null 2>&1; then
    log "Tailscale installed; authenticate with: $tailscale_up_cmd"
    return 0
  fi

  if [[ "${TAILSCALE_ACCEPT_DNS:-0}" != "1" ]]; then
    tailscale set --accept-dns=false >/dev/null \
      || warn "Could not set Tailscale accept-dns=false; run: sudo tailscale set --accept-dns=false"
  fi

  if [[ "${TAILSCALE_SSH:-0}" != "1" ]]; then
    tailscale set --ssh=false >/dev/null \
      || warn "Could not set Tailscale ssh=false; run: sudo tailscale set --ssh=false"
  fi
}

ensure_dirs() {
  mkdir -p "$DOMUM_DIR/data" "$DOMUM_DIR/logs"
}

warn_non_https_origin_fetch() {
  local dir="$1" fetch_url
  fetch_url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  case "$fetch_url" in
    https://*) ;;
    *)
      warn "origin fetch URL is '${fetch_url:-unset}'; running as root, SSH auth will likely fail."
      warn "Recommended (anonymous fetch, SSH push):"
      warn "  git -C $dir remote set-url origin https://github.com/jfrancolopez/domum-core.git"
      warn "  git -C $dir remote set-url --push origin git@github.com:jfrancolopez/domum-core.git"
      ;;
  esac
}

repo_update() {
  need_root
  log "Updating repo in $DOMUM_DIR..."
  [[ -d "$DOMUM_DIR/.git" ]] || die "$DOMUM_DIR is not a git repo. Reinstall using install.sh"
  warn_non_https_origin_fetch "$DOMUM_DIR"
  git -C "$DOMUM_DIR" fetch --prune origin
  # Soften the original `git reset --hard`: warn loudly about local drift
  # instead of silently destroying it.
  if ! git -C "$DOMUM_DIR" diff --quiet || ! git -C "$DOMUM_DIR" diff --cached --quiet; then
    warn "Local uncommitted changes detected in $DOMUM_DIR."
    warn "A hard reset to origin/main would DISCARD them."
    if ! confirm "Discard local changes and reset to origin/main?"; then
      die "Aborted to preserve local changes. Commit or stash them, then re-run."
    fi
  fi
  git -C "$DOMUM_DIR" reset --hard origin/main
  log "Repo updated."

  # Installed unit files are copies (systemd reads /etc/systemd/system), so a
  # repo update alone leaves them stale. If any installed unit drifted from
  # the repo, re-run the install-maintenance copy: it only copies files and
  # daemon-reloads — it never enables or disables anything.
  local u dst drift=0 installed=0
  for u in "$DOMUM_DIR"/systemd/domum-core-*.service "$DOMUM_DIR"/systemd/domum-core-*.timer; do
    [[ -f "$u" ]] || continue
    dst="/etc/systemd/system/$(basename "$u")"
    [[ -f "$dst" ]] || continue
    installed=1
    cmp -s "$u" "$dst" || drift=1
  done
  if [[ "$drift" -eq 1 ]]; then
    log "systemd/ changed upstream — refreshing installed maintenance units..."
    install_maintenance_unit_files
  elif [[ "$installed" -eq 0 ]]; then
    log "No maintenance units installed; run 'domum-core schedule install-maintenance' to add them."
  fi
}

# ---- service catalog: the single source of truth ---------------------------
#
# Columns: name|enable_var|category|label|backup_var|compose_rel|http_probe
#   name        logical (hyphenated) service name
#   enable_var  domum.conf flag that turns the service on
#   category    grouping for status counts
#   label       documentation/UI category only; it does not control updates
#   backup_var  BACKUP_<SERVICE> flag consumed by `backups run` (- if none)
#   compose_rel compose file relative to $DOMUM_DIR (- if it has no own file)
#   http_probe  host:port for a best-effort local HTTP/TCP health probe (- if none)
#
# go2rtc / portainer / jellyfin / frigate were intentionally removed
# (see docs/reference/removed-services.md).
service_catalog() {
  cat <<'EOF'
traefik|ENABLE_TRAEFIK|proxy|infrastructure|-|compose/proxy/traefik.yml|-
home-assistant|ENABLE_HOME_ASSISTANT|automation|home-automation-core|BACKUP_HOMEASSISTANT|compose/automation/home-assistant.yml|-
mariadb|ENABLE_MARIADB|automation|home-automation-core|BACKUP_MARIADB|compose/automation/mariadb.yml|-
mqtt|ENABLE_MQTT|automation|home-automation-core|BACKUP_MQTT|compose/automation/mqtt.yml|127.0.0.1:1883
zigbee2mqtt|ENABLE_ZIGBEE2MQTT|automation|home-automation-core|BACKUP_ZIGBEE2MQTT|compose/automation/zigbee2mqtt.yml|-
zwave-js-ui|ENABLE_ZWAVE|automation|home-automation-core|BACKUP_ZWAVE|compose/automation/zwave-js-ui.yml|-
nodered|ENABLE_NODERED|automation|home-automation-core|BACKUP_NODERED|compose/automation/nodered.yml|-
esphome|ENABLE_ESP_HOME|automation|home-automation-core|BACKUP_ESPHOME|compose/automation/esphome.yml|-
musicassistant|ENABLE_MA|automation|optional-media|BACKUP_MUSICASSISTANT|compose/automation/music-assistant.yml|-
uptime-kuma|ENABLE_UPTIME_KUMA|monitoring|infrastructure|-|compose/monitoring/uptime-kuma.yml|-
adguard-home|ENABLE_ADGUARD_HOME|networking|infrastructure|BACKUP_ADGUARD|compose/networking/adguard-home.yml|-
actual-budget|ENABLE_ACTUAL_BUDGET|productivity|stateful-app|BACKUP_ACTUAL|compose/productivity/actual-budget.yml|-
vaultwarden|ENABLE_VAULTWARDEN|security|stateful-app|BACKUP_VAULTWARDEN|compose/security/vaultwarden.yml|-
obsidian-sync|ENABLE_OBSIDIAN_SYNC|productivity|stateful-app|BACKUP_OBSIDIAN|compose/productivity/obsidian-sync.yml|-
EOF
}

# catalog_field <name> <column-number> — look up one column for a service.
catalog_field() {
  service_catalog | awk -F'|' -v n="$1" -v c="$2" '$1==n {print $c; exit}'
}

compose_files_for_enabled_services() {
  echo "-f"; echo "$DOMUM_DIR/compose/base.yml"
  local name enable_var _cat _class _bvar compose_rel _probe f
  while IFS='|' read -r name enable_var _cat _class _bvar compose_rel _probe; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    [[ "$compose_rel" == "-" || -z "$compose_rel" ]] && continue
    f="$DOMUM_DIR/$compose_rel"
    [[ -f "$f" ]] || die "Missing compose file: $f"
    echo "-f"
    echo "$f"
  done < <(service_catalog)
}

compose_device_host_paths() {
  local compose_file="$1"
  awk '
    /^[[:space:]]*devices:[[:space:]]*$/ { in_devices=1; next }
    in_devices && /^[[:space:]]*[^[:space:]-]/ { in_devices=0 }
    in_devices && /^[[:space:]]*-[[:space:]]*\/dev\// {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*/, "", line)
      sub(/:.*/, "", line)
      print line
    }
  ' "$compose_file"
}

enabled_services() {
  local name enable_var _rest
  while IFS='|' read -r name enable_var _rest; do
    [[ "${!enable_var:-0}" == "1" ]] && echo "$name"
  done < <(service_catalog)
}

export_env_for_compose() {
  export DOMUM_DOMAIN="${DOMUM_DOMAIN:-ladomum.com}"
  export DOMUM_EMAIL="${DOMUM_EMAIL:-admin@ladomum.com}"
  export DOMUM_LAN_IP="${DOMUM_LAN_IP:-}"
  export DOMUM_TS_IP="${DOMUM_TS_IP:-}"
  export ADGUARD_WEB_PORT="${ADGUARD_WEB_PORT:-3000}"
  export MQTT_USER="${MQTT_USER:-domum}"
  export MQTT_PASSWORD_FILE="${MQTT_PASSWORD_FILE:-$SECRETS_DIR/mqtt_password}"
  export MOSQUITTO_PASSWD_FILE="${MOSQUITTO_PASSWD_FILE:-$SECRETS_DIR/mosquitto_passwd}"
  export MOSQUITTO_RUNTIME_PASSWD_FILE="${MOSQUITTO_RUNTIME_PASSWD_FILE:-$DOMUM_DIR/compose/automation/mqtt/config/passwd}"
  export TRAEFIK_IMAGE="${TRAEFIK_IMAGE:-traefik:v3}"
  export HOMEASSISTANT_IMAGE="${HOMEASSISTANT_IMAGE:-ghcr.io/home-assistant/home-assistant:stable}"
  export MARIADB_IMAGE="${MARIADB_IMAGE:-mariadb:12.2}"

  # Optional-service interpolation (safe defaults; compose has its own too).
  export VAULTWARDEN_DOMAIN="${VAULTWARDEN_DOMAIN:-vault.${DOMUM_DOMAIN}}"
  export VAULTWARDEN_SIGNUPS_ALLOWED="${VAULTWARDEN_SIGNUPS_ALLOWED:-false}"
  export VAULTWARDEN_INVITATIONS_ALLOWED="${VAULTWARDEN_INVITATIONS_ALLOWED:-false}"
  export OBSIDIAN_DOMAIN="${OBSIDIAN_DOMAIN:-obsidian.${DOMUM_DOMAIN}}"
  export OBSIDIAN_COUCHDB_USER="${OBSIDIAN_COUCHDB_USER:-obsidian}"
  export OBSIDIAN_COUCHDB_PASSWORD="${OBSIDIAN_COUCHDB_PASSWORD:-changeme}"

  if [[ -z "${CF_DNS_API_TOKEN:-}" && -f "$SECRETS_DIR/cloudflare_api_token" ]]; then
    CF_DNS_API_TOKEN="$(cat "$SECRETS_DIR/cloudflare_api_token")"
    export CF_DNS_API_TOKEN
  fi
}

ensure_networks() {
  local nets=("domum-internal" "domum-proxy" "domum-data")
  for n in "${nets[@]}"; do
    if ! docker network inspect "$n" >/dev/null 2>&1; then
      log "Creating docker network: $n"
      docker network create "$n" >/dev/null
    fi
  done
}

compose_cmd() {
  local -a args
  mapfile -t args < <(compose_files_for_enabled_services)
  cd "$DOMUM_DIR"
  docker compose "${args[@]}" "$@"
}

init_host() {
  need_root
  install_docker
  ensure_dirs
  install -d -m 0700 "$SECRETS_DIR"

  # Copy *.conf.example -> *.conf if missing (never overwrite a live config).
  if [[ ! -f "$CFG_FILE" && -f "${CFG_FILE}.example" ]]; then
    log "Creating $CFG_FILE from example."
    install -m 0640 "${CFG_FILE}.example" "$CFG_FILE"
  fi
  if [[ ! -f "$BACKUP_CFG_FILE" && -f "${BACKUP_CFG_FILE}.example" ]]; then
    log "Creating $BACKUP_CFG_FILE from example."
    install -m 0640 "${BACKUP_CFG_FILE}.example" "$BACKUP_CFG_FILE"
  fi
  load_cfg
  install_tailscale_host
  ensure_state_dirs

  if [[ ! -f "$SECRETS_DIR/cloudflare_api_token" ]]; then
    log "NOTE: $SECRETS_DIR/cloudflare_api_token not found."
    log "      Create it for real TLS certs via Cloudflare DNS-01."
  fi

  if [[ ! -f "$DOMUM_DIR/.env" ]]; then
    cat >"$DOMUM_DIR/.env" <<EOF
# Optional per-host env file (not required for most services)
EOF
    chmod 0600 "$DOMUM_DIR/.env"
  fi

  log "Init complete."
}

apply() {
  need_root
  load_cfg
  validate_obsidian_credentials || die "Fix Obsidian Sync credentials before apply."
  validate_mqtt_auth || die "Run 'domum-core mqtt init-auth' before apply."
  install_tailscale_host
  ensure_networks
  export_env_for_compose
  install_docker
  ensure_dirs
  ensure_state_dirs
  ensure_zigbee2mqtt_runtime_config
  ensure_obsidian_runtime_config

  log "Applying desired state..."
  compose_cmd --profile core up -d --remove-orphans

  log "Apply done."
}

# ===========================================================================
#  Section: status (+ --counts)
# ===========================================================================

status_counts() {
  echo "=== service counts ==="
  local total=0 running=0 name
  declare -A cat_total cat_running
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    local cat
    cat="$(service_catalog | awk -F'|' -v n="$name" '$1==n {print $3}')"
    total=$(( total + 1 ))
    cat_total["$cat"]=$(( ${cat_total["$cat"]:-0} + 1 ))
    if service_running "$name"; then
      running=$(( running + 1 ))
      cat_running["$cat"]=$(( ${cat_running["$cat"]:-0} + 1 ))
    fi
  done < <(enabled_services)
  printf 'Containers running: %d / %d enabled\n' "$running" "$total"
  echo "Per category:"
  local c
  for c in $(printf '%s\n' "${!cat_total[@]}" | sort); do
    printf '  %-12s %d / %d\n' "$c" "${cat_running[$c]:-0}" "${cat_total[$c]}"
  done
}

status_storage() {
  echo "=== storage ==="
  printf '%-22s %-8s %-8s %-8s %-6s\n' "PATH" "SIZE" "USED" "AVAIL" "USE%"
  local path
  for path in / /opt "$STATE_ROOT"; do
    [[ -e "$path" ]] || continue
    df -P "$path" 2>/dev/null | awk 'NR==2 {printf "%-22s %-8s %-8s %-8s %-6s\n", "'"$path"'", $2, $3, $4, $5}'
  done
}

status() {
  need_root
  load_cfg
  ensure_networks
  export_env_for_compose
  local show_counts=0
  [[ "${1:-}" == "--counts" ]] && show_counts=1

  echo "=== compose ps ==="
  compose_cmd ps || true

  if (( show_counts == 1 )); then
    echo
    status_counts
  fi

  echo
  status_storage

  echo
  echo "=== backup heartbeat ==="
  local hb="$STATE_ROOT/backups/last-success"
  if [[ -f "$hb" ]]; then
    echo "  last successful backup: $(cat "$hb") ($(human_age_from_epoch "$(stat -c %Y "$hb" 2>/dev/null || stat -f %m "$hb")") ago)"
  else
    echo "  no successful backup recorded yet"
  fi
}

# ===========================================================================
#  Section: per-service backups (Actual, Home Assistant, MariaDB)
# ===========================================================================

prune_staging() {
  # prune_staging <dir> <glob> <keep>
  local dir="$1" glob="$2" keep="$3" count
  count="$(to_int "$(find "$dir" -maxdepth 1 -name "$glob" -type f 2>/dev/null | wc -l)")"
  keep="$(to_int "$keep" 7)"
  if (( count > keep )); then
    # shellcheck disable=SC2012,SC2086
    ls -1t "$dir"/$glob 2>/dev/null | tail -n +$(( keep + 1 )) | while IFS= read -r old; do
      run rm -f "$old"
    done
  fi
}

actual_data_dir() { echo "$DOMUM_DIR/compose/productivity/actual-budget/data"; }

actual_backup() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  [[ "${ENABLE_ACTUAL_BUDGET:-0}" == "1" ]] || { log "Actual Budget not enabled — nothing to back up."; return 0; }

  local data_dir stage ts archive
  data_dir="$(actual_data_dir)"
  stage="$STATE_ROOT/service-backups/actual"
  ts="$(date +%Y%m%d-%H%M%S)"
  archive="$stage/actual-${ts}.tar.gz"

  [[ -d "$data_dir" ]] || { warn "Actual data dir not found: $data_dir"; return 0; }

  log "Actual Budget backup -> $archive"
  local paused=0
  if [[ "${ACTUAL_QUIESCE:-0}" == "1" ]] && service_running actual-budget; then
    local cn
    cn="$(container_name_for actual-budget || true)"
    if [[ -n "$cn" ]]; then
      log "Quiescing (docker pause) $cn for a consistent SQLite copy."
      run docker pause "$cn" || true
      paused=1
    fi
  fi

  run tar -C "$(dirname "$data_dir")" -czf "$archive" "$(basename "$data_dir")"
  local rc=$?

  if (( paused == 1 )); then
    local cn
    cn="$(container_name_for actual-budget || true)"
    if [[ -n "$cn" ]]; then
      run docker unpause "$cn" || true
    fi
  fi
  (( rc == 0 )) || die "Actual backup tar failed."

  (( DRY_RUN == 1 )) || prune_staging "$stage" 'actual-*.tar.gz' "${ACTUAL_KEEP:-7}"
  log "Actual Budget backup done."
}

actual_restore_plan() {
  load_cfg
  local data_dir stage
  data_dir="$(actual_data_dir)"
  stage="$STATE_ROOT/service-backups/actual"
  cat <<EOF
Actual Budget — non-destructive restore plan
=============================================
Archives live in: $stage
Live data dir:     $data_dir

1. Pick an archive:
     ls -1t $stage/actual-*.tar.gz
2. Stop the container (Actual uses SQLite — copy must be quiescent):
     docker compose ... stop actual-budget
     # or: sudo domum-core apply  (after disabling) — but simplest is compose stop
3. Move the current data aside (NEVER overwrite in place):
     mv $data_dir ${data_dir}.bak-\$(date +%Y%m%d-%H%M%S)
4. Extract the chosen archive:
     mkdir -p $(dirname "$data_dir")
     tar -C $(dirname "$data_dir") -xzf $stage/actual-YYYYMMDD-HHMMSS.tar.gz
5. Start the container and verify in the Actual web UI:
     sudo domum-core apply
6. If something is wrong, stop, restore ${data_dir}.bak-*, start again.
EOF
}

ha_config_dir() { echo "$DOMUM_DIR/compose/automation/home-assistant"; }

mariadb_dump() {
  # Dumps all DBs from the mariadb container (HA recorder history lives here).
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  [[ "${ENABLE_MARIADB:-0}" == "1" ]] || { log "MariaDB not enabled — skipping DB dump."; return 0; }
  service_running mariadb || { warn "MariaDB container not running — skipping DB dump."; return 0; }

  local cn stage ts dump
  cn="$(container_name_for mariadb)" || { warn "Could not resolve mariadb container."; return 0; }
  stage="$STATE_ROOT/service-backups/mariadb"
  ts="$(date +%Y%m%d-%H%M%S)"
  dump="$stage/mariadb-all-${ts}.sql.gz"

  log "MariaDB dump -> $dump"
  if (( DRY_RUN == 1 )); then
    echo "[dry-run] docker exec $cn sh -c 'mariadb-dump --all-databases ...' | gzip > $dump"
  else
    # Credentials come from the container's own env (MARIADB_ROOT_PASSWORD).
    docker exec "$cn" sh -c 'exec mariadb-dump --all-databases --single-transaction --quick -uroot -p"$MARIADB_ROOT_PASSWORD"' \
      | gzip -9 > "$dump" \
      || { warn "mariadb-dump failed (check MARIADB_ROOT_PASSWORD in the container env)."; rm -f "$dump"; return 1; }
    prune_staging "$stage" 'mariadb-all-*.sql.gz' "${MARIADB_KEEP:-7}"
  fi
  log "MariaDB dump done."
}

homeassistant_backup() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  [[ "${ENABLE_HOME_ASSISTANT:-0}" == "1" ]] || { log "Home Assistant not enabled — nothing to back up."; return 0; }

  local cfg_dir stage ts archive
  cfg_dir="$(ha_config_dir)"
  stage="$STATE_ROOT/service-backups/homeassistant"
  ts="$(date +%Y%m%d-%H%M%S)"
  archive="$stage/ha-${ts}.tar.gz"

  [[ -d "$cfg_dir" ]] || { warn "HA config dir not found: $cfg_dir"; return 0; }

  # Container image install — never restart HA. Filesystem-level tar of the
  # config dir, excluding regenerable / volatile data.
  log "Home Assistant config backup -> $archive"
  run tar -C "$(dirname "$cfg_dir")" \
    --exclude='home-assistant/*.db-wal' \
    --exclude='home-assistant/*.db-shm' \
    --exclude='home-assistant/tts' \
    --exclude='home-assistant/deps' \
    --exclude='home-assistant/.cloud' \
    -czf "$archive" "$(basename "$cfg_dir")" \
    || die "HA config tar failed."

  (( DRY_RUN == 1 )) || prune_staging "$stage" 'ha-*.tar.gz' "${HA_KEEP:-7}"

  # HA history lives in MariaDB (recorder), not the config dir. Dump it too;
  # this doubles as the MariaDB backup.
  mariadb_dump || warn "MariaDB recorder dump failed — HA history not captured this run."

  log "Home Assistant backup done."
}

homeassistant_restore_plan() {
  load_cfg
  local cfg_dir stage mstage
  cfg_dir="$(ha_config_dir)"
  stage="$STATE_ROOT/service-backups/homeassistant"
  mstage="$STATE_ROOT/service-backups/mariadb"
  cat <<EOF
Home Assistant — manual restore plan (never auto-applied)
=========================================================
Config archives:   $stage/ha-*.tar.gz
Recorder DB dumps: $mstage/mariadb-all-*.sql.gz
Live config dir:   $cfg_dir

1. Stop HA and MariaDB:
     docker compose ... stop homeassistant mariadb
2. Restore config (non-destructive — move current aside first):
     mv $cfg_dir ${cfg_dir}.bak-\$(date +%Y%m%d-%H%M%S)
     tar -C $(dirname "$cfg_dir") -xzf $stage/ha-YYYYMMDD-HHMMSS.tar.gz
3. Restore MariaDB (recorder history):
     sudo domum-core apply        # bring MariaDB up first
     gunzip -c $mstage/mariadb-all-YYYYMMDD-HHMMSS.sql.gz | \\
       docker exec -i \$(sudo docker ps -qf name=mariadb) \\
       sh -c 'mariadb -uroot -p"\$MARIADB_ROOT_PASSWORD"'
4. Start HA:
     sudo domum-core apply
5. Verify the HA UI at https://ha.${DOMUM_DOMAIN:-<domain>} (or :8123).
EOF
}

# ---- generic service-level backups (unified engine) ------------------------

# Bind-mount data dir for a logical service (empty if it has no own dir, e.g.
# a service whose data lives in a named docker volume captured by restic).
backup_src_dir_for() {
  case "$1" in
    home-assistant) ha_config_dir ;;
    actual-budget)  actual_data_dir ;;
    mqtt)           echo "$DOMUM_DIR/compose/automation/mqtt" ;;
    zigbee2mqtt)    echo "$DOMUM_DIR/compose/automation/zigbee2mqtt" ;;
    zwave-js-ui)    echo "$DOMUM_DIR/compose/automation/zwave-js-ui/store" ;;
    esphome)        echo "$DOMUM_DIR/compose/automation/esphome" ;;
    musicassistant) echo "$DOMUM_DIR/compose/automation/music-assistant" ;;
    adguard-home)   echo "$DOMUM_DIR/compose/networking/adguard" ;;
    vaultwarden)    echo "$DOMUM_DIR/compose/security/vaultwarden/data" ;;
    obsidian-sync)  echo "$DOMUM_DIR/compose/productivity/obsidian-sync/data" ;;
    *) echo "" ;;
  esac
}

# Validate a freshly written artifact: exists, non-empty, and (for .gz) intact.
validate_backup_artifact() {
  local path="$1"
  [[ -f "$path" ]] || { warn "backup artifact missing: $path"; return 1; }
  [[ "$(to_int "$(file_size "$path")")" -gt 0 ]] || { warn "backup artifact is empty: $path"; return 1; }
  case "$path" in
    *.gz) gzip -t "$path" 2>/dev/null || { warn "backup artifact failed gzip integrity: $path"; return 1; } ;;
  esac
  return 0
}

# Services whose data dir holds a live SQLite DB: pause the container for
# the seconds the tar takes so the copy is consistent. Vaultwarden is the
# password manager — the one backup that must not turn out corrupt exactly
# when it matters most. (Actual Budget has its own quiesce in actual_backup.)
service_needs_sqlite_quiesce() {
  case "$1" in
    vaultwarden) return 0 ;;
    *) return 1 ;;
  esac
}

# Tar a service's bind-mount dir into staging (used for services without a
# bespoke quiesce step). Returns the artifact path on stdout.
service_fs_backup() {
  local name="$1" src stage ts archive
  src="$(backup_src_dir_for "$name")"
  [[ -n "$src" ]] || { log "$name has no bind-mount dir (captured via restic) — skipping service tar."; return 0; }
  [[ -d "$src" ]] || { warn "$name data dir not found: $src — skipping."; return 0; }
  stage="$STATE_ROOT/service-backups/$name"
  install -d -m 0750 "$stage"
  ts="$(date +%Y%m%d-%H%M%S)"
  archive="$stage/${name}-${ts}.tar.gz"
  log "$name backup -> $archive"

  local paused=0 cn="" rc=0
  if service_needs_sqlite_quiesce "$name" && service_running "$name"; then
    cn="$(container_name_for "$name" || true)"
    if [[ -n "$cn" ]]; then
      log "Quiescing (docker pause) $cn for a consistent SQLite copy."
      run docker pause "$cn" || true
      paused=1
    fi
  fi
  run tar -C "$(dirname "$src")" -czf "$archive" "$(basename "$src")" || rc=1
  if (( paused == 1 )); then
    run docker unpause "$cn" || warn "failed to unpause $cn — check it manually!"
  fi
  (( rc == 0 )) || { warn "$name tar failed."; return 1; }

  if (( DRY_RUN == 0 )); then
    validate_backup_artifact "$archive" || return 1
    prune_staging "$stage" "${name}-*.tar.gz" "${SERVICE_BACKUP_KEEP:-7}"
  fi
}

backup_history_log() { echo "$STATE_ROOT/backups/history.log"; }

# Drive app-consistent service-level backups for every enabled+flagged service.
run_service_backups() {
  local dry="${1:-0}" name enable_var _cat _class bvar _rel _probe rc=0
  while IFS='|' read -r name enable_var _cat _class bvar _rel _probe; do
    [[ "${!enable_var:-0}" == "1" ]] || continue          # service enabled?
    [[ "$bvar" == "-" || -z "$bvar" ]] && continue        # has a backup flag?
    [[ "${!bvar:-0}" == "1" ]] || { log "$name backup disabled ($bvar=0) — skipping."; continue; }
    case "$name" in
      home-assistant) DRY_RUN="$dry" homeassistant_backup || rc=1 ;;  # also dumps MariaDB
      mariadb)        : ;;  # captured by the HA recorder dump
      actual-budget)  DRY_RUN="$dry" actual_backup || rc=1 ;;
      *)              DRY_RUN="$dry" service_fs_backup "$name" || rc=1 ;;
    esac
  done < <(service_catalog)
  return "$rc"
}

# ===========================================================================
#  Section: restic backups (delegates to bin/domum-core-backup)
# ===========================================================================

# /usr/local/bin entry is a symlink into the repo (install.sh); the repo
# fallback covers hosts installed before symlinks or with the link removed.
BACKUP_BIN_CANDIDATES=(/usr/local/bin/domum-core-backup "$DOMUM_DIR/bin/domum-core-backup")

backup_bin() {
  local b
  for b in "${BACKUP_BIN_CANDIDATES[@]}"; do
    [[ -x "$b" ]] && { echo "$b"; return 0; }
  done
  echo "$DOMUM_DIR/bin/domum-core-backup"
}

# ---- per-run backup manifest ------------------------------------------------
# One JSON file describing what this run backed up, from what software state,
# with per-artifact sha256. Overwritten each run — history lives in restic
# snapshots, where the manifest rides along (it is in BACKUP_PATHS).
# Consumers: restore verification (checksum list), the restore wizard
# (summary + enabled-timer replay), the weekly report. A missing manifest is
# always informational, never an error — old snapshots predate it.

backup_manifest_file() { echo "$STATE_ROOT/service-backups/BACKUP-MANIFEST.json"; }

json_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"; s="${s//$'\t'/ }"
  printf '%s' "$s"
}

# One line per enabled service: "<name>\t<running image digest | (not running)>".
# Shared by the manifest and the recovery pack's service inventory.
service_inventory_lines() {
  local svc cid
  while IFS= read -r svc; do
    cid="$(container_for "$svc" || true)"
    if [[ -n "$cid" ]]; then
      printf '%s\t%s\n' "$svc" "$(docker inspect --format '{{range .RepoDigests}}{{.}} {{end}}{{.Image}}' "$cid" 2>/dev/null || echo unknown)"
    else
      printf '%s\t(not running)\n' "$svc"
    fi
  done < <(enabled_services)
}

# Emit one artifact object (no trailing comma; caller manages separators).
backup_manifest_artifact_json() {
  local abs="$1" rel="$2"
  printf '    {"path": "%s", "size": %s, "sha256": "%s"}' \
    "$(json_str "$rel")" \
    "$(to_int "$(file_size "$abs")")" \
    "$(sha256_of_file "$abs" || echo unknown)"
}

manifest_enabled_targets() {
  grep -oE '^BACKUP_TARGET_[A-Z0-9]+_ENABLED=1' "$BACKUP_CFG_FILE" 2>/dev/null \
    | sed -E 's/^BACKUP_TARGET_([A-Z0-9]+)_ENABLED=1/\1/' | tr '[:upper:]' '[:lower:]'
}

write_backup_manifest() {
  local out tmp
  out="$(backup_manifest_file)"
  tmp="${out}.tmp"
  local commit dirty os_rel
  commit="$(git -C "$DOMUM_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
  if git -C "$DOMUM_DIR" diff --quiet 2>/dev/null \
     && git -C "$DOMUM_DIR" diff --cached --quiet 2>/dev/null; then
    dirty=false
  else
    dirty=true
  fi
  os_rel="$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}" || echo unknown)"

  {
    printf '{\n'
    printf '  "manifest_schema": 1,\n'
    printf '  "created_at": "%s",\n' "$(json_str "$(date -Iseconds)")"
    printf '  "host": "%s",\n' "$(json_str "$(hostname)")"
    printf '  "git_commit": "%s",\n' "$(json_str "$commit")"
    printf '  "git_dirty": %s,\n' "$dirty"
    printf '  "os_release": "%s",\n' "$(json_str "$os_rel")"
    printf '  "kernel": "%s",\n' "$(json_str "$(uname -r)")"
    printf '  "docker_version": "%s",\n' "$(json_str "$(docker --version 2>/dev/null || echo unknown)")"
    printf '  "restic_version": "%s",\n' "$(json_str "$(restic version 2>/dev/null | head -n1 || echo unknown)")"

    printf '  "enabled_services": [\n'
    local first=1 svc image
    while IFS=$'\t' read -r svc image; do
      (( first == 0 )) && printf ',\n'
      printf '    {"name": "%s", "image": "%s"}' "$(json_str "$svc")" "$(json_str "$image")"
      first=0
    done < <(service_inventory_lines)
    printf '\n  ],\n'

    printf '  "backup_flags": {'
    first=1
    local name _ev _cat _class bvar _rel _probe
    while IFS='|' read -r name _ev _cat _class bvar _rel _probe; do
      [[ "$bvar" == "-" || -z "$bvar" ]] && continue
      (( first == 0 )) && printf ', '
      printf '"%s": %s' "$(json_str "$bvar")" "$(to_int "${!bvar:-0}")"
      first=0
    done < <(service_catalog)
    printf '},\n'

    # Enabled timers: the host state a rebuild must recreate (disposable OS).
    local -a timers=()
    local t
    while IFS= read -r t; do [[ -n "$t" ]] && timers+=("$t"); done < <(
      systemctl list-unit-files 'domum-core-*.timer' --state=enabled --no-legend 2>/dev/null \
        | awk '{print $1}'
    )
    printf '  "enabled_timers": %s,\n' "$(json_array_from_items ${timers[@]+"${timers[@]}"})"

    local -a tgts=()
    while IFS= read -r t; do [[ -n "$t" ]] && tgts+=("$t"); done < <(manifest_enabled_targets)
    printf '  "targets": %s,\n' "$(json_array_from_items ${tgts[@]+"${tgts[@]}"})"

    # Artifacts: the newest file per service staging dir (this run's, when the
    # run succeeded) plus every named-volume export (overwritten per run).
    printf '  "artifacts": [\n'
    first=1
    local d f
    for d in "$STATE_ROOT/service-backups"/*/; do
      [[ -d "$d" ]] || continue
      if [[ "$(basename "$d")" == "volumes" ]]; then
        for f in "$d"*.tar.gz; do
          [[ -f "$f" ]] || continue
          (( first == 0 )) && printf ',\n'
          backup_manifest_artifact_json "$f" "volumes/$(basename "$f")"
          first=0
        done
        continue
      fi
      # shellcheck disable=SC2012
      f="$(ls -1t "$d" 2>/dev/null | head -n1)"
      [[ -n "$f" && -f "$d$f" ]] || continue
      (( first == 0 )) && printf ',\n'
      backup_manifest_artifact_json "$d$f" "$(basename "$d")/$f"
      first=0
    done
    printf '\n  ]\n'
    printf '}\n'
  } > "$tmp"

  mv "$tmp" "$out"
  chmod 640 "$out"
  log "Backup manifest written: $out"
}

backups_cmd() {
  need_root
  load_cfg
  local sub="${1:-}"; shift || true
  local bin
  bin="$(backup_bin)"
  case "$sub" in
    run)
      local dry=0 svc_rc=0 restic_rc=0
      [[ "${1:-}" == "--dry-run" ]] && dry=1
      ensure_state_dirs
      # 1+2. App-consistent service-level backups + artifact validation,
      #      flag-driven from the catalog (BACKUP_<SERVICE>).
      log "Stage 1: service-level backups..."
      run_service_backups "$dry" || { svc_rc=1; warn "One or more service-level backups failed."; }
      # 3. Metadata: which services were captured this run + the per-run
      #    manifest (rides into restic via BACKUP_PATHS).
      if (( dry == 0 )); then
        enabled_services > "$STATE_ROOT/backups/last-services.txt" 2>/dev/null || true
        write_backup_manifest || warn "Failed to write backup manifest."
      else
        log "[dry-run] would write backup manifest: $(backup_manifest_file)"
      fi
      # 4. restic push.
      log "Stage 4: restic backup..."
      if (( dry == 1 )); then "$bin" --dry-run; else "$bin" || restic_rc=1; fi
      # 5. Snapshot verification (skip on dry-run).
      if (( dry == 0 && restic_rc == 0 )); then
        log "Stage 5: verifying latest snapshots..."
        "$bin" --snapshots || warn "Snapshot listing failed."
      fi
      # 6. Backup history.
      if (( dry == 0 )); then
        printf '%s  service_rc=%s  restic_rc=%s\n' \
          "$(date -Iseconds)" "$svc_rc" "$restic_rc" >> "$(backup_history_log)"
      fi
      (( svc_rc == 0 && restic_rc == 0 ))
      ;;
    verify)    "$bin" --check ;;
    history)
      if [[ -f "$(backup_history_log)" ]]; then cat "$(backup_history_log)"; else echo "No backup history yet."; fi
      ;;
    snapshots) "$bin" --snapshots ;;
    prune)
      if [[ "${1:-}" == "--dry-run" ]]; then
        "$bin" --prune-dry-run
      else
        "$bin" --prune
      fi
      ;;
    init)      "$bin" init "$@" ;;
    *) die "Usage: domum-core backups {run [--dry-run]|verify|snapshots|history|prune [--dry-run]|init <target>}" ;;
  esac
}

# ===========================================================================
#  Section: guided restore (the DR wizard)
# ===========================================================================
# One guided command from a fresh install to a running system: unpack the
# recovery pack -> pick target + snapshot -> restore to staging -> rsync into
# place (never in place; every overwritten file keeps a .pre-restore sibling)
# -> reassemble volumes -> bring up in safe order -> load MariaDB -> offer to
# re-enable the timers recorded in the backup manifest.
#
# Two credential intakes, one shared everything-else: the recovery pack
# (primary — carries config + all secrets) or --manual (last resort: one repo
# string + password, restores config + the pack, then pivots to the pack).
# The hard floor no wizard removes: the AGE private key (and, for --manual, a
# restic password) must survive off-Pi.

RESTORE_STAGING="${RESTORE_STAGING:-$STATE_ROOT/restore-staging}"
# Where decrypted pack contents / typed passwords briefly live (root-only).
RESTORE_TMPDIR="${RESTORE_TMPDIR:-/root}"

# Extract a top-level string field from BACKUP-MANIFEST.json (grep-based on
# purpose: no dependencies, display-only).
manifest_str_field() {
  grep -oE "\"$2\": \"[^\"]*\"" "$1" 2>/dev/null | head -n1 | sed -E "s/\"$2\": \"(.*)\"/\1/"
}

restore_show_manifest_summary() {
  local mf="$1"
  if [[ ! -f "$mf" ]]; then
    log "No backup manifest in this snapshot (predates task 33) — continuing without it."
    return 0
  fi
  local n_svc
  n_svc="$(grep -oE '\{"name":' "$mf" 2>/dev/null | wc -l | tr -d ' ' || true)"
  echo
  echo "About to restore (from the snapshot's own manifest):"
  echo "  created:  $(manifest_str_field "$mf" created_at)"
  echo "  host:     $(manifest_str_field "$mf" host)"
  echo "  commit:   $(manifest_str_field "$mf" git_commit)"
  echo "  os:       $(manifest_str_field "$mf" os_release)"
  echo "  services: ${n_svc}"
  echo
}

restore_pack_intake() {
  local pack="$1" key="$2" tmpdir
  cmd_exists age || die "age is not installed (apt-get install -y age)."
  [[ -f "$pack" ]] || die "Recovery pack not found: $pack"
  [[ -f "$key" ]] || die "AGE key not found: $key"
  tmpdir="$(mktemp -d "$RESTORE_TMPDIR/domum-restore-pack.XXXXXX")"
  log "Decrypting recovery pack -> $tmpdir"
  age -d -i "$key" "$pack" | tar -xzf - -C "$tmpdir" \
    || { rm -rf "$tmpdir"; die "Failed to decrypt/unpack the recovery pack."; }

  echo "Pack contents:"
  ( cd "$tmpdir" && find . -type f | sed 's/^/  /' )
  confirm "Install secrets to $SECRETS_DIR and config to $DOMUM_DIR/config?" \
    || { log "Pack left unpacked at $tmpdir (nothing installed)."; return 1; }

  install -d -m 0700 "$SECRETS_DIR"
  if [[ -d "$tmpdir/secrets" ]]; then
    ( cd "$tmpdir/secrets" && find . -type f ) | while IFS= read -r rel; do
      rel="${rel#./}"
      install -D -m 0600 "$tmpdir/secrets/$rel" "$SECRETS_DIR/$rel"
    done
    chown -R root:root "$SECRETS_DIR"
  fi
  local f base
  for f in "$tmpdir"/config/*; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    if [[ -f "$DOMUM_DIR/config/$base" ]]; then
      install -m 0640 "$DOMUM_DIR/config/$base" "$DOMUM_DIR/config/$base.pre-restore"
    fi
    install -m 0640 "$f" "$DOMUM_DIR/config/$base"
  done
  rm -rf "$tmpdir"
  log "Secrets + config installed."
}

restore_manual_intake() {
  # Last resort: one repo + password. Restores config/ and the recovery-pack
  # directory from that repo, then pivots to the pack for everything else.
  cmd_exists restic || die "restic is not installed (apt-get install -y restic)."
  local repo pw pwfile
  read -r -p "restic repository (e.g. /mnt/usb/domum-core or sftp:user@host:/./repo): " repo
  [[ -n "$repo" ]] || die "No repository given."
  read -r -s -p "restic password: " pw; echo
  [[ -n "$pw" ]] || die "No password given."
  pwfile="$(mktemp "$RESTORE_TMPDIR/.domum-restore-pw.XXXXXX")"
  printf '%s\n' "$pw" > "$pwfile"; chmod 600 "$pwfile"; pw=""

  export RESTIC_REPOSITORY="$repo" RESTIC_PASSWORD_FILE="$pwfile"
  log "Snapshots in $repo:"
  restic snapshots --latest 3 || { rm -f "$pwfile"; die "Cannot read that repository."; }
  local snap
  read -r -p "Snapshot ID to pull config + recovery pack from [latest]: " snap
  snap="${snap:-latest}"

  local stag="$RESTORE_STAGING-manual"
  mkdir -p "$stag"
  restic restore "$snap" --target "$stag" \
    --include "$DOMUM_DIR/config" --include "$STATE_ROOT/recovery-pack" \
    || { rm -f "$pwfile"; die "Restore of config/recovery-pack failed."; }
  rm -f "$pwfile"; unset RESTIC_REPOSITORY RESTIC_PASSWORD_FILE

  mkdir -p "$DOMUM_DIR/config" "$STATE_ROOT/recovery-pack"
  [[ -d "$stag$DOMUM_DIR/config" ]] \
    && rsync -a --backup --suffix=".pre-restore" "$stag$DOMUM_DIR/config/" "$DOMUM_DIR/config/"
  [[ -d "$stag$STATE_ROOT/recovery-pack" ]] \
    && rsync -a "$stag$STATE_ROOT/recovery-pack/" "$STATE_ROOT/recovery-pack/"

  cat <<EOF

Config and recovery pack(s) restored:
  $(find "$STATE_ROOT/recovery-pack" -maxdepth 1 -name 'recovery-pack-*.tar.age' 2>/dev/null | tail -n3 | sed 's/^/  /' || echo "  (none found — check the snapshot)")

Next: decrypt the newest pack with your OFFLINE AGE key and re-run:
  sudo domum-core restore --pack $STATE_ROOT/recovery-pack/recovery-pack-<newest>.tar.age --key /path/to/recovery-age.key

(Staging kept at $stag — remove it when done.)
EOF
}

restore_pick_target_snapshot() {
  # Sets RESTORE_TARGET and RESTORE_SNAP. Unreachable targets are non-fatal.
  local bin first_target=""
  bin="$(backup_bin)"
  echo
  echo "Available snapshots per enabled target (unreachable targets listed as failed):"
  "$bin" --snapshots || true
  echo
  first_target="$(grep -oE '^BACKUP_TARGET_[A-Z0-9]+_ENABLED=1' "$BACKUP_CFG_FILE" 2>/dev/null \
    | head -n1 | sed -E 's/^BACKUP_TARGET_([A-Z0-9]+)_ENABLED=1/\1/' | tr '[:upper:]' '[:lower:]' || true)"
  read -r -p "Restore from target [${first_target:-none}]: " RESTORE_TARGET
  RESTORE_TARGET="${RESTORE_TARGET:-$first_target}"
  [[ -n "$RESTORE_TARGET" ]] || die "No target selected and none enabled in $BACKUP_CFG_FILE."
  read -r -p "Snapshot ID [latest]: " RESTORE_SNAP
  RESTORE_SNAP="${RESTORE_SNAP:-latest}"
}

restore_data_from_snapshot() {
  local bin ts
  bin="$(backup_bin)"
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$RESTORE_STAGING"

  log "Restoring snapshot '$RESTORE_SNAP' from '$RESTORE_TARGET' to staging: $RESTORE_STAGING"
  "$bin" --restore "$RESTORE_SNAP" "$RESTORE_STAGING" "$RESTORE_TARGET" \
    || die "restic restore failed."

  restore_show_manifest_summary "$RESTORE_STAGING$STATE_ROOT/service-backups/BACKUP-MANIFEST.json"

  echo "Staging now holds (top level):"
  find "$RESTORE_STAGING" -maxdepth 3 -type d 2>/dev/null | head -20 | sed 's/^/  /' || true
  echo
  echo "Next: rsync staging into place. Every overwritten file keeps a"
  echo "sibling copy with suffix .pre-restore-$ts (nothing is deleted)."
  confirm "Rsync restored data into $DOMUM_DIR and $STATE_ROOT?" || die "Stopped before touching live data. Staging kept at $RESTORE_STAGING."

  if [[ -d "$RESTORE_STAGING$DOMUM_DIR" ]]; then
    rsync -aHAX --backup --suffix=".pre-restore-$ts" "$RESTORE_STAGING$DOMUM_DIR/" "$DOMUM_DIR/"
  fi
  if [[ -d "$RESTORE_STAGING$STATE_ROOT" ]]; then
    rsync -aHAX --backup --suffix=".pre-restore-$ts" "$RESTORE_STAGING$STATE_ROOT/" "$STATE_ROOT/"
  fi
  log "Data in place. Staging kept at $RESTORE_STAGING (remove manually when satisfied)."
}

restore_reassemble() {
  ensure_networks
  local vol_stage="$STATE_ROOT/service-backups/volumes" f v
  if compgen -G "$vol_stage/*.tar.gz" >/dev/null; then
    echo "Named-volume exports found:"
    find "$vol_stage" -maxdepth 1 -name '*.tar.gz' | sed 's/^/  /'
    if confirm "Re-import these docker volumes (existing volume contents are overwritten)?"; then
      for f in "$vol_stage"/*.tar.gz; do
        v="$(basename "$f" .tar.gz)"
        docker volume create "$v" >/dev/null
        docker run --rm -v "$v":/to -v "$vol_stage":/from alpine \
          sh -c "cd /to && tar -xzf /from/$(basename "$f")" \
          || warn "Volume import failed: $v"
        log "  imported volume $v"
      done
    fi
  else
    log "No named-volume exports in staging — skipping volume import."
  fi
}

restore_bring_up() {
  export_env_for_compose
  local -a order=(
    "ENABLE_ADGUARD_HOME|compose/networking/adguard-home.yml"
    "ENABLE_MARIADB|compose/automation/mariadb.yml"
    "ENABLE_MQTT|compose/automation/mqtt.yml"
    "ENABLE_ZIGBEE2MQTT|compose/automation/zigbee2mqtt.yml"
    "ENABLE_ZWAVE|compose/automation/zwave-js-ui.yml"
  )
  confirm "Bring services up in safe order (dns -> db -> mqtt -> radios -> apply)?" || { log "Skipping bring-up."; return 0; }
  local entry ev frag
  cd "$DOMUM_DIR"
  for entry in "${order[@]}"; do
    ev="${entry%%|*}"; frag="${entry##*|}"
    [[ "${!ev:-0}" == "1" && -f "$DOMUM_DIR/$frag" ]] || continue
    log "up: $frag"
    docker compose -f compose/base.yml -f "$frag" up -d || warn "compose up failed for $frag"
  done
  log "Converging the rest with apply..."
  apply || warn "apply reported errors — investigate with 'domum-core checkup'."
}

restore_load_mariadb() {
  [[ "${ENABLE_MARIADB:-0}" == "1" ]] || return 0
  local dump cn
  # shellcheck disable=SC2012
  dump="$(ls -1t "$STATE_ROOT/service-backups/mariadb"/mariadb-all-*.sql.gz 2>/dev/null | head -n1 || true)"
  if [[ -z "$dump" ]]; then
    warn "No MariaDB dump found in staging — HA recorder history not restored."
    return 0
  fi
  echo
  echo "MariaDB data is restored from the SQL dump (raw datadir is not in backups):"
  echo "  newest dump: $dump"
  echo "  manual form: gunzip -c $dump | docker exec -i <mariadb> sh -c 'mariadb -uroot -p\"\$MARIADB_ROOT_PASSWORD\"'"
  confirm "Load this dump into the running MariaDB now?" || { log "Skipped MariaDB load."; return 0; }
  cn="$(container_name_for mariadb)" || { warn "MariaDB container not running — load the dump manually later."; return 0; }
  gunzip -c "$dump" \
    | docker exec -i "$cn" sh -c 'exec mariadb -uroot -p"$MARIADB_ROOT_PASSWORD"' \
    || { warn "MariaDB load failed — run the manual form above."; return 1; }
  log "MariaDB dump loaded."
}

restore_reenable_timers() {
  local mf="$STATE_ROOT/service-backups/BACKUP-MANIFEST.json" t
  [[ -f "$mf" ]] || return 0
  local -a timers=()
  while IFS= read -r t; do timers+=("$t"); done < <(
    grep -oE '"enabled_timers": \[[^]]*\]' "$mf" 2>/dev/null \
      | grep -oE '[a-zA-Z0-9@._-]+\.timer'
  )
  (( ${#timers[@]} > 0 )) || return 0
  echo
  echo "The backup manifest recorded these enabled timers on the old host:"
  printf '  %s\n' "${timers[@]}"
  confirm "Install unit files and re-enable these timers?" || { log "Timers left disabled — enable later via 'schedule install-maintenance'."; return 0; }
  install_maintenance_unit_files
  for t in "${timers[@]}"; do
    if systemctl enable --now "$t" 2>/dev/null; then
      log "  enabled $t"
    else
      warn "  could not enable $t"
    fi
  done
}

restore_cmd() {
  need_root
  local pack="" key="" manual=0
  while (( $# > 0 )); do
    case "$1" in
      --pack)   pack="${2:-}"; shift 2 ;;
      --key)    key="${2:-}"; shift 2 ;;
      --manual) manual=1; shift ;;
      --yes)    ASSUME_YES=1; shift ;;
      *) die "Usage: domum-core restore [--pack <pack.tar.age> --key <age.key>] [--manual] [--yes]" ;;
    esac
  done

  if (( manual == 1 )); then
    restore_manual_intake
    return 0
  fi

  # Step 1 — credentials. Skippable when config + secrets already exist.
  if [[ -n "$pack" || -n "$key" ]]; then
    [[ -n "$pack" && -n "$key" ]] || die "--pack and --key go together."
    restore_pack_intake "$pack" "$key" || return 1
  elif [[ -f "$BACKUP_CFG_FILE" ]] && [[ -d "$SECRETS_DIR" ]] && find "$SECRETS_DIR" -type f -name 'restic_password_*' 2>/dev/null | grep -q .; then
    log "Config + restic secrets already present — skipping pack intake."
  else
    cat <<EOF
No credentials found. You need the recovery pack and your OFFLINE AGE key:
  sudo domum-core restore --pack /path/recovery-pack-*.tar.age --key /path/recovery-age.key
No pack at hand but a reachable restic repo + password? Last resort:
  sudo domum-core restore --manual
EOF
    return 1
  fi

  load_cfg
  ensure_state_dirs

  # Steps 2-3 — pick, restore to staging, confirm, move into place.
  restore_pick_target_snapshot
  restore_data_from_snapshot

  # Step 4 — volumes + networks.
  restore_reassemble

  # Step 5 — bring-up in safe order, then converge.
  restore_bring_up

  # Step 6 — recorder history.
  restore_load_mariadb

  # Step 7 — host finishers.
  restore_reenable_timers

  echo
  log "Restore flow complete. Final check:"
  checkup_cmd || true
  cat <<EOF

Reminders:
  - Staging kept at $RESTORE_STAGING; *.pre-restore-* siblings mark every
    overwritten file. Remove both manually once the system looks right.
  - Tailscale (if used) needs a fresh auth key — designed loss, ~2 minutes.
EOF
}

# ===========================================================================
#  Section: recovery pack (AGE-encrypted)
# ===========================================================================

recovery_pack_state_file() { printf '%s/last.env' "$RECOVERY_PACK_DEST"; }

recovery_pack_manifest() {
  local stage_dir="$1"
  local manifest="$stage_dir/MANIFEST.txt"
  : > "$manifest"
  find "$stage_dir" -type f ! -name MANIFEST.txt | sort | while IFS= read -r path; do
    printf '%s  %s\n' "$(sha256_of_file "$path")" "${path#"$stage_dir"/}" >> "$manifest"
  done
}

recovery_pack_restore_md() {
  local stage_dir="$1"
  cat > "$stage_dir/RESTORE.md" <<EOF
# domum-core recovery pack — restore notes

This encrypted archive contains everything needed to rebuild the server's
identity and configuration. Service *data* is restored separately from restic
(see docs/backups/disaster-recovery.md).

## Decrypt

    age -d -i /path/to/recovery-age.key recovery-pack-<ts>.tar.age | tar -xzf -

## Contents

- config/domum.conf            — host config (sanitized of cleartext secrets)
- config/domum-backup.conf     — backup target metadata
- secrets/                     — copies of $SECRETS_DIR/* (sensitive!)
- meta/git-revision.txt        — repo commit the server was running
- meta/rendered-compose.yml    — fully rendered compose manifest
- meta/service-inventory.txt   — enabled services + container image digests
- meta/backup-targets.txt      — restic repo URLs (NOT passwords)

## Rebuild order

1. Install OS + Docker, clone repo, run install.sh.
2. Restore secrets/* to $SECRETS_DIR (mode 0600, owner root).
3. Restore config/* to $DOMUM_DIR/config/.
4. Fill restic credentials, then: restic restore ... (per-target).
5. Restore Actual + Home Assistant per their restore-plan output.
6. Bring services up in safe order — see docs/backups/disaster-recovery.md.
7. Validate: sudo domum-core checkup
EOF
}

# send_email_with_attachment <file> <subject> <body-text> [dry]
# Low-level sender. Always sends what is already on disk (the caller is
# responsible for AGE-encrypting first — we never encrypt here, never email
# plaintext). Set dry=1 to validate config + show the plan without sending.
send_email_with_attachment() {
  local attach="$1" subject="$2" body="$3" dry="${4:-0}"
  local smtp_user smtp_pass from to message
  [[ -n "${RECOVERY_PACK_SMTP_HOST:-}" ]] || die "RECOVERY_PACK_SMTP_HOST required for email delivery (set provider/host)."
  from="${RECOVERY_PACK_EMAIL_FROM:-$DOMUM_EMAIL}"
  to="${RECOVERY_PACK_EMAIL_TO:-$DOMUM_EMAIL}"
  [[ -n "$from" && -n "$to" ]] || die "Recovery email From/To not set."
  # Gmail uses the From address as the SMTP username; a username file overrides.
  if [[ -f "$RECOVERY_PACK_SMTP_USERNAME_FILE" ]]; then
    smtp_user="$(read_secret_file_value "$RECOVERY_PACK_SMTP_USERNAME_FILE")"
  else
    smtp_user="$from"
  fi
  [[ -f "$RECOVERY_PACK_SMTP_PASSWORD_FILE" ]] || die "SMTP/app password file missing: $RECOVERY_PACK_SMTP_PASSWORD_FILE"
  [[ -f "$attach" ]] || die "Attachment not found: $attach"
  if (( dry == 1 )); then
    log "[dry-run] would email '$subject' with attachment $(basename "$attach")"
    log "[dry-run]   smtps://${RECOVERY_PACK_SMTP_HOST}:${RECOVERY_PACK_SMTP_PORT} as $smtp_user, $from -> $to"
    return 0
  fi
  smtp_pass="$(read_secret_file_value "$RECOVERY_PACK_SMTP_PASSWORD_FILE")"
  message="$(mktemp)"
  {
    printf 'From: %s\n' "$from"
    printf 'To: %s\n' "$to"
    printf 'Subject: %s\n' "$subject"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: multipart/mixed; boundary="domum-boundary"\n\n'
    printf -- '--domum-boundary\n'
    printf 'Content-Type: text/plain; charset="utf-8"\n\n'
    printf '%s\n\n' "$body"
    printf -- '--domum-boundary\n'
    printf 'Content-Type: application/octet-stream; name="%s"\n' "$(basename "$attach")"
    printf 'Content-Transfer-Encoding: base64\n'
    printf 'Content-Disposition: attachment; filename="%s"\n\n' "$(basename "$attach")"
    base64 < "$attach"
    printf '\n--domum-boundary--\n'
  } > "$message"
  curl --silent --show-error --ssl-reqd \
    --url "smtps://${RECOVERY_PACK_SMTP_HOST}:${RECOVERY_PACK_SMTP_PORT}" \
    --user "${smtp_user}:${smtp_pass}" \
    --mail-from "$from" \
    --mail-rcpt "$to" \
    --upload-file "$message"
  rm -f "$message"
}

send_recovery_pack_email() {
  local archive="$1" dry="${2:-0}"
  [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]] || return 0
  send_email_with_attachment "$archive" \
    "domum-core recovery pack $(basename "$archive")" \
    "Encrypted (AGE) recovery pack attached: $(basename "$archive")" "$dry"
}

# Email the most recent recovery pack on record.
recovery_pack_send_latest() {
  local dry="${1:-0}" state_file
  [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]] || die "Recovery email disabled (set ENABLE_RECOVERY_EMAIL=1)."
  state_file="$(recovery_pack_state_file)"
  [[ -f "$state_file" ]] || die "No recovery pack recorded — run: sudo domum-core recovery-pack create"
  unset ARCHIVE_PATH
  # shellcheck disable=SC1090
  source "$state_file"
  [[ -f "${ARCHIVE_PATH:-}" ]] || die "Recovery pack archive missing: ${ARCHIVE_PATH:-}"
  case "$ARCHIVE_PATH" in
    *.age) : ;;  # encrypted — safe to send
    *) die "Refusing to email a non-encrypted artifact: $ARCHIVE_PATH" ;;
  esac
  send_recovery_pack_email "$ARCHIVE_PATH" "$dry" \
    || die "Recovery-pack email failed."
  (( dry == 1 )) || log "Recovery pack emailed: $(basename "$ARCHIVE_PATH")"
}

# Send a tiny AGE-encrypted test attachment to validate SMTP end-to-end.
recovery_pack_email_test() {
  [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]] || die "Recovery email disabled (set ENABLE_RECOVERY_EMAIL=1)."
  [[ -f "$RECOVERY_PACK_AGE_PUBKEY_FILE" ]] || die "Missing AGE public key: $RECOVERY_PACK_AGE_PUBKEY_FILE"
  cmd_exists age || die "age not installed (apt-get install -y age)."
  local plain enc recipient
  recipient="$(awk '/age1/ {for(i=1;i<=NF;i++) if($i ~ /^age1/){print $i; exit}}' "$RECOVERY_PACK_AGE_PUBKEY_FILE")"
  [[ -n "$recipient" ]] || die "Could not parse age recipient from $RECOVERY_PACK_AGE_PUBKEY_FILE"
  plain="$(mktemp)"; enc="$(mktemp /tmp/domum-email-test.XXXXXX.age)"
  printf 'domum-core email test at %s\n' "$(date -Iseconds)" > "$plain"
  age -r "$recipient" -o "$enc" "$plain"
  rm -f "$plain"
  if send_email_with_attachment "$enc" \
    "domum-core recovery email test" \
    "If you can decrypt the attached .age file with your offline key, recovery email works." 0; then
    log "Test email sent to ${RECOVERY_PACK_EMAIL_TO:-$DOMUM_EMAIL}."
  else
    warn "Test email failed."
  fi
  rm -f "$enc"
}

recovery_pack_create() {
  [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" ]] || die "Recovery pack generation disabled (RECOVERY_PACK_ENABLED=0)."

  if [[ ! -f "$RECOVERY_PACK_AGE_PUBKEY_FILE" ]]; then
    cat >&2 <<EOF
ERROR: Missing recovery-pack age public key: $RECOVERY_PACK_AGE_PUBKEY_FILE

Generate an AGE keypair (keep the PRIVATE key offline, NOT on this Pi):

    age-keygen -o recovery-age.key            # do this on a trusted machine
    grep 'public key' recovery-age.key        # copy the age1... line
    # put ONLY the public key on the Pi:
    sudo install -m 0644 -o root recovery-age.pub $RECOVERY_PACK_AGE_PUBKEY_FILE

This tool will NEVER auto-generate or rotate keys.
EOF
    exit 1
  fi

  local no_email="${1:-0}"
  local stage_dir archive_plain archive_enc pubkey recipient ts sha size

  if (( DRY_RUN == 1 )); then
    echo "[dry-run] Would stage: config/domum.conf, config/domum-backup.conf,"
    echo "          secrets/* (small files), rendered compose, git revision,"
    echo "          service inventory + image digests, RESTORE.md, MANIFEST.txt"
    echo "[dry-run] Would encrypt with age -> $RECOVERY_PACK_DEST/recovery-pack-<ts>.tar.age"
    [[ "$no_email" == "0" && "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]] && echo "[dry-run] Would email the .age file."
    return 0
  fi

  if ! cmd_exists age; then
    log "age not found — installing via apt..."
    apt-get install -y --no-install-recommends age \
      || die "age is not installed and apt-get install age failed. Install: apt-get install -y age"
  fi

  stage_dir="$(mktemp -d)"
  ts="$(date +%Y%m%d-%H%M%S)"
  archive_plain="$(mktemp "/tmp/recovery-pack-${ts}.XXXXXX")"
  archive_enc="$RECOVERY_PACK_DEST/recovery-pack-${ts}.tar.age"
  pubkey="$(read_secret_file_value "$RECOVERY_PACK_AGE_PUBKEY_FILE")"
  recipient="$(printf '%s' "$pubkey" | awk '/age1/ {for(i=1;i<=NF;i++) if($i ~ /^age1/){print $i; exit}}')"
  [[ -n "$recipient" ]] || die "Could not parse age recipient from $RECOVERY_PACK_AGE_PUBKEY_FILE"

  mkdir -p "$stage_dir/config" "$stage_dir/secrets" "$stage_dir/meta"
  [[ -f "$CFG_FILE" ]] && install -m 0600 "$CFG_FILE" "$stage_dir/config/domum.conf"
  [[ -f "$BACKUP_CFG_FILE" ]] && install -m 0600 "$BACKUP_CFG_FILE" "$stage_dir/config/domum-backup.conf"

  # Copy only small secret files (avoid bundling large keyrings/blobs).
  find "$SECRETS_DIR" -maxdepth 2 -type f -size -64k 2>/dev/null | while IFS= read -r file; do
    local rel
    rel="${file#"$SECRETS_DIR"/}"
    install -D -m 0600 "$file" "$stage_dir/secrets/$rel"
  done

  git -C "$DOMUM_DIR" rev-parse HEAD > "$stage_dir/meta/git-revision.txt" 2>/dev/null || true
  export_env_for_compose
  compose_cmd config > "$stage_dir/meta/rendered-compose.yml" 2>/dev/null || true

  # Service inventory + last container image digests.
  {
    echo "# enabled services + running image digest"
    service_inventory_lines
  } > "$stage_dir/meta/service-inventory.txt"

  # Backup target URLs (NOT passwords).
  {
    echo "# restic repository URLs (passwords are NOT included)"
    grep -E '^BACKUP_TARGET_[A-Z]+_(REPOSITORY|ENABLED|TYPE)=' "$BACKUP_CFG_FILE" 2>/dev/null || true
  } > "$stage_dir/meta/backup-targets.txt"

  # Per-run backup manifest from the last `backups run` (task 33). The two
  # text files above are kept for one transition period; the manifest
  # supersedes both and will replace them.
  if [[ -f "$(backup_manifest_file)" ]]; then
    install -m 0600 "$(backup_manifest_file)" "$stage_dir/meta/BACKUP-MANIFEST.json"
  fi

  recovery_pack_restore_md "$stage_dir"
  recovery_pack_manifest "$stage_dir"

  tar -C "$stage_dir" -czf "$archive_plain" .
  age -r "$recipient" -o "$archive_enc" "$archive_plain"
  chmod 600 "$archive_enc"
  sha="$(sha256_of_file "$archive_enc")"
  size="$(file_size "$archive_enc")"
  write_env_kv "$(recovery_pack_state_file)" \
    ARCHIVE_PATH "$archive_enc" \
    SHA256 "$sha" \
    SIZE "$size" \
    TS "$(date +%s)"
  rm -rf "$stage_dir"
  rm -f "$archive_plain"

  if (( no_email == 0 )); then
    send_recovery_pack_email "$archive_enc" || warn "Recovery-pack email delivery failed."
  fi

  log "Recovery pack written to $archive_enc"
}

recovery_pack_status() {
  local state_file
  state_file="$(recovery_pack_state_file)"
  if [[ ! -f "$state_file" ]]; then
    echo "[domum-core] No recovery pack has been created yet."
    return 1
  fi
  unset ARCHIVE_PATH SHA256 SIZE TS
  # shellcheck disable=SC1090
  source "$state_file"
  echo "Recovery pack:"
  echo "  path:    ${ARCHIVE_PATH:-missing}"
  echo "  age:     $(human_age_from_epoch "${TS:-0}")"
  echo "  size:    ${SIZE:-0} bytes"
  echo "  sha256:  ${SHA256:-unknown}"
}

recovery_pack_inspect() {
  local state_file
  state_file="$(recovery_pack_state_file)"
  [[ -f "$state_file" ]] || die "No recovery pack recorded."
  unset ARCHIVE_PATH
  # shellcheck disable=SC1090
  source "$state_file"
  [[ -f "${ARCHIVE_PATH:-}" ]] || die "Recovery pack archive missing: ${ARCHIVE_PATH:-}"
  cat <<EOF
Recovery pack: $ARCHIVE_PATH

This archive is AGE-encrypted; its contents cannot be listed without the
private key. To inspect the manifest:

    age -d -i /path/to/recovery-age.key "$ARCHIVE_PATH" | tar -tzf -

The MANIFEST.txt inside lists every file with its SHA-256.
EOF
}

recovery_pack_cmd() {
  need_root
  load_cfg
  ensure_state_dirs
  local sub="${1:-create}"; shift || true
  case "$sub" in
    create)
      local no_email=0
      while (( $# )); do
        case "$1" in
          --no-email) no_email=1 ;;
          --dry-run) DRY_RUN=1 ;;
          *) die "Usage: domum-core recovery-pack create [--dry-run] [--no-email]" ;;
        esac
        shift
      done
      recovery_pack_create "$no_email"
      ;;
    status)  recovery_pack_status ;;
    inspect) recovery_pack_inspect ;;
    send-latest)
      local dry=0
      [[ "${1:-}" == "--dry-run" ]] && dry=1
      recovery_pack_send_latest "$dry"
      ;;
    email-test) recovery_pack_email_test ;;
    *) die "Usage: domum-core recovery-pack {create [--dry-run] [--no-email]|status|inspect|send-latest [--dry-run]|email-test}" ;;
  esac
}

# ===========================================================================
#  Section: cautious update model
# ===========================================================================

update_history_dir() { echo "$STATE_ROOT/update-history"; }
update_candidate_dir() { echo "$STATE_ROOT/update-candidates"; }

update_token_for() {
  case "$(normalize_service_name "$1")" in
    home-assistant) echo "HOMEASSISTANT" ;;
    actual-budget) echo "ACTUAL_BUDGET" ;;
    adguard-home) echo "ADGUARD" ;;
    zwave-js-ui) echo "ZWAVE" ;;
    musicassistant) echo "MUSICASSISTANT" ;;
    obsidian-sync) echo "OBSIDIAN_SYNC" ;;
    *) uppercase_token "$(normalize_service_name "$1")" ;;
  esac
}

protected_manual_update_service() {
  case "$(normalize_service_name "$1")" in
    home-assistant|mariadb|zigbee2mqtt|zwave-js-ui) return 0 ;;
    *) return 1 ;;
  esac
}

config_pinned_image_service() {
  case "$(normalize_service_name "$1")" in
    traefik|home-assistant|mariadb) return 0 ;;
    *) return 1 ;;
  esac
}

update_auto_enabled_for() {
  local key
  protected_manual_update_service "$1" && return 1
  key="$(update_token_for "$1")_AUTO_UPDATE"
  [[ "${!key:-0}" == "1" ]]
}

update_delay_days_for() {
  local key
  key="$(update_token_for "$1")_UPDATE_DELAY_DAYS"
  to_int "${!key:-7}" 7
}

service_requires_backup() {
  case "$(normalize_service_name "$1")" in
    home-assistant|mariadb|actual-budget|vaultwarden|obsidian-sync|zigbee2mqtt|zwave-js-ui|nodered|mqtt|adguard-home) return 0 ;;
    *) return 1 ;;
  esac
}

service_backup_dir_for() {
  case "$(normalize_service_name "$1")" in
    home-assistant) echo "$STATE_ROOT/service-backups/homeassistant" ;;
    mariadb) echo "$STATE_ROOT/service-backups/mariadb" ;;
    actual-budget) echo "$STATE_ROOT/service-backups/actual" ;;
    *) echo "$STATE_ROOT/service-backups/$(normalize_service_name "$1")" ;;
  esac
}

fresh_file_in_dir() {
  local dir="$1"
  [[ -d "$dir" ]] || return 1
  find "$dir" -type f -mmin -$(( BACKUP_MAX_AGE_HOURS * 60 )) 2>/dev/null | grep -q .
}

restic_backup_fresh() {
  # Aggregate heartbeat (any target succeeded); fall back to the newest
  # per-target file (last-success-<target>) if the aggregate is missing.
  local hb="$STATE_ROOT/backups/last-success" f
  if [[ ! -f "$hb" ]]; then
    for f in "$STATE_ROOT/backups"/last-success-*; do
      [[ -f "$f" ]] || continue
      [[ ! -f "$hb" || "$f" -nt "$hb" ]] && hb="$f"
    done
  fi
  [[ -f "$hb" ]] || return 1
  local age_h
  age_h=$(( ( $(date +%s) - $(stat -c %Y "$hb" 2>/dev/null || stat -f %m "$hb") ) / 3600 ))
  (( age_h <= BACKUP_MAX_AGE_HOURS ))
}

restic_targets_configured() {
  (( $(count_matches '^BACKUP_TARGET_[A-Z]+_ENABLED=1' "$BACKUP_CFG_FILE") > 0 ))
}

service_backup_fresh() {
  local svc="$1"
  fresh_file_in_dir "$(service_backup_dir_for "$svc")"
}

backup_gate_ok_for_service() {
  local svc="$1"
  service_requires_backup "$svc" || return 0
  service_backup_fresh "$svc" || return 1
  if restic_targets_configured; then
    restic_backup_fresh || return 1
  fi
  return 0
}

candidate_file_for() {
  echo "$(update_candidate_dir)/$(normalize_service_name "$1").env"
}

record_update_candidate() {
  local svc image_ref running_digest candidate_digest file now old_digest old_first_seen note=""
  svc="$(normalize_service_name "$1")"
  image_ref="$2"; running_digest="$3"; candidate_digest="$4"
  [[ -n "$candidate_digest" && "$candidate_digest" != "$running_digest" ]] || return 0
  file="$(candidate_file_for "$svc")"
  now="$(date +%s)"
  old_digest=""; old_first_seen=""
  if [[ -f "$file" ]]; then
    unset CANDIDATE_DIGEST FIRST_SEEN_TS
    # shellcheck disable=SC1090
    source "$file"
    old_digest="${CANDIDATE_DIGEST:-}"
    old_first_seen="${FIRST_SEEN_TS:-}"
  fi
  if [[ "$old_digest" == "$candidate_digest" && -n "$old_first_seen" ]]; then
    :
  else
    [[ -n "$old_digest" && "$old_digest" != "$candidate_digest" ]] && note="candidate changed; delay window reset"
    old_first_seen="$now"
    [[ -n "$note" ]] && warn "$svc: $note"
  fi
  write_env_kv "$file" \
    SERVICE "$svc" IMAGE_REF "$image_ref" \
    RUNNING_DIGEST "$running_digest" CANDIDATE_DIGEST "$candidate_digest" \
    CURRENT_DIGEST "$running_digest" FIRST_SEEN_TS "$old_first_seen" \
    LAST_SEEN_TS "$now" RESET_NOTE "$note"
}

clear_update_candidate() {
  rm -f "$(candidate_file_for "$1")"
}

digest_only() {
  local value="$1"
  case "$value" in
    *@sha256:*) printf '%s\n' "${value##*@}" ;;
    sha256:*) printf '%s\n' "$value" ;;
    *) return 1 ;;
  esac
}

running_repo_digest_for() {
  local cid="$1" image_id digest
  image_id="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
  [[ -n "$image_id" ]] || return 1
  while IFS= read -r digest; do
    digest="$(digest_only "$digest" 2>/dev/null || true)"
    [[ -n "$digest" ]] && { printf '%s\n' "$digest"; return 0; }
  done < <(docker image inspect "$image_id" --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null || true)
  return 1
}

local_repo_digest_for_ref() {
  local image_ref="$1" digest
  while IFS= read -r digest; do
    digest="$(digest_only "$digest" 2>/dev/null || true)"
    [[ -n "$digest" ]] && { printf '%s\n' "$digest"; return 0; }
  done < <(docker image inspect "$image_ref" --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null || true)
  return 1
}

registry_manifest_digest_for() {
  local image_ref="$1" digest
  digest="$(docker buildx imagetools inspect "$image_ref" --format '{{.Manifest.Digest}}' 2>/dev/null || true)"
  digest="$(digest_only "$digest" 2>/dev/null || true)"
  if [[ -n "$digest" ]]; then
    printf '%s\n' "$digest"
    return 0
  fi

  cmd_exists jq || return 1
  digest="$(docker manifest inspect --verbose "$image_ref" 2>/dev/null \
    | jq -r 'if type == "object" then (.Descriptor.digest // .Descriptor.Digest // empty) else empty end' 2>/dev/null \
    | head -n1)"
  digest="$(digest_only "$digest" 2>/dev/null || true)"
  [[ -n "$digest" ]] || return 1
  printf '%s\n' "$digest"
}

candidate_ready_for_apply() {
  local svc force file first_seen now age_days delay_days
  svc="$(normalize_service_name "$1")"
  force="${2:-0}"
  (( force == 1 )) && return 0
  file="$(candidate_file_for "$svc")"
  [[ -f "$file" ]] || return 1
  unset FIRST_SEEN_TS
  # shellcheck disable=SC1090
  source "$file"
  first_seen="$(to_int "${FIRST_SEEN_TS:-0}")"
  now="$(date +%s)"
  delay_days="$(update_delay_days_for "$svc")"
  age_days=$(( ( now - first_seen ) / 86400 ))
  (( age_days >= delay_days ))
}

candidate_status_for() {
  local svc="$1" file now first age_h delay_days ready auto backup_req candidate current first_iso last_iso
  file="$(candidate_file_for "$svc")"
  candidate="-"; current="-"; first_iso="-"; last_iso="-"; ready="no"
  if [[ -f "$file" ]]; then
    unset CANDIDATE_DIGEST CURRENT_DIGEST RUNNING_DIGEST FIRST_SEEN_TS LAST_SEEN_TS
    # shellcheck disable=SC1090
    source "$file"
    candidate="${CANDIDATE_DIGEST:-}"
    current="${CURRENT_DIGEST:-${RUNNING_DIGEST:-}}"
    first="$(to_int "${FIRST_SEEN_TS:-0}")"
    now="$(date +%s)"
    age_h=$(( ( now - first ) / 3600 ))
    delay_days="$(update_delay_days_for "$svc")"
    (( age_h >= delay_days * 24 )) && ready="yes"
    first_iso="$(epoch_to_iso "$first")"
    last_iso="$(epoch_to_iso "$(to_int "${LAST_SEEN_TS:-0}")")"
  fi
  auto="disabled"; update_auto_enabled_for "$svc" && auto="enabled"
  backup_req="no"; service_requires_backup "$svc" && backup_req="yes"
  printf '%-18s %-9s %-7s %-6s %-7s %-22s %-22s %-18s %s\n' \
    "$svc" "$auto" "${delay_days:-$(update_delay_days_for "$svc")}d" "$ready" "$backup_req" "$first_iso" "$last_iso" "${current:-"-"}" "${candidate:-"-"}"
}

updates_check() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  log "Checking enabled container images (registry manifest inspect; no pulls)..."
  printf '%-18s %-9s %-13s %-7s %s\n' "SERVICE" "UPDATE?" "AUTO" "DELAY" "IMAGE"
  local svc cid running_digest image_ref newest update auto
  while IFS= read -r svc; do
    svc="$(normalize_service_name "$svc")"
    cid="$(container_for "$svc" || true)"
    auto="disabled"; update_auto_enabled_for "$svc" && auto="enabled"
    if [[ -z "$cid" ]]; then
      printf '%-18s %-9s %-13s %-7s %s\n' "$svc" "n/a" "$auto" "$(update_delay_days_for "$svc")d" "(not running)"
      continue
    fi
    image_ref="$(docker inspect --format '{{index .Config.Image}}' "$cid" 2>/dev/null || true)"
    update="no"
    running_digest="$(running_repo_digest_for "$cid" || true)"
    if [[ -z "$image_ref" || -z "$running_digest" ]]; then
      update="?"
      clear_update_candidate "$svc"
    elif newest="$(registry_manifest_digest_for "$image_ref" || true)" && [[ -n "$newest" ]]; then
      if [[ "$newest" != "$running_digest" ]]; then
        update="YES"
        record_update_candidate "$svc" "$image_ref" "$running_digest" "$newest"
      else
        clear_update_candidate "$svc"
      fi
    else
      update="?"
    fi
    printf '%-18s %-9s %-13s %-7s %s\n' "$svc" "$update" "$auto" "$(update_delay_days_for "$svc")d" "$image_ref"
  done < <(enabled_services)

  echo
  echo "Next: sudo domum-core updates status"
  echo "Apply one app: sudo domum-core updates apply <app> [--dry-run] [--force]"
  echo "Auto-apply ready enabled apps: sudo domum-core updates apply-auto [--dry-run] [--force]"
}

updates_status() {
  load_cfg
  ensure_state_dirs
  printf '%-18s %-9s %-7s %-6s %-7s %-22s %-22s %-18s %s\n' \
    "SERVICE" "AUTO" "DELAY" "READY" "BACKUP" "FIRST_SEEN" "LAST_SEEN" "CURRENT" "CANDIDATE"
  local svc
  while IFS= read -r svc; do
    candidate_status_for "$(normalize_service_name "$svc")"
  done < <(enabled_services)
}

updates_candidates() {
  warn "'updates candidates' is deprecated; use 'updates status'."
  updates_status
}

record_update_history() {
  local svc="$1" from="$2" to="$3" result="$4" note="${5:-}"
  local ts stamp file
  svc="$(normalize_service_name "$svc")"
  ts="$(date +%s)"; stamp="$(date +%Y%m%d-%H%M%S)"
  file="$(update_history_dir)/${svc}-${stamp}.env"
  write_env_kv "$file" \
    SERVICE "$svc" FROM_IMAGE "$from" TO_IMAGE "$to" RESULT "$result" NOTE "$note" TS "$ts"
  echo "$(epoch_to_iso "$ts") $svc: $result ${note}" >> "$(update_history_dir)/history.log"
}

latest_success_history_file_for() {
  local svc="$1" f service result
  svc="$(normalize_service_name "$svc")"
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    unset SERVICE RESULT
    # shellcheck disable=SC1090
    source "$f"
    service="$(normalize_service_name "${SERVICE:-}")"
    result="${RESULT:-}"
    if [[ "$service" == "$svc" && "$result" == "success" ]]; then
      printf '%s\n' "$f"
      return 0
    fi
  done < <(find "$(update_history_dir)" -maxdepth 1 -name "${svc}-*.env" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
  return 1
}

rollback_protected_images() {
  local name _ev _cat _class _bvar _rel _probe file from result
  while IFS='|' read -r name _ev _cat _class _bvar _rel _probe; do
    file="$(latest_success_history_file_for "$name" || true)"
    [[ -n "$file" ]] || continue
    unset FROM_IMAGE RESULT
    # shellcheck disable=SC1090
    source "$file"
    from="${FROM_IMAGE:-}"
    result="${RESULT:-}"
    [[ "$result" == "success" && -n "$from" ]] || continue
    docker image inspect "$from" >/dev/null 2>&1 || continue
    printf '%s\n' "$from"
  done < <(service_catalog)
}

updates_apply_one() {
  local svc="$1" force="$2"
  svc="$(normalize_service_name "$svc")"
  local file cid before after cs image_ref running_digest candidate_digest pulled_digest
  file="$(candidate_file_for "$svc")"
  [[ -f "$file" ]] || { log "Skipping $svc: no candidate recorded. Run 'sudo domum-core updates check' first."; return 0; }
  if ! candidate_ready_for_apply "$svc" "$force"; then
    log "Skipping $svc: delay window has not elapsed."
    return 0
  fi
  unset IMAGE_REF RUNNING_DIGEST CURRENT_DIGEST CANDIDATE_DIGEST
  # shellcheck disable=SC1090
  source "$file"
  image_ref="${IMAGE_REF:-}"
  running_digest="${RUNNING_DIGEST:-${CURRENT_DIGEST:-}}"
  candidate_digest="${CANDIDATE_DIGEST:-}"
  [[ -n "$image_ref" && -n "$candidate_digest" ]] || { warn "Skipping $svc: candidate file is incomplete. Run 'sudo domum-core updates check' again."; return 0; }
  if service_requires_backup "$svc" && ! backup_gate_ok_for_service "$svc"; then
    if (( force == 0 )); then
      warn "Skipping $svc: fresh service backup is required, and restic freshness is also required when a restic target is enabled (<= ${BACKUP_MAX_AGE_HOURS}h). Run 'sudo domum-core backups run' or pass --force."
      return 0
    fi
    warn "FORCED UPDATE: $svc requires fresh backups, but the backup gate failed. Proceeding only because --force was provided."
  fi
  cs="$(compose_service_for "$svc")"
  cid="$(container_for "$svc" || true)"
  before="$([[ -n "$cid" ]] && docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || echo "")"
  log "Updating $svc..."
  run compose_cmd pull "$cs"
  if (( DRY_RUN == 0 )); then
    pulled_digest="$(local_repo_digest_for_ref "$image_ref" || true)"
    if [[ "$pulled_digest" != "$candidate_digest" ]]; then
      if (( force == 0 )); then
        warn "$svc: pulled digest does not match aged candidate; registry likely moved. Re-recording candidate and resetting the delay window."
        [[ -n "$pulled_digest" && -n "$running_digest" ]] && record_update_candidate "$svc" "$image_ref" "$running_digest" "$pulled_digest"
        return 0
      fi
      warn "FORCED UPDATE: $svc pulled digest does not match aged candidate. Proceeding only because --force was provided."
    fi
  fi
  run compose_cmd up -d "$cs"
  if (( DRY_RUN == 0 )); then
    cid="$(container_for "$svc" || true)"
    after="$([[ -n "$cid" ]] && docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || echo "")"
    record_update_history "$svc" "$before" "$after" success "compose pull + up"
    clear_update_candidate "$svc"
  fi
}

updates_apply() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  if [[ "${1:-}" == "--class" ]]; then
    local legacy_class="${2:-}"
    warn "'domum-core updates apply --class ${legacy_class}' is deprecated. Use app-by-app settings and 'updates apply-auto' or 'updates apply <app>'."
    shift 2 || true
    updates_apply_auto "$@"
    return
  fi

  local svc="${1:-}" force=0
  [[ -n "$svc" ]] || die "Usage: domum-core updates apply <app> [--dry-run] [--force]"
  shift || true
  while (( $# )); do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --force) force=1 ;;
      *) die "Usage: domum-core updates apply <app> [--dry-run] [--force]" ;;
    esac
    shift
  done
  updates_apply_one "$svc" "$force"
}

updates_apply_auto() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  local force=0 svc
  while (( $# )); do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --force) force=1 ;;
      *) die "Usage: domum-core updates apply-auto [--dry-run] [--force]" ;;
    esac
    shift
  done
  while IFS= read -r svc; do
    svc="$(normalize_service_name "$svc")"
    if ! update_auto_enabled_for "$svc"; then
      log "Skipping $svc: auto-update disabled."
      continue
    fi
    updates_apply_one "$svc" "$force"
  done < <(enabled_services)
}

updates_rollback() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  local svc="${1:-}" dry=0 file from image_ref cid cs before after
  [[ -n "$svc" ]] || die "Usage: domum-core updates rollback <app> [--dry-run]"
  svc="$(normalize_service_name "$svc")"
  shift || true
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1 ;;
      *) die "Usage: domum-core updates rollback <app> [--dry-run]" ;;
    esac
    shift
  done

  if config_pinned_image_service "$svc"; then
    warn "$svc uses a config-pinned image stream. Move the image pin in config/domum.conf and run 'sudo domum-core apply' instead of retag rollback."
    return 0
  fi

  file="$(latest_success_history_file_for "$svc" || true)"
  [[ -n "$file" ]] || { warn "No successful update history found for $svc."; return 0; }
  unset FROM_IMAGE TO_IMAGE RESULT
  # shellcheck disable=SC1090
  source "$file"
  from="${FROM_IMAGE:-}"
  [[ -n "$from" ]] || { warn "Latest successful update history for $svc has no FROM_IMAGE."; return 0; }
  docker image inspect "$from" >/dev/null 2>&1 || { warn "Rollback image for $svc is no longer local: $from"; return 0; }

  cid="$(container_for "$svc" || true)"
  [[ -n "$cid" ]] || { warn "Cannot resolve container for $svc; rollback needs the current service image reference."; return 0; }
  image_ref="$(docker inspect --format '{{index .Config.Image}}' "$cid" 2>/dev/null || true)"
  [[ -n "$image_ref" ]] || { warn "Cannot resolve image reference for $svc."; return 0; }

  cs="$(compose_service_for "$svc")"
  before="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || echo "")"
  log "Rolling back $svc to previous local image $from via $image_ref..."
  if (( dry == 1 )); then
    echo "[dry-run] docker tag $from $image_ref"
    echo "[dry-run] compose up -d $cs"
    return 0
  fi
  docker tag "$from" "$image_ref"
  compose_cmd up -d "$cs"
  cid="$(container_for "$svc" || true)"
  after="$([[ -n "$cid" ]] && docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || echo "")"
  record_update_history "$svc" "$before" "$after" rollback "retagged previous local image"
}

updates_history() {
  load_cfg
  local logf
  logf="$(update_history_dir)/history.log"
  if [[ -f "$logf" ]]; then
    cat "$logf"
  else
    echo "No update history yet."
  fi
}

updates_cmd() {
  need_root
  local sub="${1:-check}"; shift || true
  case "$sub" in
    check)      updates_check ;;
    status)     updates_status ;;
    candidates) updates_candidates ;;
    apply)      updates_apply "$@" ;;
    apply-auto) updates_apply_auto "$@" ;;
    rollback)   updates_rollback "$@" ;;
    history)    updates_history ;;
    *) die "Usage: domum-core updates {check|status|apply <app> [--dry-run] [--force]|apply-auto [--dry-run] [--force]|rollback <app> [--dry-run]|history}" ;;
  esac
}

# ===========================================================================
#  Section: OS security updates (Class D)
# ===========================================================================

os_updates_history_dir() { echo "$STATE_ROOT/update-history/os"; }

apt_security_upgrade_simulation() {
  apt-get -s upgrade 2>/dev/null | awk '/^Inst / && ($0 ~ /Debian-Security|security/)'
}

os_updates_check() {
  load_cfg
  ensure_state_dirs
  cmd_exists apt-get || die "apt-get not found."
  local sec gen
  sec="$(to_int "$(apt_security_upgrade_simulation | wc -l)")"
  gen="$(to_int "$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')")"
  echo "OS updates:"
  echo "  security: $sec"
  echo "  general:  $gen"
  [[ -f /var/run/reboot-required ]] && echo "  reboot:   required" || echo "  reboot:   not currently required"
}

os_updates_security_apply() {
  load_cfg
  ensure_state_dirs
  [[ "${ENABLE_SECURITY_PATCHES:-1}" == "1" ]] || die "Security patching disabled (ENABLE_SECURITY_PATCHES=0)."
  local dry=0
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1 ;;
      *) die "Usage: domum-core os-updates security-apply [--dry-run]" ;;
    esac
    shift
  done
  export DEBIAN_FRONTEND=noninteractive
  if (( dry == 1 )); then
    apt-get -s upgrade
    return 0
  fi
  apt-get update -y
  if ! cmd_exists unattended-upgrade; then
    apt-get install -y --no-install-recommends unattended-upgrades
  fi
  unattended-upgrade -d
  install -d -m 0750 "$(os_updates_history_dir)"
  printf '%s security-apply reboot_required=%s policy=%s\n' \
    "$(date -Iseconds)" \
    "$([[ -f /var/run/reboot-required ]] && echo 1 || echo 0)" \
    "${SECURITY_PATCH_REBOOT_POLICY:-manual}" \
    >> "$(os_updates_history_dir)/history.log"
  [[ -f /var/run/reboot-required ]] && warn "Reboot required; policy is manual, so no reboot was attempted."
}

os_updates_history() {
  local logf
  logf="$(os_updates_history_dir)/history.log"
  [[ -f "$logf" ]] && cat "$logf" || echo "No OS update history yet."
}

os_updates_cmd() {
  need_root
  local sub="${1:-check}"; shift || true
  case "$sub" in
    check) os_updates_check ;;
    security-apply) os_updates_security_apply "$@" ;;
    history) os_updates_history ;;
    *) die "Usage: domum-core os-updates {check|security-apply [--dry-run]|history}" ;;
  esac
}

# ===========================================================================
#  Section: cleanup
# ===========================================================================

images_in_use() {
  docker ps -aq 2>/dev/null | while IFS= read -r cid; do
    [[ -n "$cid" ]] && docker inspect --format '{{.Image}}' "$cid" 2>/dev/null
  done | sort -u
}

pruneable_dangling_images() {
  local inuse_tmp id
  inuse_tmp="$(mktemp)"
  { images_in_use; rollback_protected_images; } | sort -u > "$inuse_tmp"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    grep -Fxq "$id" "$inuse_tmp" && continue
    printf '%s\n' "$id"
  done < <(docker images --no-trunc --filter dangling=true -q 2>/dev/null | sort -u)
  rm -f "$inuse_tmp"
}

cleanup_images() {
  need_root
  load_cfg
  export_env_for_compose
  local dry=1
  while (( $# )); do
    case "$1" in
      --dry-run) dry=1 ;;
      --confirm) dry=0 ;;
      *) die "Usage: domum-core cleanup images [--dry-run|--confirm]" ;;
    esac
    shift
  done

  local -a candidates=()
  mapfile -t candidates < <(pruneable_dangling_images)

  if (( ${#candidates[@]} == 0 )); then
    log "No pruneable (dangling, unused) images found."
    return 0
  fi

  echo "Dangling images not referenced by any container:"
  local total=0 size display
  for id in "${candidates[@]}"; do
    size="$(docker image inspect "$id" --format '{{.Size}}' 2>/dev/null || echo 0)"
    total=$(( total + size ))
    display="${id#sha256:}"
    printf '  %.12s %s\n' "$display" "$(docker image inspect "$id" --format '{{.RepoTags}}' 2>/dev/null || echo '[]')"
  done
  printf 'Total: %d image(s), ~%d MiB\n' "${#candidates[@]}" "$(( total / 1024 / 1024 ))"

  if (( dry == 1 )); then
    echo "(dry-run — re-run with --confirm to delete)"
    return 0
  fi
  docker image rm "${candidates[@]}"
}

# ===========================================================================
#  Section: checkup / doctor
# ===========================================================================

CHECKUP_CRITICAL=(); CHECKUP_WARNINGS=(); CHECKUP_HEALTHY=(); CHECKUP_ACTIONS=()

checkup_add() {
  local level="$1"; shift
  local item="$*" existing
  case "$level" in
    critical) for existing in "${CHECKUP_CRITICAL[@]}"; do [[ "$existing" == "$item" ]] && return 0; done ;;
    warning)  for existing in "${CHECKUP_WARNINGS[@]}"; do [[ "$existing" == "$item" ]] && return 0; done ;;
    healthy)  for existing in "${CHECKUP_HEALTHY[@]}"; do [[ "$existing" == "$item" ]] && return 0; done ;;
    action)   for existing in "${CHECKUP_ACTIONS[@]}"; do [[ "$existing" == "$item" ]] && return 0; done ;;
  esac
  case "$level" in
    critical) CHECKUP_CRITICAL+=("$item") ;;
    warning)  CHECKUP_WARNINGS+=("$item") ;;
    healthy)  CHECKUP_HEALTHY+=("$item") ;;
    action)   CHECKUP_ACTIONS+=("$item") ;;
  esac
}

json_array_from_items() {
  if (( $# == 0 )); then printf '[]'
  elif cmd_exists jq; then printf '%s\n' "$@" | jq -R . | jq -s .
  else
    local out="[" first=1 item
    for item in "$@"; do
      item="${item//\\/\\\\}"; item="${item//\"/\\\"}"
      (( first == 0 )) && out+=","
      out+="\"$item\""; first=0
    done
    out+="]"; printf '%s' "$out"
  fi
}

pi_temp_check() {
  cmd_exists vcgencmd || return 0
  local temp throttled
  temp="$(vcgencmd measure_temp 2>/dev/null | grep -oE '[0-9.]+' | head -n1 || true)"
  if [[ -n "$temp" ]]; then
    local t_int="${temp%.*}"
    if (( t_int >= 80 )); then
      checkup_add warning "Pi temperature is ${temp}°C (>=80)."
    else
      checkup_add healthy "Pi temperature ${temp}°C."
    fi
  fi
  throttled="$(vcgencmd get_throttled 2>/dev/null | sed 's/throttled=//' || true)"
  if [[ -n "$throttled" && "$throttled" != "0x0" ]]; then
    checkup_add warning "Pi throttling flags set: $throttled (under-voltage / overheat history)."
  fi
}

image_created_epoch_for_container() {
  local cid="$1" image_id created
  image_id="$(docker inspect --format '{{.Image}}' "$cid" 2>/dev/null || true)"
  [[ -n "$image_id" ]] || return 1
  created="$(docker image inspect "$image_id" --format '{{.Created}}' 2>/dev/null || true)"
  [[ -n "$created" ]] || return 1
  date -d "$created" +%s 2>/dev/null
}

image_rot_check() {
  local now svc cid created age_days threshold created_iso
  now="$(date +%s)"
  while IFS= read -r svc; do
    svc="$(normalize_service_name "$svc")"
    cid="$(container_for "$svc" || true)"
    [[ -n "$cid" ]] || continue
    created="$(image_created_epoch_for_container "$cid" || true)"
    [[ -n "$created" ]] || continue
    age_days=$(( ( now - created ) / 86400 ))
    created_iso="$(epoch_to_iso "$created")"
    if update_auto_enabled_for "$svc"; then
      threshold="$(to_int "${UPDATE_ROT_AUTO_DAYS:-60}" 60)"
      if (( age_days > threshold )); then
        checkup_add warning "$svc image is ${age_days}d old (built $created_iso); auto-update path may be stuck — check updates status."
      fi
    else
      threshold="$(to_int "${UPDATE_ROT_MANUAL_DAYS:-270}" 270)"
      if (( age_days > threshold )); then
        checkup_add warning "$svc image is ${age_days}d old (built $created_iso); manual pin review due."
      fi
    fi
  done < <(enabled_services)
}

# tcp_probe <host> <port> — true if a TCP connection opens within ~2s.
tcp_probe() {
  local host="$1" port="$2"
  timeout 2 bash -c ": <> /dev/tcp/${host}/${port}" >/dev/null 2>&1
}

# mqtt_discovery_enabled — best-effort: HA default discovery is on unless the
# MQTT integration is explicitly configured with discovery: false.
mqtt_discovery_enabled() {
  local ha_cfg
  ha_cfg="$(ha_config_dir)/configuration.yaml"
  [[ -f "$ha_cfg" ]] || return 0
  ! grep -Eq '^\s*discovery:\s*false' "$ha_cfg"
}

# ha_dependency_check — validates Home Assistant and its automation dependency
# chain. Populates the shared checkup accumulators. Used by checkup and by the
# read-only `homeassistant audit`.
ha_dependency_check() {
  [[ "${ENABLE_HOME_ASSISTANT:-0}" == "1" ]] || return 0

  # Core: HA container. HTTP probing is opt-in because HA is usually routed
  # through Traefik and may not publish 8123 on localhost.
  if service_running home-assistant; then
    checkup_add healthy "Home Assistant container running."
  else
    checkup_add critical "Home Assistant is enabled but not running."
  fi
  if [[ "${HEALTHCHECK_HOMEASSISTANT_HTTP:-0}" == "1" ]]; then
    if [[ -n "${HOMEASSISTANT_HEALTH_URL:-}" ]] && cmd_exists curl; then
      if curl -fsS --max-time 5 "$HOMEASSISTANT_HEALTH_URL" >/dev/null 2>&1; then
        checkup_add healthy "Home Assistant HTTP health URL responding."
      else
        checkup_add warning "Home Assistant HTTP health URL not responding: $HOMEASSISTANT_HEALTH_URL"
      fi
    else
      checkup_add warning "Home Assistant HTTP health check is enabled but HOMEASSISTANT_HEALTH_URL is empty or curl is unavailable."
    fi
  fi

  # MQTT broker + discovery.
  if [[ "${ENABLE_MQTT:-0}" == "1" ]]; then
    if tcp_probe 127.0.0.1 1883; then checkup_add healthy "MQTT broker reachable (HA dependency)."
    else checkup_add critical "MQTT broker unreachable — HA discovery/devices will break."; fi
    if mqtt_discovery_enabled; then checkup_add healthy "MQTT discovery enabled."
    else checkup_add warning "MQTT discovery appears disabled in HA configuration.yaml."; fi
  fi

  # Automation integrations: container health gates HA functionality.
  local dep
  for dep in zigbee2mqtt:ENABLE_ZIGBEE2MQTT zwave-js-ui:ENABLE_ZWAVE \
             esphome:ENABLE_ESP_HOME nodered:ENABLE_NODERED; do
    local name="${dep%%:*}" ev="${dep##*:}"
    [[ "${!ev:-0}" == "1" ]] || continue
    if service_running "$name"; then checkup_add healthy "$name healthy (HA dependency)."
    else checkup_add critical "$name is enabled but not running (HA dependency)."; fi
  done

  # MariaDB + recorder.
  if [[ "${ENABLE_MARIADB:-0}" == "1" ]]; then
    if service_running mariadb; then checkup_add healthy "MariaDB running (HA recorder backend)."
    else checkup_add critical "MariaDB not running — HA recorder history unavailable."; fi
  fi

  # Music Assistant.
  if [[ "${ENABLE_MA:-0}" == "1" ]]; then
    if service_running musicassistant; then checkup_add healthy "Music Assistant running."
    else checkup_add warning "Music Assistant enabled but not running."; fi
  fi
}

# homeassistant_audit — READ-ONLY report of HA + its dependencies. Never starts,
# stops, or modifies anything.
homeassistant_audit() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs
  [[ "${ENABLE_HOME_ASSISTANT:-0}" == "1" ]] || die "Home Assistant is not enabled (ENABLE_HOME_ASSISTANT=0)."

  CHECKUP_CRITICAL=(); CHECKUP_WARNINGS=(); CHECKUP_HEALTHY=(); CHECKUP_ACTIONS=()
  ha_dependency_check

  echo "domum-core — Home Assistant audit (read-only)"
  echo
  echo "Automation dependencies (enabled):"
  local name enable_var _cat _class _bvar _rel _probe
  while IFS='|' read -r name enable_var _cat _class _bvar _rel _probe; do
    [[ "$_cat" == "automation" ]] || continue
    [[ "${!enable_var:-0}" == "1" ]] || continue
    if service_running "$name"; then
      printf '  [ok]   %s\n' "$name"
    else
      printf '  [DOWN] %s\n' "$name"
    fi
  done < <(service_catalog)

  echo
  echo "Missing / not-enabled automation integrations:"
  local any_missing=0
  while IFS='|' read -r name enable_var _cat _class _bvar _rel _probe; do
    [[ "$_cat" == "automation" ]] || continue
    [[ "${!enable_var:-0}" == "1" ]] && continue
    printf '  [off]  %s (%s=0)\n' "$name" "$enable_var"; any_missing=1
  done < <(service_catalog)
  (( any_missing == 1 )) || echo "  (none — all automation services enabled)"

  echo
  echo "Health findings:"
  (( ${#CHECKUP_CRITICAL[@]} )) && printf '  [!] %s\n' "${CHECKUP_CRITICAL[@]}"
  (( ${#CHECKUP_WARNINGS[@]} )) && printf '  [~] %s\n' "${CHECKUP_WARNINGS[@]}"
  (( ${#CHECKUP_HEALTHY[@]} ))  && printf '  [ok] %s\n' "${CHECKUP_HEALTHY[@]}"

  echo
  echo "Backup status (HA-critical):"
  local d
  for d in homeassistant mariadb; do
    if find "$STATE_ROOT/service-backups/$d" -type f 2>/dev/null | grep -q .; then
      local latest
      latest="$(find "$STATE_ROOT/service-backups/$d" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)"
      printf '  [ok]   %s — latest: %s\n' "$d" "${latest:-unknown}"
    else
      printf '  [none] %s — no service backup yet\n' "$d"
    fi
  done
  echo
  echo "(read-only — to act: sudo domum-core backups run / sudo domum-core checkup)"
  (( ${#CHECKUP_CRITICAL[@]} == 0 ))
}

run_checkup() {
  load_cfg
  export_env_for_compose
  ensure_state_dirs

  CHECKUP_CRITICAL=(); CHECKUP_WARNINGS=(); CHECKUP_HEALTHY=(); CHECKUP_ACTIONS=()

  # --- config sanity ---
  [[ -n "${DOMUM_DOMAIN:-}" ]] || checkup_add critical "DOMUM_DOMAIN is empty."

  # --- docker daemon ---
  if docker info >/dev/null 2>&1; then
    checkup_add healthy "Docker daemon is responsive."
  else
    checkup_add critical "Docker daemon is not responding."
  fi

  # --- networks ---
  local n
  for n in domum-proxy domum-internal domum-data; do
    if docker network inspect "$n" >/dev/null 2>&1; then
      checkup_add healthy "Network $n exists."
    else
      checkup_add warning "Network $n is missing (run: sudo domum-core apply)."
    fi
  done

  # --- services up vs expected + restart loops + health ---
  local svc cid
  while IFS= read -r svc; do
    cid="$(container_for "$svc" || true)"
    if [[ -z "$cid" ]]; then
      checkup_add warning "$svc is enabled but no container is running."
      continue
    fi
    local st rc health
    st="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || echo unknown)"
    rc="$(docker inspect --format '{{.RestartCount}}' "$cid" 2>/dev/null || echo 0)"
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$cid" 2>/dev/null || true)"
    if [[ "$st" != "running" ]]; then
      checkup_add critical "$svc container is $st."
    elif [[ "$health" == "unhealthy" ]]; then
      checkup_add critical "$svc is unhealthy."
    elif (( rc > 5 )); then
      checkup_add warning "$svc has restarted ${rc} times (possible restart loop)."
    else
      checkup_add healthy "$svc is running${health:+ ($health)}."
    fi
  done < <(enabled_services)

  # --- host device paths declared in compose ---
  local name enable_var _cat _class _bvar compose_rel _probe compose_file device_path
  while IFS='|' read -r name enable_var _cat _class _bvar compose_rel _probe; do
    [[ "${!enable_var:-0}" == "1" ]] || continue
    [[ "$compose_rel" == "-" || -z "$compose_rel" ]] && continue
    compose_file="$DOMUM_DIR/$compose_rel"
    [[ -f "$compose_file" ]] || continue
    while IFS= read -r device_path; do
      [[ -n "$device_path" ]] || continue
      if [[ -e "$device_path" ]]; then
        checkup_add healthy "$name USB/device path present: $device_path"
      else
        checkup_add critical "$name USB/device path missing: $device_path"
      fi
    done < <(compose_device_host_paths "$compose_file")
  done < <(service_catalog)

  if [[ "${ENABLE_ADGUARD_HOME:-0}" == "1" ]]; then
    local adguard_cid adguard_label_port
    adguard_cid="$(container_for adguard-home || true)"
    if [[ -n "$adguard_cid" ]]; then
      adguard_label_port="$(docker inspect --format '{{ index .Config.Labels "traefik.http.services.dns.loadbalancer.server.port" }}' "$adguard_cid" 2>/dev/null || true)"
      if [[ -n "$adguard_label_port" && "$adguard_label_port" != "$ADGUARD_WEB_PORT" ]]; then
        checkup_add warning "AdGuard web UI is configured on port $ADGUARD_WEB_PORT but Traefik points to $adguard_label_port."
        checkup_add action "sudo domum-core apply"
      fi
    fi
  fi

  # --- HTTP / port probes (best-effort and explicitly configured) ---
  if cmd_exists curl; then
    if [[ "${ENABLE_ACTUAL_BUDGET:-0}" == "1" && "${HEALTHCHECK_ACTUAL_HTTP:-0}" == "1" ]]; then
      if [[ -n "${ACTUAL_HEALTH_URL:-}" ]]; then
        if curl -fsS --max-time 5 "$ACTUAL_HEALTH_URL" >/dev/null 2>&1; then
          checkup_add healthy "Actual Budget HTTP health URL responding."
        else
          checkup_add warning "Actual Budget HTTP health URL not responding: $ACTUAL_HEALTH_URL"
        fi
      else
        checkup_add warning "Actual Budget HTTP health check is enabled but ACTUAL_HEALTH_URL is empty."
      fi
    fi
  fi
  if [[ "${ENABLE_MQTT:-0}" == "1" ]] && cmd_exists bash; then
    if tcp_probe 127.0.0.1 1883; then
      checkup_add healthy "MQTT port 1883 is listening."
    else
      checkup_add warning "MQTT port 1883 not reachable on localhost."
    fi
  fi

  # --- Home Assistant dependency chain (HA-first) ---
  ha_dependency_check

  # --- disk usage ---
  local path pcent
  for path in / /opt "$STATE_ROOT"; do
    [[ -e "$path" ]] || continue
    pcent="$(to_int "$(df -P "$path" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')")"
    if (( pcent >= 90 )); then
      checkup_add critical "$path is ${pcent}% full."
    elif (( pcent >= 80 )); then
      checkup_add warning "$path is ${pcent}% full."
    fi
  done

  # --- memory / load ---
  if [[ -r /proc/meminfo ]]; then
    local mt ma
    mt="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
    ma="$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
    if [[ -n "$mt" && -n "$ma" && "$mt" -gt 0 ]]; then
      local used_pct=$(( (mt - ma) * 100 / mt ))
      if (( used_pct >= 90 )); then
        checkup_add warning "Memory ${used_pct}% used."
      else
        checkup_add healthy "Memory ${used_pct}% used."
      fi
    fi
  fi

  # --- Pi temperature / throttling ---
  pi_temp_check

  # --- image age nags (no registry access, no pulls) ---
  image_rot_check

  # --- time sync ---
  if cmd_exists timedatectl; then
    if timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -qi yes; then
      checkup_add healthy "Time is NTP-synchronized."
    else
      checkup_add warning "Clock is not NTP-synchronized."
    fi
  fi

  # --- secrets dir perms ---
  if [[ -d "$SECRETS_DIR" ]]; then
    local mode owner
    mode="$(stat -c %a "$SECRETS_DIR" 2>/dev/null || echo '?')"
    owner="$(stat -c %U "$SECRETS_DIR" 2>/dev/null || echo '?')"
    [[ "$mode" == "700" ]] || checkup_add warning "$SECRETS_DIR mode is $mode (expected 700)."
    [[ "$owner" == "root" ]] || checkup_add warning "$SECRETS_DIR owner is $owner (expected root)."
  else
    checkup_add warning "$SECRETS_DIR does not exist."
  fi

  # --- backup targets configured ---
  local enabled_targets
  enabled_targets="$(count_matches '^BACKUP_TARGET_[A-Z]+_ENABLED=1' "$BACKUP_CFG_FILE")"
  if (( enabled_targets == 0 )); then
    checkup_add warning "No restic backup targets are enabled (see docs/backups/overview.md)."
    checkup_add action "Configure + enable a backup target in $BACKUP_CFG_FILE"
  else
    checkup_add healthy "${enabled_targets} restic backup target(s) enabled."
  fi

  # --- backup freshness ---
  local hb="$STATE_ROOT/backups/last-success"
  if [[ -f "$hb" ]]; then
    local age_h
    age_h=$(( ( $(date +%s) - $(stat -c %Y "$hb" 2>/dev/null || stat -f %m "$hb") ) / 3600 ))
    if (( age_h > BACKUP_MAX_AGE_HOURS )); then
      checkup_add critical "Last successful backup is ${age_h}h old (limit ${BACKUP_MAX_AGE_HOURS}h)."
    else
      checkup_add healthy "Last backup completed ${age_h}h ago."
    fi
    # Per-target freshness (files written per succeeded target): the
    # aggregate above stays the critical gate; a single stale destination
    # while another is fresh is a warning — data is protected somewhere,
    # but one destination needs attention.
    local tf tname tvar tage
    for tf in "$STATE_ROOT/backups"/last-success-*; do
      [[ -f "$tf" ]] || continue
      tname="${tf##*/last-success-}"
      tvar="BACKUP_TARGET_$(uppercase_token "$tname")_ENABLED"
      [[ "${!tvar:-0}" == "1" ]] || continue   # disabled/removed target: ignore stale file
      tage=$(( ( $(date +%s) - $(stat -c %Y "$tf" 2>/dev/null || stat -f %m "$tf") ) / 3600 ))
      if (( tage > BACKUP_MAX_AGE_HOURS )); then
        checkup_add warning "Backup target '$tname' is ${tage}h stale (limit ${BACKUP_MAX_AGE_HOURS}h) — check that destination."
      fi
    done
  else
    checkup_add warning "No successful restic backup recorded yet."
  fi

  # --- service-level backups present ---
  local sb
  for sb in actual:ENABLE_ACTUAL_BUDGET homeassistant:ENABLE_HOME_ASSISTANT mariadb:ENABLE_MARIADB; do
    local d="${sb%%:*}" ev="${sb##*:}"
    [[ "${!ev:-0}" == "1" ]] || continue
    if find "$STATE_ROOT/service-backups/$d" -type f 2>/dev/null | grep -q .; then
      checkup_add healthy "$d service backup present."
    else
      checkup_add warning "$d is enabled but has no service backup yet."
    fi
  done

  # --- recovery pack age ---
  if [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" ]]; then
    if recovery_pack_status >/dev/null 2>&1; then
      unset TS
      # shellcheck disable=SC1090
      source "$(recovery_pack_state_file)"
      if (( $(date +%s) - ${TS:-0} > RECOVERY_PACK_REMINDER_DAYS * 86400 )); then
        checkup_add warning "Recovery pack is older than ${RECOVERY_PACK_REMINDER_DAYS} days."
        checkup_add action "sudo domum-core recovery-pack create"
      else
        checkup_add healthy "Recovery pack age is within policy."
      fi
    else
      checkup_add warning "No recovery pack has been created."
      checkup_add action "Generate AGE keypair, then: sudo domum-core recovery-pack create"
    fi
  fi

  # --- age binary for recovery packs ---
  cmd_exists age || checkup_add warning "age binary missing — recovery-pack create will need it (apt-get install -y age)."

  # --- Tailscale (if enabled) ---
  if [[ "${ENABLE_TAILSCALE:-0}" == "1" ]]; then
    local tailscale_up_cmd="sudo tailscale up"
    [[ "${TAILSCALE_ACCEPT_DNS:-0}" == "1" ]] || tailscale_up_cmd+=" --accept-dns=false"
    [[ "${TAILSCALE_SSH:-0}" == "1" ]] || tailscale_up_cmd+=" --ssh=false"
    if ! cmd_exists tailscale; then
      checkup_add warning "Tailscale is enabled but the host tailscale CLI is missing."
      checkup_add action "sudo domum-core init"
    elif cmd_exists systemctl && ! systemctl is-active --quiet tailscaled; then
      checkup_add warning "Tailscale is enabled but tailscaled is not active."
      checkup_add action "sudo systemctl enable --now tailscaled"
    elif tailscale status >/dev/null 2>&1; then
      checkup_add healthy "Tailscale is up."
    else
      checkup_add warning "Tailscale is enabled but not connected."
      checkup_add action "$tailscale_up_cmd"
    fi
  fi

  # --- dangling images ---
  local dangling
  dangling="$(to_int "$(pruneable_dangling_images | wc -l)")"
  (( dangling > 0 )) && { checkup_add warning "${dangling} dangling Docker images can be pruned."; checkup_add action "sudo domum-core cleanup images --dry-run"; }

  # --- pending apt updates ---
  if cmd_exists apt-get; then
    local sec gen
    sec="$(to_int "$(apt-get -s upgrade 2>/dev/null | grep '^Inst ' | grep -ci security)")"
    gen="$(to_int "$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')")"
    (( sec > 0 )) && checkup_add warning "${sec} security update(s) available."
    (( gen > 0 )) && checkup_add warning "${gen} package update(s) available."
  fi
  [[ -f /var/run/reboot-required ]] && checkup_add warning "Reboot required by a package update."

  # --- ACTION: image update reminder ---
  checkup_add action "Review image updates: sudo domum-core updates check"
}

print_checkup() {
  local json="$1"
  if (( json == 1 )); then
    printf '{\n'
    printf '  "critical": %s,\n' "$(json_array_from_items "${CHECKUP_CRITICAL[@]}")"
    printf '  "warnings": %s,\n' "$(json_array_from_items "${CHECKUP_WARNINGS[@]}")"
    printf '  "healthy": %s,\n' "$(json_array_from_items "${CHECKUP_HEALTHY[@]}")"
    printf '  "suggested_actions": %s\n' "$(json_array_from_items "${CHECKUP_ACTIONS[@]}")"
    printf '}\n'
    return
  fi
  echo "domum-core checkup"
  echo
  echo "Critical:"
  (( ${#CHECKUP_CRITICAL[@]} == 0 )) && echo "  [ok] none" || printf '  [!] %s\n' "${CHECKUP_CRITICAL[@]}"
  echo
  echo "Warnings:"
  (( ${#CHECKUP_WARNINGS[@]} == 0 )) && echo "  [ok] none" || printf '  [~] %s\n' "${CHECKUP_WARNINGS[@]}"
  echo
  echo "Healthy:"
  (( ${#CHECKUP_HEALTHY[@]} == 0 )) && echo "  (none recorded)" || printf '  [ok] %s\n' "${CHECKUP_HEALTHY[@]}"
  echo
  echo "Suggested actions:"
  if (( ${#CHECKUP_ACTIONS[@]} == 0 )); then
    echo "  1. No immediate action required."
  else
    local i=1 action
    for action in "${CHECKUP_ACTIONS[@]}"; do
      printf '  %d. %s\n' "$i" "$action"; i=$(( i + 1 ))
    done
  fi
}

checkup_cmd() {
  need_root
  local json=0 quiet=0
  while (( $# )); do
    case "$1" in
      --json) json=1 ;;
      --quiet) quiet=1 ;;
      *) die "Usage: domum-core checkup [--json|--quiet]" ;;
    esac
    shift
  done
  run_checkup
  if (( quiet == 1 )); then
    (( ${#CHECKUP_CRITICAL[@]} == 0 )) || printf '%s\n' "${CHECKUP_CRITICAL[@]}"
  else
    print_checkup "$json"
  fi
  (( ${#CHECKUP_CRITICAL[@]} == 0 ))
}

doctor_cmd() {
  need_root
  run_checkup
  print_checkup 0
  echo
  echo "=== deeper diagnostics ==="

  echo "-- compose config validity --"
  if compose_cmd config >/dev/null 2>&1; then
    echo "  compose config: valid"
  else
    echo "  compose config: INVALID — run 'sudo domum-core apply' output to debug"
  fi

  echo "-- enabled services / containers --"
  local svc cid
  while IFS= read -r svc; do
    cid="$(container_for "$svc" || true)"
    printf '  %-16s %s\n' "$svc" "${cid:-(not running)}"
  done < <(enabled_services)

  echo "-- disk SMART (if available) --"
  if cmd_exists smartctl; then
    local dev
    for dev in /dev/sd? /dev/nvme?n? /dev/mmcblk?; do
      [[ -e "$dev" ]] || continue
      printf '  %s: %s\n' "$dev" "$(smartctl -H "$dev" 2>/dev/null | grep -i 'overall-health' | sed 's/.*: //' || echo 'n/a')"
    done
  else
    echo "  smartctl not installed (apt-get install -y smartmontools)"
  fi

  echo "-- required binaries --"
  local b
  for b in docker restic age curl jq; do
    cmd_exists "$b" && echo "  $b: $(command -v "$b")" || echo "  $b: MISSING"
  done

  (( ${#CHECKUP_CRITICAL[@]} == 0 ))
}

# ===========================================================================
#  Section: configure wizard
# ===========================================================================

# set_conf_key <file> <KEY> <value> — comment-preserving in-place upsert. If KEY
# already has the requested active/commented value, it is left untouched;
# otherwise the first existing definition is replaced or a quoted value is added.
set_conf_key() {
  local file="$1" key="$2" val="$3" tmp current_line current_val
  install -d -m 0750 "$(dirname "$file")"
  [[ -f "$file" ]] || : > "$file"

  current_line="$(grep -m1 -E "^[[:space:]]*${key}=" "$file" || true)"
  [[ -n "$current_line" ]] || current_line="$(grep -m1 -E "^[#[:space:]]*${key}=" "$file" || true)"
  if [[ -n "$current_line" ]]; then
    current_val="${current_line#*=}"
    current_val="${current_val#\"}"; current_val="${current_val%\"}"
    current_val="${current_val#\'}"; current_val="${current_val%\'}"
    [[ "$current_val" == "$val" ]] && return 0
  fi

  tmp="$(mktemp)"
  if grep -qE "^[#[:space:]]*${key}=" "$file"; then
    # Replace the first (active or commented) definition; awk avoids sed quoting pain.
    awk -v k="$key" -v v="$val" '
      !done && $0 ~ "^[#[:space:]]*"k"=" { print k"=\""v"\""; done=1; next }
      { print }
    ' "$file" > "$tmp"
  else
    cat "$file" > "$tmp"
    printf '%s="%s"\n' "$key" "$val" >> "$tmp"
  fi
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

# redact <key> <value> — blank out secret-ish values for display.
redact() {
  case "$1" in
    *PASSWORD*|*TOKEN*|*SECRET*|*AGEKEY*|*KEY_FILE*) echo "******" ;;
    *) echo "$2" ;;
  esac
}

require_configure_tty() {
  [[ -t 0 ]] || die "configure wizard needs an interactive terminal"
}

# ask <prompt> <current> — read a value, defaulting to current on empty input.
ask() {
  local prompt="$1" current="$2" reply
  require_configure_tty
  read -r -p "$prompt [$current]: " reply
  printf '%s' "${reply:-$current}"
}

ask_bool() {
  local prompt="$1" current="$2" reply
  require_configure_tty
  read -r -p "$prompt (1/0) [$current]: " reply
  reply="${reply:-$current}"
  [[ "$reply" == "1" ]] && echo 1 || echo 0
}

configure_show() {
  load_cfg
  echo "domum-core effective configuration (secrets redacted)"
  echo "  config: $CFG_FILE"
  echo "  overlay: $BACKUP_CFG_FILE"
  echo
  local k
  for k in DOMUM_DOMAIN DOMUM_EMAIL DOMUM_LAN_IP DOMUM_TS_IP \
           ADGUARD_WEB_PORT TAILSCALE_ACCEPT_DNS TAILSCALE_SSH \
           ENABLE_HOME_ASSISTANT ENABLE_MQTT ENABLE_ZIGBEE2MQTT ENABLE_ZWAVE \
           ENABLE_ESP_HOME ENABLE_NODERED ENABLE_MA ENABLE_MARIADB \
           ENABLE_ADGUARD_HOME ENABLE_ACTUAL_BUDGET ENABLE_VAULTWARDEN \
           ENABLE_OBSIDIAN_SYNC ENABLE_TAILSCALE \
           BACKUP_MAX_AGE_HOURS RECOVERY_PACK_ENABLED RECOVERY_PACK_EMAIL_ENABLED \
           RECOVERY_PACK_SMTP_HOST RECOVERY_PACK_SMTP_PASSWORD_FILE \
           HEALTHCHECK_HOMEASSISTANT_HTTP HOMEASSISTANT_HEALTH_URL \
           HEALTHCHECK_ACTUAL_HTTP ACTUAL_HEALTH_URL \
           ENABLE_SECURITY_PATCHES SECURITY_PATCH_REBOOT_POLICY \
           ENABLE_AUTOREMOVE_OLD_KERNELS; do
    printf '  %-32s %s\n' "$k" "$(redact "$k" "${!k:-}")"
  done
  echo
  echo "Per-app update policy:"
  local svc token auto_key delay_key
  while IFS= read -r svc; do
    token="$(update_token_for "$svc")"
    auto_key="${token}_AUTO_UPDATE"
    delay_key="${token}_UPDATE_DELAY_DAYS"
    printf '  %-18s auto=%s delay_days=%s backup_required=%s\n' \
      "$svc" "${!auto_key:-0}" "${!delay_key:-7}" "$(service_requires_backup "$svc" && echo yes || echo no)"
  done < <(enabled_services)
}

configure_validate() {
  load_cfg
  local issues=0
  [[ -n "${DOMUM_DOMAIN:-}" ]] || { echo "[!] DOMUM_DOMAIN is empty"; issues=1; }
  [[ -n "${DOMUM_EMAIL:-}" ]]  || { echo "[!] DOMUM_EMAIL is empty"; issues=1; }
  if [[ "${RECOVERY_PACK_ENABLED:-1}" == "1" && ! -f "$RECOVERY_PACK_AGE_PUBKEY_FILE" ]]; then
    echo "[~] AGE public key missing: $RECOVERY_PACK_AGE_PUBKEY_FILE (recovery-pack create will fail)"
  fi
  if [[ "${RECOVERY_PACK_EMAIL_ENABLED:-0}" == "1" ]]; then
    [[ -n "${RECOVERY_PACK_SMTP_HOST:-}" ]] || { echo "[!] recovery email on but SMTP host unset"; issues=1; }
    [[ -f "$RECOVERY_PACK_SMTP_PASSWORD_FILE" ]] || { echo "[!] recovery email on but password file missing: $RECOVERY_PACK_SMTP_PASSWORD_FILE"; issues=1; }
  fi
  validate_obsidian_credentials || issues=1
  validate_mqtt_auth || issues=1
  local -a backup_targets=()
  read -r -a backup_targets <<< "${BACKUP_TARGETS:-}"
  local target token enabled_var enabled repo_var repo pw_var pw_file
  local key_var key_file known_hosts_var known_hosts_file port_var port
  local enabled_target_count=0
  for target in "${backup_targets[@]}"; do
    [[ -n "$target" ]] || continue
    token="$(uppercase_token "$target")"
    enabled_var="BACKUP_TARGET_${token}_ENABLED"
    enabled="${!enabled_var:-0}"
    [[ "$enabled" =~ ^[01]$ ]] || { echo "[!] $enabled_var must be 0 or 1"; issues=1; }
    [[ "$enabled" == "1" ]] || continue
    enabled_target_count=$(( enabled_target_count + 1 ))

    repo_var="BACKUP_TARGET_${token}_REPOSITORY"
    repo="${!repo_var:-}"
    if [[ -z "$repo" ]]; then
      echo "[!] $target backup target is enabled but $repo_var is empty"
      issues=1
    elif [[ "$repo" == *XXXXXX* || "$repo" == *your-bucket* ]]; then
      echo "[!] $repo_var still contains a placeholder value: $repo"
      issues=1
    fi

    pw_var="BACKUP_TARGET_${token}_PASSWORD_FILE"
    pw_file="${!pw_var:-$SECRETS_DIR/restic_password_$target}"
    if [[ -z "$pw_file" ]]; then
      echo "[!] $target backup target is enabled but $pw_var is empty"
      issues=1
    elif [[ ! -f "$pw_file" ]]; then
      echo "[!] $target backup target password file missing: $pw_file"
      issues=1
    fi

    if [[ "$repo" == sftp:* ]]; then
      [[ "$repo" == sftp:*@*:* ]] || { echo "[!] $repo_var is not a valid SFTP repo string: $repo"; issues=1; }
      if [[ "$token" == "HETZNER" && "$repo" == sftp:*@*.your-storagebox.de:/* ]]; then
        echo "[!] Hetzner Storage Box restic path must be relative: use sftp:uXXXXXX@uXXXXXX.your-storagebox.de:domum-core-restic"
        issues=1
      fi
      key_var="BACKUP_TARGET_${token}_SFTP_KEY_FILE"
      key_file="${!key_var:-}"
      if [[ -z "$key_file" ]]; then
        echo "[!] SFTP target '$target' is missing $key_var"
        issues=1
      elif [[ ! -f "$key_file" ]]; then
        echo "[!] SFTP key file missing for target '$target': $key_file"
        issues=1
      fi

      known_hosts_var="BACKUP_TARGET_${token}_SFTP_KNOWN_HOSTS_FILE"
      known_hosts_file="${!known_hosts_var:-}"
      if [[ -z "$known_hosts_file" ]]; then
        echo "[~] SFTP target '$target' has no pinned known-hosts file configured."
      elif [[ ! -f "$known_hosts_file" ]]; then
        echo "[!] SFTP known-hosts file missing for target '$target': $known_hosts_file"
        issues=1
      fi

      port_var="BACKUP_TARGET_${token}_SFTP_PORT"
      port="${!port_var:-}"
      if [[ "$token" == "HETZNER" && "$port" != "23" ]]; then
        echo "[!] Hetzner Storage Box target must use $port_var=23"
        issues=1
      fi
    fi
  done
  if (( enabled_target_count == 0 )); then
    echo "[~] No restic backup targets are enabled in $BACKUP_CFG_FILE"
  fi
  local svc token auto_key delay_key delay
  while IFS= read -r svc; do
    token="$(update_token_for "$svc")"
    auto_key="${token}_AUTO_UPDATE"
    delay_key="${token}_UPDATE_DELAY_DAYS"
    [[ "${!auto_key:-0}" =~ ^[01]$ ]] || { echo "[!] $auto_key must be 0 or 1"; issues=1; }
    delay="${!delay_key:-7}"
    [[ "$delay" =~ ^[0-9]+$ ]] || { echo "[!] $delay_key must be a non-negative integer"; issues=1; }
  done < <(enabled_services)
  if (( issues == 0 )); then echo "[ok] configuration looks valid."; fi
  return "$issues"
}

configure_backup_current() {
  load_cfg
  local dest ts
  ts="$(date +%Y%m%d-%H%M%S)"
  dest="$STATE_ROOT/config-backups/$ts"
  install -d -m 0750 "$dest"
  [[ -f "$CFG_FILE" ]] && install -m 0600 "$CFG_FILE" "$dest/"
  [[ -f "$BACKUP_CFG_FILE" ]] && install -m 0600 "$BACKUP_CFG_FILE" "$dest/"
  CONFIG_BACKUP_DEST="$dest"
  log "Current config backed up to $dest"
}

configure_print_diff() {
  local backup_dir="$1" diff_file changed=0
  diff_file="$(mktemp)"

  local file old label
  for file in "$CFG_FILE" "$BACKUP_CFG_FILE"; do
    old="$backup_dir/$(basename "$file")"
    label="$(basename "$file")"
    if [[ -f "$old" && -f "$file" ]]; then
      if ! diff -u --label "before/$label" --label "after/$label" "$old" "$file" >> "$diff_file"; then
        changed=1
      fi
    elif [[ -f "$old" || -f "$file" ]]; then
      {
        printf 'Only one copy exists for %s\n' "$label"
        printf '  before: %s\n' "$old"
        printf '  after:  %s\n' "$file"
      } >> "$diff_file"
      changed=1
    fi
  done

  echo
  echo "-- Config diff from pre-run backup --"
  if (( changed == 0 )); then
    echo "  No changes."
  else
    awk 'NR <= 200 { print } NR == 201 { print "... diff truncated after 200 lines ..."; exit }' "$diff_file"
  fi
  rm -f "$diff_file"
}

configure_write_defaults() {
  if [[ ! -f "$CFG_FILE" ]]; then
    [[ -f "${CFG_FILE}.example" ]] || die "Missing ${CFG_FILE}.example"
    install -m 0640 "${CFG_FILE}.example" "$CFG_FILE"
    log "Wrote default config to $CFG_FILE from example."
  else
    warn "$CFG_FILE exists; not overwriting."
  fi
  [[ -f "$BACKUP_CFG_FILE" ]] && { warn "$BACKUP_CFG_FILE exists; not overwriting."; return 0; }
  [[ -f "${BACKUP_CFG_FILE}.example" ]] || die "Missing ${BACKUP_CFG_FILE}.example"
  install -m 0640 "${BACKUP_CFG_FILE}.example" "$BACKUP_CFG_FILE"
  log "Wrote default overlay to $BACKUP_CFG_FILE from example."
}

configure_wizard() {
  require_configure_tty
  load_cfg
  configure_backup_current
  local backup_dir="$CONFIG_BACKUP_DEST"
  echo "=== domum-core configure ==="
  echo "Press Enter to keep the current value shown in [brackets]."
  echo

  echo "-- Identity --"
  set_conf_key "$CFG_FILE" DOMUM_DOMAIN "$(ask 'Base domain' "${DOMUM_DOMAIN:-}")"
  set_conf_key "$CFG_FILE" DOMUM_EMAIL  "$(ask 'ACME / contact email' "${DOMUM_EMAIL:-}")"
  set_conf_key "$CFG_FILE" DOMUM_LAN_IP "$(ask 'LAN IP' "${DOMUM_LAN_IP:-}")"
  set_conf_key "$CFG_FILE" DOMUM_TS_IP  "$(ask 'Tailscale IP' "${DOMUM_TS_IP:-}")"
  set_conf_key "$CFG_FILE" ENABLE_TAILSCALE "$(ask_bool 'Host Tailscale remote access' "${ENABLE_TAILSCALE:-0}")"
  set_conf_key "$CFG_FILE" TAILSCALE_ACCEPT_DNS "$(ask_bool '  allow Tailscale to manage host DNS' "${TAILSCALE_ACCEPT_DNS:-0}")"
  set_conf_key "$CFG_FILE" TAILSCALE_SSH "$(ask_bool '  allow Tailscale SSH' "${TAILSCALE_SSH:-0}")"

  echo "-- Services (1=on 0=off) --"
  local name enable_var _rest
  while IFS='|' read -r -u3 name enable_var _rest; do
    set_conf_key "$CFG_FILE" "$enable_var" "$(ask_bool "  $name" "${!enable_var:-0}")"
  done 3< <(service_catalog)

  echo "-- Backup --"
  set_conf_key "$CFG_FILE" BACKUP_MAX_AGE_HOURS "$(ask 'Backup freshness gate (hours)' "${BACKUP_MAX_AGE_HOURS:-48}")"
  echo "  (Restic targets + Hetzner live in $BACKUP_CFG_FILE — edit there; see docs.)"

  echo "-- Recovery --"
  set_conf_key "$CFG_FILE" RECOVERY_PACK_ENABLED "$(ask_bool '  recovery pack generation' "${RECOVERY_PACK_ENABLED:-1}")"
  local em; em="$(ask_bool '  email recovery pack' "${RECOVERY_PACK_EMAIL_ENABLED:-0}")"
  set_conf_key "$BACKUP_CFG_FILE" ENABLE_RECOVERY_EMAIL "$em"
  if [[ "$em" == "1" ]]; then
    set_conf_key "$BACKUP_CFG_FILE" RECOVERY_EMAIL_TO   "$(ask '  recovery email to' "${RECOVERY_PACK_EMAIL_TO:-}")"
    set_conf_key "$BACKUP_CFG_FILE" RECOVERY_EMAIL_FROM "$(ask '  recovery email from (Gmail address)' "${RECOVERY_PACK_EMAIL_FROM:-}")"
    echo "  NOTE: store the Gmail app password at the GMAIL_APP_PASSWORD_FILE path (0600, root)."
  fi

  echo "-- Updates (per app) --"
  local svc token auto_key delay_key
  while IFS= read -r -u3 svc; do
    token="$(update_token_for "$svc")"
    auto_key="${token}_AUTO_UPDATE"
    delay_key="${token}_UPDATE_DELAY_DAYS"
    echo "  $(service_display_name "$svc"):"
    set_conf_key "$CFG_FILE" "$auto_key" "$(ask_bool '    Auto-update' "${!auto_key:-0}")"
    set_conf_key "$CFG_FILE" "$delay_key" "$(ask '    Delay days' "${!delay_key:-7}")"
  done 3< <(enabled_services)

  echo "-- Health Checks --"
  set_conf_key "$CFG_FILE" HEALTHCHECK_HOMEASSISTANT_HTTP "$(ask_bool '  Home Assistant HTTP URL check' "${HEALTHCHECK_HOMEASSISTANT_HTTP:-0}")"
  set_conf_key "$CFG_FILE" HOMEASSISTANT_HEALTH_URL "$(ask '  Home Assistant health URL' "${HOMEASSISTANT_HEALTH_URL:-}")"
  set_conf_key "$CFG_FILE" HEALTHCHECK_ACTUAL_HTTP "$(ask_bool '  Actual Budget HTTP URL check' "${HEALTHCHECK_ACTUAL_HTTP:-0}")"
  set_conf_key "$CFG_FILE" ACTUAL_HEALTH_URL "$(ask '  Actual Budget health URL' "${ACTUAL_HEALTH_URL:-}")"

  echo "-- Timers --"
  set_conf_key "$CFG_FILE" ENABLE_SECURITY_PATCHES "$(ask_bool '  OS security patches' "${ENABLE_SECURITY_PATCHES:-1}")"
  set_conf_key "$CFG_FILE" ENABLE_AUTOREMOVE_OLD_KERNELS "$(ask_bool '  autoremove old kernels' "${ENABLE_AUTOREMOVE_OLD_KERNELS:-0}")"

  echo
  configure_print_diff "$backup_dir"
  echo
  log "Configuration written. Validate with: sudo domum-core configure --validate"
  log "Apply changes with: sudo domum-core apply"
}

configure_cmd() {
  need_root
  case "${1:-}" in
    ""|wizard)        configure_wizard ;;
    --show)           configure_show ;;
    --validate)       configure_validate ;;
    --write-defaults) configure_write_defaults ;;
    --backup-current) configure_backup_current ;;
    *) die "Usage: domum-core configure [--show|--validate|--write-defaults|--backup-current]" ;;
  esac
}

# ===========================================================================
#  Section: schedule maintenance timers
# ===========================================================================

schedule_remove() {
  need_root
  systemctl disable --now domum-night-up.timer domum-night-down.timer || true
  rm -f /etc/systemd/system/domum-night-up.timer /etc/systemd/system/domum-night-down.timer
  rm -f /etc/systemd/system/domum-night-up.service /etc/systemd/system/domum-night-down.service
  rm -f /usr/local/bin/domum-night-profile
  systemctl daemon-reload
  log "Legacy night-profile scheduling removed."
}

# Copy repo unit files into /etc/systemd/system and daemon-reload.
# Copies only — never enables or disables anything. Shared by
# `schedule install-maintenance` and the drift refresh in repo_update().
install_maintenance_unit_files() {
  [[ -d "$DOMUM_DIR/systemd" ]] || die "Missing $DOMUM_DIR/systemd"
  local f
  for f in "$DOMUM_DIR"/systemd/domum-core-*.service "$DOMUM_DIR"/systemd/domum-core-*.timer; do
    [[ -f "$f" ]] || continue
    install -m 0644 "$f" "/etc/systemd/system/$(basename "$f")"
    echo "  installed $(basename "$f")"
  done
  systemctl daemon-reload
}

schedule_install_maintenance() {
  need_root
  load_cfg
  ensure_state_dirs

  log "Installing maintenance unit/timer files (NOT enabling them)..."
  install_maintenance_unit_files

  cat <<EOF

Units installed but DISABLED. Enable the ones you want with:

  sudo systemctl enable --now domum-core-checkup.timer
  sudo systemctl enable --now domum-core-backups.timer
  sudo systemctl enable --now domum-core-recovery-pack.timer
  sudo systemctl enable --now domum-core-recovery-email.timer
  sudo systemctl enable --now domum-core-updates-check.timer
  sudo systemctl enable --now domum-core-updates-apply.timer
  sudo systemctl enable --now domum-core-security-patches.timer
  sudo systemctl enable --now domum-core-backup-verify.timer
  sudo systemctl enable --now domum-core-cleanup-report.timer

Review timing first: systemctl cat domum-core-backups.timer
EOF
}

schedule_cmd() {
  case "${1:-}" in
    remove)                shift; schedule_remove "$@" ;;
    install-maintenance)   shift; schedule_install_maintenance "$@" ;;
    *) die "Usage: domum-core schedule {install-maintenance|remove}" ;;
  esac
}

# ===========================================================================
#  Section: MQTT auth bootstrap
# ===========================================================================

mqtt_init_auth() {
  need_root
  load_cfg
  install -d -m 0700 "$SECRETS_DIR"

  local password z2m_secret
  if [[ -f "$MQTT_PASSWORD_FILE" ]]; then
    password="$(<"$MQTT_PASSWORD_FILE")"
    [[ -n "$password" ]] || die "MQTT password file is empty: $MQTT_PASSWORD_FILE"
    log "MQTT password already exists: $MQTT_PASSWORD_FILE"
  else
    password="$(random_password)"
    install -m 0600 /dev/null "$MQTT_PASSWORD_FILE"
    printf '%s\n' "$password" > "$MQTT_PASSWORD_FILE"
    log "Created MQTT password: $MQTT_PASSWORD_FILE"
  fi

  if [[ -f "$MOSQUITTO_PASSWD_FILE" ]] && grep -q "^${MQTT_USER}:" "$MOSQUITTO_PASSWD_FILE"; then
    log "Mosquitto password file already has account: $MQTT_USER"
  else
    cmd_exists docker || die "docker is required to generate $MOSQUITTO_PASSWD_FILE"
    local -a pass_args=(-b)
    [[ -f "$MOSQUITTO_PASSWD_FILE" ]] || pass_args=(-c -b)
    docker run --rm -u root -v "$SECRETS_DIR:/secrets" docker.io/library/eclipse-mosquitto:2 \
      mosquitto_passwd "${pass_args[@]}" "/secrets/$(basename "$MOSQUITTO_PASSWD_FILE")" "$MQTT_USER" "$password"
    log "Updated Mosquitto password file: $MOSQUITTO_PASSWD_FILE"
  fi
  chmod 0600 "$MOSQUITTO_PASSWD_FILE"
  install_mosquitto_runtime_passwd
  log "Updated Mosquitto runtime password file: $MOSQUITTO_RUNTIME_PASSWD_FILE"

  if [[ "${ENABLE_ZIGBEE2MQTT:-0}" == "1" ]]; then
    z2m_secret="$DOMUM_DIR/compose/automation/zigbee2mqtt/secret.yaml"
    install -d -m 0750 "$(dirname "$z2m_secret")"
    [[ -f "$z2m_secret" ]] || install -m 0600 /dev/null "$z2m_secret"
    if [[ ! -f "$z2m_secret.pre-mqtt-init" ]]; then
      install -m 0600 "$z2m_secret" "$z2m_secret.pre-mqtt-init"
    fi
    z2m_restore_network_key_from_backup "$z2m_secret"
    yaml_set_simple_secret "$z2m_secret" mqtt_user "$MQTT_USER"
    yaml_set_simple_secret "$z2m_secret" mqtt_pass "$password"
    log "Zigbee2MQTT MQTT secrets are present: $z2m_secret"
  fi

  log "MQTT auth bootstrap complete. Use username '$MQTT_USER' and the password in $MQTT_PASSWORD_FILE for Home Assistant."
}

mqtt_cmd() {
  case "${1:-}" in
    init-auth) shift; mqtt_init_auth "$@" ;;
    *) die "Usage: domum-core mqtt init-auth" ;;
  esac
}

# ===========================================================================
#  dispatch
# ===========================================================================

usage() {
  cat <<EOF
domum-core — home-automation server management CLI

Deployment:
  domum-core init
  domum-core configure [--show|--validate|--write-defaults|--backup-current]
  domum-core mqtt init-auth              create missing MQTT auth secrets
  domum-core apply
  domum-core update                       git pull (warns on local drift)
  domum-core status [--counts]
  domum-core schedule remove              remove legacy night-profile timers
  domum-core schedule install-maintenance maintenance timers (install only)

Health:
  domum-core checkup [--json|--quiet]
  domum-core doctor

Home Assistant:
  domum-core homeassistant audit          read-only HA dependency report
  domum-core homeassistant backup [--dry-run] | restore-plan

Backups (unified — driven by BACKUP_<SERVICE> flags):
  domum-core backups run [--dry-run]
  domum-core backups verify | snapshots | history | prune [--dry-run]
  domum-core backups init <target>        e.g. init hetzner
  domum-core actual backup [--dry-run] | restore-plan

Recovery & updates:
  domum-core restore [--pack <p> --key <k>] [--manual] [--yes]
                                          guided disaster-recovery wizard
  domum-core recovery-pack create [--dry-run] [--no-email] | status | inspect
  domum-core recovery-pack send-latest [--dry-run] | email-test
  domum-core updates check | status | apply <app> [--dry-run] [--force]
  domum-core updates apply-auto [--dry-run] [--force] | rollback <app> [--dry-run] | history
  domum-core os-updates check | security-apply [--dry-run] | history

Maintenance:
  domum-core cleanup images [--dry-run]

Config: $CFG_FILE  (+ $BACKUP_CFG_FILE)
State:  $STATE_ROOT   Logs: $LOG_DIR
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    init)     init_host "$@" ;;
    configure) configure_cmd "$@" ;;
    mqtt)     mqtt_cmd "$@" ;;
    apply)    apply "$@" ;;
    update)   repo_update "$@" ;;
    status)   status "$@" ;;
    checkup)  checkup_cmd "$@" ;;
    doctor)   doctor_cmd "$@" ;;
    schedule) schedule_cmd "$@" ;;
    backups)  backups_cmd "$@" ;;
    restore)  restore_cmd "$@" ;;
    actual)
      need_root
      case "${1:-}" in
        backup) shift; [[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1; actual_backup ;;
        restore-plan) actual_restore_plan ;;
        *) die "Usage: domum-core actual {backup [--dry-run]|restore-plan}" ;;
      esac
      ;;
    homeassistant|ha)
      need_root
      case "${1:-}" in
        backup) shift; [[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1; homeassistant_backup ;;
        restore-plan) homeassistant_restore_plan ;;
        audit) homeassistant_audit ;;
        *) die "Usage: domum-core homeassistant {backup [--dry-run]|restore-plan|audit}" ;;
      esac
      ;;
    recovery-pack) recovery_pack_cmd "$@" ;;
    updates)  updates_cmd "$@" ;;
    os-updates) os_updates_cmd "$@" ;;
    cleanup)
      case "${1:-}" in
        images) shift; cleanup_images "$@" ;;
        *) die "Usage: domum-core cleanup images [--dry-run]" ;;
      esac
      ;;
    ""|-h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
