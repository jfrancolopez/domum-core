#!/usr/bin/env bash
# Back-compat shim. The CLI was consolidated into `domum-core`.
# This keeps `domum ...` working for existing muscle memory and scripts.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x /usr/local/bin/domum-core ]]; then
  exec /usr/local/bin/domum-core "$@"
elif [[ -x "$here/domum-core" ]]; then
  exec "$here/domum-core" "$@"
else
  echo "ERROR: domum-core not found. Re-run install.sh." >&2
  exit 1
fi
