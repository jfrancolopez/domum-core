[Unit]
Description=domum-core: unified service + restic backup
Documentation=file:///opt/domum-core/docs/SETUP-BACKUPS.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/bin/domum-core

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/local/bin/domum-core backups run
TimeoutStartSec=6h
