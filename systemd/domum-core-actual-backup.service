[Unit]
Description=domum-core: daily Actual Budget backup
Documentation=file:///opt/domum-core/docs/CLI-CHEATSHEET.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/bin/domum-core

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/local/bin/domum-core actual backup
TimeoutStartSec=6h
