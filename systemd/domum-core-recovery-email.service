[Unit]
Description=domum-core: email latest encrypted recovery pack
Documentation=file:///opt/domum-core/docs/backups/gmail-recovery.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/bin/domum-core

[Service]
Type=oneshot
Nice=10
ExecStart=/usr/local/bin/domum-core recovery-pack send-latest
TimeoutStartSec=10m
