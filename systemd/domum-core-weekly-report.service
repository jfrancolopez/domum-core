[Unit]
Description=domum-core: weekly health report
Documentation=file:///opt/domum-core/docs/operations/weekly-report.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/bin/domum-core

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/local/bin/domum-core report weekly
TimeoutStartSec=6h
