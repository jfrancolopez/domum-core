[Unit]
Description=domum-core: weekly AGE recovery pack
Documentation=file:///opt/domum-core/docs/operations/cli-cheatsheet.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/usr/local/bin/domum-core

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/local/bin/domum-core recovery-pack create --no-email
TimeoutStartSec=6h
