# Optional Homepage-only variables.
#
# Copy to config/homepage.env on the Pi and fill only the values you need.
# config/*.env is ignored by git, so secrets stay local.

# Google Calendar private iCal URL from Google Calendar settings.
# HOMEPAGE_VAR_GOOGLE_CALENDAR_ICAL_URL="https://calendar.google.com/calendar/ical/.../basic.ics"

# Beszel Homepage widget. Beszel currently requires a superuser for API access.
# HOMEPAGE_VAR_BESZEL_USERNAME="admin@example.com"
# HOMEPAGE_VAR_BESZEL_PASSWORD="change-me"
# HOMEPAGE_VAR_BESZEL_PI_SYSTEM_ID="domum-core"
# HOMEPAGE_VAR_BESZEL_MEDIA_SYSTEM_ID="domum-core-media"
# HOMEPAGE_VAR_BESZEL_UNRAID_SYSTEM_ID="unraid"

# UniFi local read-only account or API key.
# HOMEPAGE_VAR_UNIFI_URL="https://unifi"
# HOMEPAGE_VAR_UNIFI_SITE="default"
# HOMEPAGE_VAR_UNIFI_USERNAME="homepage-readonly"
# HOMEPAGE_VAR_UNIFI_PASSWORD="change-me"
# HOMEPAGE_VAR_UNIFI_KEY=""

# AdGuard Home web UI account.
# HOMEPAGE_VAR_ADGUARD_USERNAME="admin"
# HOMEPAGE_VAR_ADGUARD_PASSWORD="change-me"

# Traefik dashboard basic-auth account, if required for the widget path.
# HOMEPAGE_VAR_TRAEFIK_USERNAME="admin"
# HOMEPAGE_VAR_TRAEFIK_PASSWORD="change-me"

# Healthchecks read-only API key.
# HOMEPAGE_VAR_HEALTHCHECKS_KEY=""

# Speedtest Tracker read-only API token with the results:read ability.
# HOMEPAGE_VAR_SPEEDTEST_TRACKER_KEY=""

# Home Assistant long-lived access token for entity metrics.
# HOMEPAGE_VAR_HOMEASSISTANT_KEY=""

# Media API tokens.
# HOMEPAGE_VAR_PLEX_URL="http://plex.example.lan:32400"
# HOMEPAGE_VAR_PLEX_TOKEN=""
# HOMEPAGE_VAR_JELLYFIN_URL="http://jellyfin.example.lan:8096"
# HOMEPAGE_VAR_JELLYFIN_KEY=""
# HOMEPAGE_VAR_IMMICH_URL="http://immich.example.lan:2283"
# HOMEPAGE_VAR_IMMICH_KEY=""

# Optional direct Unraid widget. Beszel is preferred for normal host summaries.
# HOMEPAGE_VAR_UNRAID_URL="https://unraid.example.lan"
# HOMEPAGE_VAR_UNRAID_KEY=""
