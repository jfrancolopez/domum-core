# Speedtest Tracker read-only token with results:read only.
GLANCE_SPEEDTEST_TRACKER_TOKEN=

# AdGuard Home web account for aggregate dns-stats only.
GLANCE_ADGUARD_USERNAME=
GLANCE_ADGUARD_PASSWORD=

# UniFi direct API access for task 73. Use a dedicated read-only API key for
# monitoring only. Do not reuse Homepage credentials or an admin key.
#
# Set GLANCE_UNIFI_URL to the UCG Fiber gateway/controller URL that Glance can
# reach from the container network. Example on the Pi: https://<unifi-gateway-ip>
#
# Leave GLANCE_UNIFI_API_PATH unset until the live controller endpoint/schema is
# verified. Once verified, it should be the single aggregate health/counts path
# Glance may call; do not use paths that return clients, topology, SSIDs, MACs,
# or raw device details.
GLANCE_UNIFI_URL=
GLANCE_UNIFI_API_KEY=
GLANCE_UNIFI_API_HEADER=X-API-Key
GLANCE_UNIFI_API_PATH=
