# Optional Glance widget secrets.
#
# Copy this file to /etc/domum-core/secrets/glance.env on the Pi, set owner
# root:root and mode 0600, then fill only the integrations you actually enable.
# Never put real values in git. Glance loads this env file for dashboard widgets;
# unused variables are harmless.

# Network page: Speedtest Tracker latest-result widget.
# Create a Speedtest Tracker API token from the Speedtest Tracker web UI with the
# narrowest available read-only/results scope. It should only need results:read.
GLANCE_SPEEDTEST_TRACKER_TOKEN=

# Network page: AdGuard aggregate dns-stats widget.
# Create a Glance-specific AdGuard Home web user if practical. If AdGuard does
# not support a narrower role in your version, use an operator-approved web
# account only for aggregate dashboard stats. The page hides top domains and does
# not render raw DNS queries, clients, or domain lists.
GLANCE_ADGUARD_USERNAME=
GLANCE_ADGUARD_PASSWORD=

# Network page future source: UniFi aggregate health/counts.
# Not consumed until task 73 verifies the live controller endpoint/schema.
#
# In UniFi Network, create a dedicated API key/user for Glance with read-only
# monitoring access. Do not reuse Homepage credentials, your personal account, or
# an admin key. Set GLANCE_UNIFI_URL to the UCG Fiber gateway/controller URL that
# the Glance container can reach, for example https://<unifi-gateway-ip>.
#
# Set GLANCE_UNIFI_API_URL to the full aggregate health endpoint for the selected
# site, including https://. Keep GLANCE_UNIFI_URL and GLANCE_UNIFI_API_PATH as
# setup notes/helpers if useful, but the Glance widget consumes
# GLANCE_UNIFI_API_URL because Glance does not concatenate adjacent environment
# variables inside one URL value.
#
# Example path: /proxy/network/api/s/<site-internal-reference>/stat/health
# The endpoint must return subsystem health/counts only and must not return
# clients, topology, SSIDs, MAC addresses, IP addresses, or raw device details.
GLANCE_UNIFI_URL=
GLANCE_UNIFI_API_URL=
GLANCE_UNIFI_API_KEY=
GLANCE_UNIFI_API_HEADER=X-API-Key
GLANCE_UNIFI_API_PATH=

# Hosting page future source: Healthchecks summary.
# Not consumed yet. Create a Healthchecks read-only API key from the Healthchecks
# Project Settings page. Do not use ping URLs or keys that expose ping UUIDs.
GLANCE_HEALTHCHECKS_URL=https://healthchecks.${DOMUM_DOMAIN}
GLANCE_HEALTHCHECKS_API_KEY=

# Home page future source: private calendar events and presence.
# Not consumed yet. These values are reserved for a future local Home adapter
# that converts private ICS/Home Assistant data into a small sanitized JSON
# summary for Glance.
#
# Calendar: prefer a read-only secret iCal/ICS URL for a dedicated shared
# calendar. Do not commit personal calendar URLs; rotate the URL if it is ever
# printed in logs or screenshots. The future adapter should render only bounded
# upcoming title/time summaries approved for the family dashboard.
GLANCE_CALENDAR_ICS_URL=
GLANCE_CALENDAR_LOOKAHEAD_DAYS=7
GLANCE_CALENDAR_MAX_EVENTS=6

# Presence: create a Glance-specific Home Assistant long-lived access token from
# the Home Assistant user profile. The future adapter should call only the State
# API for explicitly allowlisted person.* entities and render display names from
# this env file, not from Home Assistant device/entity names.
GLANCE_HOMEASSISTANT_URL=http://homeassistant:8123
GLANCE_HOMEASSISTANT_TOKEN=
GLANCE_PRESENCE_PERSON_1_NAME=
GLANCE_PRESENCE_PERSON_1_ENTITY=person.example
GLANCE_PRESENCE_PERSON_2_NAME=
GLANCE_PRESENCE_PERSON_2_ENTITY=
GLANCE_PRESENCE_PERSON_3_NAME=
GLANCE_PRESENCE_PERSON_3_ENTITY=
GLANCE_PRESENCE_PERSON_4_NAME=
GLANCE_PRESENCE_PERSON_4_ENTITY=

# Media page future source: Plex/Tautulli now-playing and history.
# Not consumed yet. Prefer Tautulli for dashboard summaries if available; it
# avoids putting Plex tokens directly into Glance templates. Generate the
# Tautulli API key from Tautulli Settings -> Web Interface/API.
GLANCE_TAUTULLI_URL=
GLANCE_TAUTULLI_API_KEY=
GLANCE_PLEX_URL=
GLANCE_PLEX_TOKEN=

# Games page future source: Steam profile/sales widgets.
# Not consumed yet. Get a Steam Web API key from
# https://steamcommunity.com/dev/apikey and use the numeric SteamID64 for the
# profile. The profile must be public for recently-played/history widgets.
GLANCE_STEAM_API_KEY=
GLANCE_STEAM_ID64=
GLANCE_STEAM_COUNTRY=US

# Games/Social future source: Twitch creator/category widgets.
# Not consumed yet. Register a Twitch developer app at
# https://dev.twitch.tv/console/apps and use app client credentials only; do not
# use a personal OAuth token for public creator/category summaries.
GLANCE_TWITCH_CLIENT_ID=
GLANCE_TWITCH_CLIENT_SECRET=

# Music/learning future source: Spotify listening insights.
# Not consumed yet. Create a Spotify app at
# https://developer.spotify.com/dashboard and use OAuth scopes only after a task
# approves them. Likely read scopes are user-read-recently-played,
# user-top-read, playlist-read-private, and user-follow-read. Store refresh tokens
# only in /etc/domum-core/secrets, never in git or screenshots.
GLANCE_SPOTIFY_CLIENT_ID=
GLANCE_SPOTIFY_CLIENT_SECRET=
GLANCE_SPOTIFY_REFRESH_TOKEN=

# Video/learning future source: personalized YouTube follow/watch insights.
# Not consumed yet. Create a Google Cloud OAuth client and enable the YouTube Data
# API v3 only after a task approves scopes. Prefer subscription/channel metadata
# first; watch history may require broader Google Takeout or account access and
# must be reviewed separately.
GLANCE_YOUTUBE_CLIENT_ID=
GLANCE_YOUTUBE_CLIENT_SECRET=
GLANCE_YOUTUBE_REFRESH_TOKEN=
GLANCE_YOUTUBE_API_KEY=

# Optional public API rate-limit relief for releases/repository widgets.
# Not consumed yet. If GitHub unauthenticated rate limits become a problem, use a
# fine-grained token with public repository metadata read-only access only.
GLANCE_GITHUB_TOKEN=
