# domum-core backup / recovery configuration (overlay for domum.conf)
#
# Copy to config/domum-backup.conf (init does this for you) and edit. The CLI
# sources this with bash, so keep it shell-clean (no spaces around `=`).
#
# Never commit the live config/domum-backup.conf — only this .example.
#
# EVERYTHING here ships DISABLED by default. No backup runs, no email is sent,
# and no timer errors on a fresh install until you fill in real values and set
# the relevant *_ENABLED=1.

# ============================================================
# SECTION: restic retention (applied on every prune)
# ============================================================
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=3

# Heartbeat URL (e.g. Uptime Kuma push). Optional; blank to skip.
BACKUP_HEARTBEAT_URL=''

# Max age (hours) before checkup flags backups as stale / updates refuse.
BACKUP_MAX_AGE_HOURS=48

# ============================================================
# SECTION: backup source set
# ============================================================
# These usually need no editing — the defaults in bin/domum-core-backup store
# each byte once: the compose tree (contains every service bind mount) +
# config, plus the only staging artifacts restic cannot reproduce from raw
# files (MariaDB SQL dumps, quiesced Actual/Vaultwarden SQLite archives,
# named-volume exports) and the recovery packs. The other gzipped service tars
# stay local-only (opaque to restic dedup).
# Uncomment to override.
#
# BACKUP_PATHS="/opt/domum-core/compose /opt/domum-core/config /var/lib/domum-core/service-backups/actual /var/lib/domum-core/service-backups/mariadb /var/lib/domum-core/service-backups/vaultwarden /var/lib/domum-core/service-backups/volumes /var/lib/domum-core/service-backups/BACKUP-MANIFEST.json /var/lib/domum-core/recovery-pack"
#
# Named docker volumes exported (tar) into staging so they ride along.
# BACKUP_VOLUMES="nodered-data uptime-kuma-data traefik-letsencrypt"
#
# Excludes (large / disposable; raw hot InnoDB — the SQL dump is authoritative).
# BACKUP_EXCLUDES="/opt/domum-core/compose/automation/mariadb/data */tts/* *.db-wal *.db-shm"
#
# Everything runs daily at 02:30 (RPO 24h, accepted in the DR runbook). If a
# tighter RPO for Actual/HA is ever wanted, the right knob is a second small
# timer running `domum-core actual backup` + `homeassistant backup` (staging
# only, no restic) — do not add per-service restic schedules.

# ============================================================
# SECTION: backup targets (ALL DISABLED by default)
# ============================================================
# Which target names exist. The CLI looks up BACKUP_TARGET_<UPPER>_* for each.
BACKUP_TARGETS="local hetzner buffalo"

# ---- Target: LOCAL (NAS mount / external disk) ----
BACKUP_TARGET_LOCAL_ENABLED=0
BACKUP_TARGET_LOCAL_REPOSITORY="/mnt/backup/domum-core"
BACKUP_TARGET_LOCAL_PASSWORD_FILE="/etc/domum-core/secrets/restic_password_local"
BACKUP_TARGET_LOCAL_RETENTION="daily"     # daily | none
# BACKUP_TARGET_LOCAL_INCLUDE_PATHS=""    # override source set for this target

# ---- Target: HETZNER (Storage Box via SFTP) ----
# Repo form: sftp:<user>@<host>:<path>   e.g. sftp:u123456@u123456.your-storagebox.de:domum-core-restic
# Hetzner Storage Box port 23 only allows writes below the login root, so keep
# the path relative. Do not use :/./domum-core-restic for restic.
BACKUP_TARGET_HETZNER_ENABLED=0
BACKUP_TARGET_HETZNER_REPOSITORY="sftp:uXXXXXX@uXXXXXX.your-storagebox.de:domum-core-restic"
BACKUP_TARGET_HETZNER_PASSWORD_FILE="/etc/domum-core/secrets/restic_password_hetzner"
BACKUP_TARGET_HETZNER_RETENTION="daily"
# Hetzner Storage Box uses SFTP on port 23. SSH key auth is required for
# unattended backups.
BACKUP_TARGET_HETZNER_SFTP_KEY_FILE="/etc/domum-core/secrets/hetzner_storagebox_ed25519"
BACKUP_TARGET_HETZNER_SFTP_KNOWN_HOSTS_FILE="/etc/domum-core/secrets/hetzner_storagebox_known_hosts"
BACKUP_TARGET_HETZNER_SFTP_PORT="23"

# ---- Target: BUFFALO / LAN NAS (SFTP, disabled by default) ----
# Prefer SFTP over NFS/SMB mounts: no fstab dependency and no hung-mount risk at
# boot. Use whichever LAN NAS is more reliable/always-on as the second nightly
# target; replicate that repo NAS-side to the other NAS if desired.
BACKUP_TARGET_BUFFALO_ENABLED=0
BACKUP_TARGET_BUFFALO_REPOSITORY="sftp:backup@buffalo-nas:domum-core-restic"
BACKUP_TARGET_BUFFALO_PASSWORD_FILE="/etc/domum-core/secrets/restic_password_buffalo"
BACKUP_TARGET_BUFFALO_RETENTION="daily"
BACKUP_TARGET_BUFFALO_SFTP_KEY_FILE="/etc/domum-core/secrets/buffalo_backup_ed25519"
BACKUP_TARGET_BUFFALO_SFTP_KNOWN_HOSTS_FILE="/etc/domum-core/secrets/buffalo_known_hosts"
BACKUP_TARGET_BUFFALO_SFTP_PORT="22"

# ---- Target: CLOUD (Backblaze B2 / S3) — placeholder, commented ----
# Add "cloud" to BACKUP_TARGETS above to enable this slot.
# BACKUP_TARGET_CLOUD_ENABLED=0
# BACKUP_TARGET_CLOUD_REPOSITORY="b2:your-bucket:/domum-core"
# BACKUP_TARGET_CLOUD_PASSWORD_FILE="/etc/domum-core/secrets/restic_password_cloud"
# BACKUP_TARGET_CLOUD_ENV_FILE="/etc/domum-core/secrets/restic_cloud_env"  # B2_ACCOUNT_ID=... etc
# BACKUP_TARGET_CLOUD_RETENTION="weekly"

# ============================================================
# SECTION: which services `domum-core backups run` backs up
# ============================================================
# The unified backup engine (domum-core backups run) takes an app-consistent
# service-level snapshot of each ENABLED service whose flag below is 1, then
# hands everything to restic. Flags for services you do not run are ignored.
BACKUP_HOMEASSISTANT=1
BACKUP_MARIADB=1
BACKUP_ACTUAL=1
BACKUP_VAULTWARDEN=1
BACKUP_OBSIDIAN=1
BACKUP_ZIGBEE2MQTT=1
BACKUP_ZWAVE=1
BACKUP_NODERED=1
BACKUP_MQTT=1
BACKUP_ESPHOME=1
BACKUP_MUSICASSISTANT=1
BACKUP_ADGUARD=1
BACKUP_NTFY=1

# ============================================================
# SECTION: per-service backup tuning
# ============================================================
# Actual Budget: short `docker pause` around the local tar for a consistent
# SQLite copy. Set to 0 to opt out of the seconds-long pause.
ACTUAL_QUIESCE=1
ACTUAL_KEEP=7
HA_KEEP=7
MARIADB_KEEP=7

# ============================================================
# SECTION: recovery pack (AGE-encrypted)
# ============================================================
RECOVERY_PACK_ENABLED=1
RECOVERY_PACK_AGE_PUBKEY_FILE="/etc/domum-core/secrets/recovery-age.pub"
RECOVERY_PACK_DEST="/var/lib/domum-core/recovery-pack"
RECOVERY_PACK_REMINDER_DAYS=30

# Optional email delivery of the .age file. DISABLED by default. Only the
# AGE-encrypted pack is ever emailed — never plaintext.
#
# Simple Gmail setup (recommended): create a Google "App Password", store it in
# GMAIL_APP_PASSWORD_FILE (0600, root), and set the four ENABLE/EMAIL keys. The
# CLI defaults host to smtp.gmail.com:465 and uses RECOVERY_EMAIL_FROM as the
# SMTP username automatically.
ENABLE_RECOVERY_EMAIL=0
RECOVERY_EMAIL_PROVIDER="gmail"
RECOVERY_EMAIL_TO=""
RECOVERY_EMAIL_FROM=""
GMAIL_APP_PASSWORD_FILE="/etc/domum-core/secrets/gmail-app-password"
#
# Advanced / non-Gmail overrides (the friendly keys above map onto these):
# RECOVERY_PACK_EMAIL_ENABLED=0
# RECOVERY_PACK_SMTP_HOST=""
# RECOVERY_PACK_SMTP_PORT="465"
# RECOVERY_PACK_SMTP_USERNAME_FILE="/etc/domum-core/secrets/recovery_pack_smtp_username"
# RECOVERY_PACK_SMTP_PASSWORD_FILE="/etc/domum-core/secrets/recovery_pack_smtp_password"

# ============================================================
# SECTION: weekly health report email
# ============================================================
# Uses the same SMTP settings as recovery-pack email. Disabled by default.
REPORT_EMAIL_ENABLED=0
# Default recipient is RECOVERY_EMAIL_TO, then DOMUM_EMAIL. Override if desired.
REPORT_EMAIL_TO=""
# Optional cost line in the report's POWER section: your electricity price
# per kWh (e.g. 0.16) and a currency symbol prefixed to the amount
# (default $, shown as "~$6/year"). Unset rate = line omitted; the
# measured watts line shows either way when the PMIC is readable.
REPORT_KWH_RATE=""
REPORT_CURRENCY=""
# Optional Traefik request counting remains off by default because access logs
# add steady disk writes.
REPORT_TRAEFIK_REQUESTS=0

# ============================================================
# SECTION: host OS security patches
# ============================================================
# Container update policy is app-by-app in config/domum.conf.
ENABLE_SECURITY_PATCHES=1
ENABLE_AUTOREMOVE_OLD_KERNELS=0
SECURITY_PATCH_REBOOT_POLICY="manual"
