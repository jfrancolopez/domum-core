# Speedtest Tracker environment.
#
# Copy to /etc/domum-core/secrets/speedtest-tracker.env on the Pi and fill in
# the values below. The compose fragment loads this file via
#   env_file: ${DOMUM_SPEEDTEST_ENV_FILE:-/etc/domum-core/secrets/speedtest-tracker.env}
# so production fails loudly if the file is missing — never start without
# APP_KEY. CI validates the fragment against this example (the compose-validate
# workflow copies it into .ci/speedtest-tracker.env), so keep this file a valid
# env-file and free of real secrets.

# App key used to encrypt and decrypt stored data. Generate a fresh value with:
#   echo "base64:$(openssl rand -base64 32 2>/dev/null)"
# Keep it stable for the life of the data; regenerating it makes stored
# encrypted values unreadable. Never commit this file.
APP_KEY=

# Application name shown in the dashboard.
APP_NAME=Domum Speedtest

# SQLite single-file database stored under /config as database.sqlite.
DB_CONNECTION=sqlite

# UI timezone. Stored timestamps remain UTC; this only controls display.
DISPLAY_TIMEZONE=America/New_York

# Conservative test schedule in cron format (crontab.guru). Enabled only after
# a manual test is validated. Example: 30 */6 * * *  (00:30, 06:30, 12:30, 18:30)
# Leave empty to disable scheduled tests.
SPEEDTEST_SCHEDULE=

# Optional comma-separated Ookla server IDs to test against. Leave empty for
# automatic server selection.
SPEEDTEST_SERVERS=

# Keep results forever (0). Raise to e.g. 365 to prune results older than a year.
PRUNE_RESULTS_OLDER_THAN=0
