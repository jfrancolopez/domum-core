# Optional Glance Beszel integration settings.
# Copy to /etc/domum-core/secrets/glance-beszel.env on the Pi, set mode 0600,
# and keep real values out of git.

# Dedicated Beszel user created for Glance. Prefer a Beszel readonly role/user.
GLANCE_BESZEL_USERNAME="glance@example.invalid"
GLANCE_BESZEL_PASSWORD="change-me"

# Friendly labels are safe display names only; keep them short and non-sensitive.
GLANCE_BESZEL_SYSTEM_1_LABEL="domum-core"
GLANCE_BESZEL_SYSTEM_1_ID="domum-core"
GLANCE_BESZEL_SYSTEM_2_LABEL="media"
GLANCE_BESZEL_SYSTEM_2_ID="domum-core-media"
